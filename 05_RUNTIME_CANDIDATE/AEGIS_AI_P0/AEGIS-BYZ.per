; ============================================================================
; AEGIS-BYZ — AUTONOMOUS BYZANTINE AI
; COMPLETE ARCHITECTURE SKELETON / FIRST VERTICAL SLICE
; ============================================================================

; AEGIS owns the complete authority pipeline:
; WORLD MODEL -> BELIEF -> SITUATION -> OBJECTIVES -> PLANNING -> DECISION
; -> COMMITMENT -> EXECUTION -> VERIFICATION -> RECOVERY.
;
; Execution/Verification/Recovery are now part of the production package, but
; their unqualified engine-dependent edges remain deliberately inert. The bot
; must never claim an outcome that the target engine has not demonstrated.

; AEGIS is autonomous. No stock .per file is loaded.
; Target: AoE2DE 101.103.48987.0 / Steam BuildID 24094652.

; IMPORTANT LOAD-ORDER RULE:
; Shared World Model symbols are declared BEFORE any loaded module is parsed.
; AoE2 .per load processing does not make later declarations retroactively
; visible to an already-parsed child file.
;
; IMPORTANT RUNTIME RULE:
; Carpenter must acquire the native observation before the Architect publication
; coordinator runs, and every downstream layer must parse after that coordinator.
; This makes one World Model generation consumable by the complete downstream
; pipeline in the same rule-evaluation pass rather than leaving all consumers
; one generation behind.

; Local goal IDs are implementation candidates for this standalone package.
; They are intentionally kept in a low, currently unoccupied stock band.
; They are not declared cross-system ABI until runtime qualification freezes them.
(defconst aegis-wm-valid 300)
(defconst aegis-wm-generation 301)
(defconst aegis-wm-stage 302)
(defconst aegis-wm-evidence 303)
(defconst aegis-wm-time 304)
(defconst aegis-wm-cavalry 305)
(defconst aegis-wm-camel 306)
(defconst aegis-wm-food 307)
(defconst aegis-wm-wood 308)
(defconst aegis-wm-stone 309)
(defconst aegis-wm-gold 310)
(defconst aegis-wm-population 311)
(defconst aegis-wm-population-cap 312)
(defconst aegis-wm-age 313)
(defconst aegis-wm-focus-player 314)
(defconst aegis-wm-enemy-present 315)
(defconst aegis-wm-cycle 316)
(defconst aegis-wm-observed-at 317)
(defconst aegis-wm-cavalry-age 318)
(defconst aegis-wm-timer 40)
(defconst aegis-knight 38)
(defconst aegis-camel 92)
(defconst aegis-wm-stage-init 0)
(defconst aegis-wm-stage-observe 1)
(defconst aegis-wm-stage-qualified 2)
(defconst aegis-evidence-unknown 0)
(defconst aegis-evidence-current 1)

; ============================================================================
; ENGINE CARPENTER — native acquisition must precede publication
; ============================================================================

(load "AegisProm\\AEGIS-BYZ-Engine-Carpenter-P2")

; ============================================================================
; BOOTSTRAP — establish an owned state envelope
; ============================================================================

(defrule
    (game-time < 10)
    (up-compare-goal aegis-wm-cycle == 0)
=>
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-generation 0)
    (set-goal aegis-wm-stage aegis-wm-stage-observe)
    (set-goal aegis-wm-evidence aegis-evidence-unknown)
    (set-goal aegis-wm-time 0)
    (set-goal aegis-wm-cavalry 0)
    (set-goal aegis-wm-camel 0)
    (set-goal aegis-wm-food 0)
    (set-goal aegis-wm-wood 0)
    (set-goal aegis-wm-stone 0)
    (set-goal aegis-wm-gold 0)
    (set-goal aegis-wm-population 0)
    (set-goal aegis-wm-population-cap 0)
    (set-goal aegis-wm-age 0)
    (set-goal aegis-wm-focus-player 0)
    (set-goal aegis-wm-enemy-present 0)
    (set-goal aegis-wm-observed-at 0)
    (set-goal aegis-wm-cavalry-age 0)
    (set-goal aegis-wm-cycle 1)
    (enable-timer aegis-wm-timer 15)
)

; ============================================================================
; PUBLICATION COORDINATOR — Architect-owned generation transition
; ============================================================================

(defrule
    (up-compare-goal aegis-carpenter-sensor-pass == 1)
    (up-compare-goal aegis-wm-observed-at == 1)
=>
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-stage aegis-wm-stage-observe)
    (up-modify-goal aegis-wm-generation c:+ 1)
    (up-modify-goal aegis-wm-cycle c:+ 1)
    (set-goal aegis-wm-observed-at 2)
)

; ============================================================================
; QUALIFICATION
; ============================================================================

(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-observe)
    (up-compare-goal aegis-wm-observed-at == 2)
=>
    (set-goal aegis-wm-stage aegis-wm-stage-qualified)
    (set-goal aegis-wm-valid 1)
    (set-goal aegis-wm-evidence aegis-evidence-current)
    (up-modify-goal aegis-wm-cavalry-age g:= aegis-wm-time)
)

; Enemy presence is a world fact, not a strategic conclusion.
(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-qualified)
    (up-compare-goal aegis-wm-focus-player > 0)
=>
    (set-goal aegis-wm-enemy-present 1)
)

(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-qualified)
    (up-compare-goal aegis-wm-focus-player <= 0)
=>
    (set-goal aegis-wm-enemy-present 0)
)

; ============================================================================
; DOWNSTREAM MODULE ORDER
; ============================================================================
;
; Each consumer is parsed after its producer. In particular, the publication
; coordinator and WM qualification are parsed before Belief, so the current
; generation is available to the downstream state machine in the same pass.

(load "AegisProm\\Aegis-belief")
(load "AegisProm\\Aegis-situation")
(load "AegisProm\\Aegis-objectives")
(load "AegisProm\\Aegis-planning")
(load "AegisProm\\Aegis-decision")
(load "AegisProm\\Aegis-commitment")
(load "AegisProm\\Aegis-execution")
(load "AegisProm\\Aegis-verification")
(load "AegisProm\\Aegis-recovery")

; ============================================================================
; ARCHITECTURAL FIREWALL
; ============================================================================
;
; No strategic objective is selected here.
; No producer is selected here.
; No resource reservation is made here.
; No build/train/research/attack command is issued here.
; Execution owns issuance once an actuator contract is qualified.
; Verification owns outcome evidence.
; Recovery owns bounded disposition when reality disagrees.
;
; ============================================================================
; END — COMPLETE AEGIS AUTHORITY PIPELINE SKELETON
; ============================================================================
