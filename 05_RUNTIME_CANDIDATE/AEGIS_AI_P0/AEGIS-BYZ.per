; ============================================================================
; AEGIS-BYZ — AUTONOMOUS BYZANTINE AI
; FIRST PERSONALITY PASS: ARCHITECT / WORLD MODEL
; ============================================================================
;
; This is the first real implementation pass of AEGIS.
; Personality 1 owns the World Model: observe -> qualify -> retain.
; It does not decide strategy, authorize production, or issue commands.
;
; AEGIS is autonomous. No stock .per file is loaded.
; Target: AoE2DE 101.103.48987.0 / Steam BuildID 24094652.
;
; The World Model is capability-oriented, aggregate, time-indexed state
; with bounded causal memory. It is deliberately not an object database.
;
; Semantic envelope:
;   VALID + OWNER + GENERATION + STAGE + PAYLOAD + EVIDENCE_LEVEL
;
; Evidence is never promoted merely because an observation was attempted.
;
; ============================================================================
; AEGIS WORLD-MODEL LOCAL STATE
; ============================================================================

; Local goal IDs are implementation candidates for this standalone package.
; They are intentionally kept in a low, currently unoccupied stock band.
; They are not declared cross-system ABI until runtime qualification freezes them.
(defconst aegis-wm-valid 300)
(defconst aegis-wm-generation 301)
(defconst aegis-wm-stage 302)
(defconst aegis-wm-evidence 303)
(defconst aegis-wm-time 304)
(defconst aegis-wm-cavalry 305)
(defconst aegis-wm-camel 306)
(defconst aegis-wm-food 307)
(defconst aegis-wm-wood 308)
(defconst aegis-wm-stone 309)
(defconst aegis-wm-gold 310)
(defconst aegis-wm-population 311)
(defconst aegis-wm-population-cap 312)
(defconst aegis-wm-age 313)
(defconst aegis-wm-focus-player 314)
(defconst aegis-wm-enemy-present 315)
(defconst aegis-wm-cycle 316)
(defconst aegis-wm-observed-at 317)
(defconst aegis-wm-cavalry-age 318)

; Timer ownership belongs to the World Model coordinator, not to consumers.
(defconst aegis-wm-timer 40)

; Concrete engine identity used only as an observation type in this pass.
; Knight is unit ID 38 in the target ruleset. Unit-line qualification follows.
(defconst aegis-knight 38)
(defconst aegis-camel 92)

; Stages
(defconst aegis-wm-stage-init 0)
(defconst aegis-wm-stage-observe 1)
(defconst aegis-wm-stage-qualified 2)

; Evidence levels for this first implementation.
(defconst aegis-evidence-unknown 0)
(defconst aegis-evidence-current 1)

; ============================================================================
; BOOTSTRAP — establish an owned state envelope
; ============================================================================

(defrule
    (game-time < 10)
    (up-compare-goal aegis-wm-cycle == 0)
=>
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-generation 0)
    (set-goal aegis-wm-stage aegis-wm-stage-observe)
    (set-goal aegis-wm-evidence aegis-evidence-unknown)
    (set-goal aegis-wm-time 0)
    (set-goal aegis-wm-cavalry 0)
    (set-goal aegis-wm-camel 0)
    (set-goal aegis-wm-food 0)
    (set-goal aegis-wm-wood 0)
    (set-goal aegis-wm-stone 0)
    (set-goal aegis-wm-gold 0)
    (set-goal aegis-wm-population 0)
    (set-goal aegis-wm-population-cap 0)
    (set-goal aegis-wm-age 0)
    (set-goal aegis-wm-focus-player 0)
    (set-goal aegis-wm-enemy-present 0)
    (set-goal aegis-wm-observed-at 0)
    (set-goal aegis-wm-cavalry-age 0)
    (set-goal aegis-wm-cycle 1)
    (enable-timer aegis-wm-timer 15)
)

; ============================================================================
; OBSERVATION — acquire only facts owned by the World Model
; ============================================================================

(defrule
    (timer-triggered aegis-wm-timer)
=>
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-stage aegis-wm-stage-observe)
    (up-get-fact game-time 0 aegis-wm-time)
    (up-get-fact population 0 aegis-wm-population)
    (up-get-fact population-cap 0 aegis-wm-population-cap)
    (up-get-fact food-amount 0 aegis-wm-food)
    (up-get-fact wood-amount 0 aegis-wm-wood)
    (up-get-fact stone-amount 0 aegis-wm-stone)
    (up-get-fact gold-amount 0 aegis-wm-gold)
    (up-get-fact current-age 0 aegis-wm-age)
    (up-get-fact unit-type-count-total aegis-camel aegis-wm-camel)
    (up-get-fact-max any-enemy unit-type-count aegis-knight aegis-wm-cavalry)
    (up-find-player enemy find-closest aegis-wm-focus-player)
    (set-goal aegis-wm-observed-at 1)
    (up-modify-goal aegis-wm-generation c:+ 1)
    (up-modify-goal aegis-wm-cycle c:+ 1)
)

; ============================================================================
; QUALIFICATION — observation is retained only after the acquisition pass
; ============================================================================

(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-observe)
    (up-compare-goal aegis-wm-observed-at == 1)
=>
    (set-goal aegis-wm-stage aegis-wm-stage-qualified)
    (set-goal aegis-wm-valid 1)
    (set-goal aegis-wm-evidence aegis-evidence-current)
    (up-modify-goal aegis-wm-cavalry-age g:= aegis-wm-time)
)

; Enemy presence is a world fact, not a strategic conclusion.
(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-qualified)
    (up-compare-goal aegis-wm-focus-player > 0)
=>
    (set-goal aegis-wm-enemy-present 1)
)

(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-qualified)
    (up-compare-goal aegis-wm-focus-player <= 0)
=>
    (set-goal aegis-wm-enemy-present 0)
)

; ============================================================================
; NEXT-CYCLE RESET — the timer owns observation cadence
; ============================================================================
;
; The observation rule re-arms through the timer mechanism. No consumer
; owns a second clock and no world fact is fabricated between observations.
;
; ============================================================================
; ARCHITECTURAL FIREWALL
; ============================================================================
;
; No strategic objective is selected here.
; No producer is selected here.
; No resource reservation is made here.
; No build/train/research/attack command is issued here.
; World Model output is state for downstream personalities.
;
; First personality objective:
;   make the machine observe and retain a bounded, qualified world state.
;
; ============================================================================
; END — ARCHITECT / WORLD MODEL PASS 1
; ============================================================================

; ============================================================================
; SECOND PERSONALITY PASS: ENGINE CARPENTER
; ============================================================================
;
; The Carpenter does not redesign the World Model. It makes the architecture
; conform to primitives already observed in the target retail package.
;
; Stock evidence used by this pass:
;   game-time as an up-get-fact source
;   population / current-age as up-get-fact sources
;   unit-type-count and unit-type-count-total
;   up-get-fact-max any-enemy
;   up-find-player enemy find-closest
;   timer-triggered / enable-timer
;   up-chat-data-to-self for bounded diagnostics
;
; ============================================================================
; NATIVE ADAPTER STATE
; ============================================================================

(defconst aegis-carpenter-heartbeat 319)
(defconst aegis-carpenter-sensor-pass 320)
(defconst aegis-carpenter-runtime-ok 321)

; ============================================================================
; NATIVE SENSOR ADAPTER
; ============================================================================

(defrule
    (timer-triggered aegis-wm-timer)
=>
    (set-goal aegis-carpenter-runtime-ok 0)
    (set-goal aegis-carpenter-sensor-pass 0)
    (up-get-fact game-time 0 aegis-wm-time)
    (up-get-fact population 0 aegis-wm-population)
    (up-get-fact current-age 0 aegis-wm-age)
    (up-get-fact unit-type-count-total aegis-camel aegis-wm-camel)
    (up-get-fact-max any-enemy unit-type-count aegis-knight aegis-wm-cavalry)
    (up-find-player enemy find-closest aegis-wm-focus-player)
    (set-goal aegis-carpenter-sensor-pass 1)
    (set-goal aegis-carpenter-runtime-ok 1)
)

; ============================================================================
; OBSERVABLE HEARTBEAT
; ============================================================================

(defrule
    (up-compare-goal aegis-carpenter-sensor-pass == 1)
    (up-compare-goal aegis-carpenter-heartbeat != aegis-wm-generation)
=>
    (up-modify-goal aegis-carpenter-heartbeat g:= aegis-wm-generation)
    (up-chat-data-to-self "AEGIS WM gen=%d pop=%d age=%d cav=%d camel=%d." g: aegis-wm-generation)
)

; ============================================================================
; RESOURCE ADAPTER — exact native forms, no synthetic resource math
; ============================================================================
;
; Resource conditions remain native conditions in this pass. This avoids
; manufacturing an ABI interpretation for resource-amount until its selector
; semantics are independently qualified.

(defrule
    (up-compare-goal aegis-wm-stage == aegis-wm-stage-qualified)
    (food-amount >= 0)
    (wood-amount >= 0)
    (stone-amount >= 0)
    (gold-amount >= 0)
=>
    (set-goal aegis-wm-valid 1)
)

; ============================================================================
; ARCHITECT / CARPENTER CONTRACT
; ============================================================================
;
; Architect owns meaning and boundaries.
; Carpenter owns native expression of those boundaries.
; Carpenter may not promote an unqualified engine primitive merely because
; its spelling is accepted by the parser.
;
; Runtime evidence produced by this pass is therefore:
;   package loaded          -> established by the preceding P0 test
;   rules executed          -> observable through the heartbeat
;   sensor values populated -> observable through the heartbeat
;   sensor semantics        -> still requires controlled calibration
;
; ============================================================================
; END — ENGINE CARPENTER PASS 2
; ============================================================================

; ============================================================================
; CARPENTER DIAGNOSTIC EXTENSION
; ============================================================================
;
; One value per diagnostic call keeps formatting unambiguous and makes each
; observed channel independently attributable during runtime qualification.
;
(defrule
    (up-compare-goal aegis-carpenter-sensor-pass == 1)
    (up-compare-goal aegis-carpenter-runtime-ok == 1)
=>
    (up-chat-data-to-self "AEGIS time=%d." g: aegis-wm-time)
    (up-chat-data-to-self "AEGIS pop=%d." g: aegis-wm-population)
    (up-chat-data-to-self "AEGIS age=%d." g: aegis-wm-age)
    (up-chat-data-to-self "AEGIS enemy-cav=%d." g: aegis-wm-cavalry)
    (up-chat-data-to-self "AEGIS own-camel=%d." g: aegis-wm-camel)
)

; ============================================================================
; END — CARPENTER DIAGNOSTIC EXTENSION
; ============================================================================
