; AEGIS Recovery candidate — NOT PRODUCTION
; Boundary: Verification result -> bounded current-course disposition
; Recovery cannot invent plans, decisions, commitments, commands, or facts.

(defconst aegis-rec-stage-init 0)
(defconst aegis-rec-stage-stable 1)
(defconst aegis-rec-stage-review 2)
(defconst aegis-rec-stage-retry-bounded 3)
(defconst aegis-rec-stage-upstream 4)

(defconst aegis-rec-generation 391)
(defconst aegis-rec-valid 392)
(defconst aegis-rec-stage 393)
(defconst aegis-rec-disposition 394)
(defconst aegis-rec-retry-count 395)
(defconst aegis-rec-material-change 396)
(defconst aegis-rec-dependency 397)
(defconst aegis-rec-upstream-request 398)
(defconst aegis-rec-action-id 399)
(defconst aegis-rec-cycle 400)

(defconst aegis-rec-disposition-none 0)
(defconst aegis-rec-disposition-hold 1)
(defconst aegis-rec-disposition-retry 2)
(defconst aegis-rec-disposition-upstream 3)

(defrule
    (game-time < 10)
    (up-compare-goal aegis-rec-cycle == 0)
=>
    (set-goal aegis-rec-generation 0)
    (set-goal aegis-rec-valid 0)
    (set-goal aegis-rec-stage aegis-rec-stage-init)
    (set-goal aegis-rec-disposition aegis-rec-disposition-none)
    (set-goal aegis-rec-retry-count 0)
    (set-goal aegis-rec-material-change 0)
    (set-goal aegis-rec-dependency 0)
    (set-goal aegis-rec-upstream-request 0)
    (set-goal aegis-rec-action-id 0)
    (set-goal aegis-rec-cycle 0)
)

; A verification result can control Recovery only in the same current
; generation. UNKNOWN is retained as an information state, not converted to
; failure. Retry remains bounded by an explicit local counter.
(defrule
    (up-compare-goal aegis-ver-valid == 1)
    (up-compare-goal aegis-ver-generation == aegis-wm-generation)
    (up-compare-goal aegis-ver-result == aegis-ver-result-unknown)
    (up-compare-goal aegis-rec-generation != aegis-ver-generation)
=>
    (up-modify-goal aegis-rec-generation g:= aegis-ver-generation)
    (up-modify-goal aegis-rec-action-id g:= aegis-ver-action-id)
    (up-modify-goal aegis-rec-cycle g:= aegis-ver-cycle)
    (set-goal aegis-rec-valid 1)
    (set-goal aegis-rec-stage aegis-rec-stage-review)
    (set-goal aegis-rec-disposition aegis-rec-disposition-hold)
    (set-goal aegis-rec-upstream-request 1)
)

; No strategic replacement is performed here. Planning/Decision/Commitment
; remain the authorities for any replacement course.
