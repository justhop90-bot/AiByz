; ============================================================================
; AD BYZANTINE AFTER-ACTION & ADAPTIVE MEMORY DIRECTOR — V4 WAR COLLEGE
; ============================================================================
; Evidence recorder and bounded policy recommender.
; NEVER rewrites strategic truth. Sovereign alone consumes policy deltas.
; Events are edge-triggered by command/state change or consequential outcomes;
; fifteen-second ticks do not count as evidence by themselves.
; ============================================================================
(defconst byz-learn-cycle-goal 2080)
(defconst byz-learn-state-goal 2081)
(defconst byz-learn-confidence-goal 2082)
(defconst byz-learn-sample-count-goal 2083)
(defconst byz-learn-prediction-error-goal 2084)
(defconst byz-learn-model-error-goal 2085)
(defconst byz-learn-action-error-goal 2086)
(defconst byz-learn-battle-error-goal 2087)
(defconst byz-learn-economic-error-goal 2088)
(defconst byz-learn-conversion-error-goal 2089)
(defconst byz-learn-tech-error-goal 2090)
(defconst byz-learn-market-error-goal 2091)
(defconst byz-learn-naval-error-goal 2092)
(defconst byz-learn-strong-exchange-count-goal 2093)
(defconst byz-learn-bad-exchange-count-goal 2094)
(defconst byz-learn-conversion-success-count-goal 2095)
(defconst byz-learn-conversion-failure-count-goal 2096)
(defconst byz-learn-prediction-hit-count-goal 2097)
(defconst byz-learn-prediction-miss-count-goal 2098)
(defconst byz-learn-market-success-count-goal 2099)
(defconst byz-learn-market-failure-count-goal 2100)
(defconst byz-learn-naval-success-count-goal 2101)
(defconst byz-learn-naval-failure-count-goal 2102)
(defconst byz-learn-tech-success-count-goal 2103)
(defconst byz-learn-tech-failure-count-goal 2104)
(defconst byz-learn-command-success-count-goal 2105)
(defconst byz-learn-command-failure-count-goal 2106)
(defconst byz-learn-last-command-goal 2107)
(defconst byz-learn-last-state-goal 2108)
(defconst byz-learn-last-outcome-goal 2109)
(defconst byz-learn-lesson-goal 2110)
(defconst byz-learn-lesson-strength-goal 2111)
(defconst byz-learn-caution-goal 2112)
(defconst byz-learn-commitment-bias-goal 2113)
(defconst byz-learn-preserve-bias-goal 2114)
(defconst byz-learn-conversion-bias-goal 2115)
(defconst byz-learn-scout-bias-goal 2116)
(defconst byz-learn-market-bias-goal 2117)
(defconst byz-learn-tech-bias-goal 2118)
(defconst byz-learn-naval-bias-goal 2119)
(defconst byz-learn-memory-lock-goal 2120)
(defconst byz-learn-confidence-delta-goal 2121)
(defconst byz-learn-regret-delta-goal 2122)
(defconst byz-learn-optionality-delta-goal 2123)
(defconst byz-learn-command-reward-goal 2124)
(defconst byz-learn-command-cost-goal 2125)
(defconst byz-learn-command-risk-goal 2126)
(defconst byz-learn-action-value-goal 2127)
(defconst byz-learn-attrition-result-goal 2128)
(defconst byz-learn-conversion-result-goal 2129)
(defconst byz-learn-recovery-result-goal 2130)
(defconst byz-learn-feedback-integrity-goal 2131)
(defconst byz-learn-freshness-goal 2132)
(defconst byz-learn-lesson-confidence-goal 2133)
(defconst byz-learn-observe 0)
(defconst byz-learn-evaluate 1)
(defconst byz-learn-record 2)
(defconst byz-learn-adjust 3)
(defconst byz-learn-hold 4)
(defconst byz-learn-lesson-none 0)
(defconst byz-learn-lesson-model 1)
(defconst byz-learn-lesson-battle 2)
(defconst byz-learn-lesson-economy 3)
(defconst byz-learn-lesson-conversion 4)
(defconst byz-learn-lesson-tech 5)
(defconst byz-learn-lesson-market 6)
(defconst byz-learn-lesson-naval 7)
(defconst byz-learn-lesson-command 8)
(defconst byz-learn-lesson-restraint 9)
(defconst byz-learn-outcome-neutral 0)
(defconst byz-learn-outcome-positive 1)
(defconst byz-learn-outcome-negative 2)
(defconst byz-learn-outcome-catastrophic 3)

(defrule
    (true)
=>
    (set-goal byz-learn-cycle-goal byz-learn-observe)
    (set-goal byz-learn-state-goal byz-learn-observe)
    (set-goal byz-learn-confidence-goal 50)
    (set-goal byz-learn-sample-count-goal 0)
    (set-goal byz-learn-prediction-error-goal 0)
    (set-goal byz-learn-model-error-goal 0)
    (set-goal byz-learn-action-error-goal 0)
    (set-goal byz-learn-battle-error-goal 0)
    (set-goal byz-learn-economic-error-goal 0)
    (set-goal byz-learn-conversion-error-goal 0)
    (set-goal byz-learn-tech-error-goal 0)
    (set-goal byz-learn-market-error-goal 0)
    (set-goal byz-learn-naval-error-goal 0))
(defrule
    (true)
=>
    (set-goal byz-learn-strong-exchange-count-goal 0)
    (set-goal byz-learn-bad-exchange-count-goal 0)
    (set-goal byz-learn-conversion-success-count-goal 0)
    (set-goal byz-learn-conversion-failure-count-goal 0)
    (set-goal byz-learn-prediction-hit-count-goal 0)
    (set-goal byz-learn-prediction-miss-count-goal 0)
    (set-goal byz-learn-market-success-count-goal 0)
    (set-goal byz-learn-market-failure-count-goal 0)
    (set-goal byz-learn-naval-success-count-goal 0)
    (set-goal byz-learn-naval-failure-count-goal 0)
    (set-goal byz-learn-tech-success-count-goal 0)
    (set-goal byz-learn-tech-failure-count-goal 0)
    (set-goal byz-learn-command-success-count-goal 0)
    (set-goal byz-learn-command-failure-count-goal 0)
    (set-goal byz-learn-last-command-goal byz-cmd-hold)
    (set-goal byz-learn-last-state-goal byz-state-observe)
    (set-goal byz-learn-last-outcome-goal byz-learn-outcome-neutral))
(defrule
    (true)
=>
    (set-goal byz-learn-lesson-goal byz-learn-lesson-none)
    (set-goal byz-learn-lesson-strength-goal 0)
    (set-goal byz-learn-caution-goal 50)
    (set-goal byz-learn-commitment-bias-goal 50)
    (set-goal byz-learn-preserve-bias-goal 50)
    (set-goal byz-learn-conversion-bias-goal 50)
    (set-goal byz-learn-scout-bias-goal 50)
    (set-goal byz-learn-market-bias-goal 50)
    (set-goal byz-learn-tech-bias-goal 50)
    (set-goal byz-learn-naval-bias-goal 50))
(defrule
    (true)
=>
    (set-goal byz-learn-memory-lock-goal 0)
    (set-goal byz-learn-confidence-delta-goal 0)
    (set-goal byz-learn-regret-delta-goal 0)
    (set-goal byz-learn-optionality-delta-goal 0)
    (set-goal byz-learn-command-reward-goal 0)
    (set-goal byz-learn-command-cost-goal 0)
    (set-goal byz-learn-command-risk-goal 0)
    (set-goal byz-learn-action-value-goal 0)
    (set-goal byz-learn-attrition-result-goal 50)
    (set-goal byz-learn-conversion-result-goal 50)
    (set-goal byz-learn-recovery-result-goal 50)
    (set-goal byz-learn-feedback-integrity-goal 100)
    (set-goal byz-learn-freshness-goal 100)
    (set-goal byz-learn-lesson-confidence-goal 0))

; V4 event snapshot: capture only, do not count yet.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-learn-observed-command-goal g:= byz-cmd-command-goal)
    (up-modify-goal byz-learn-observed-state-goal g:= byz-state-goal)
    (up-modify-goal byz-learn-observed-value-goal g:= byz-cmd-battle-value-goal)
    (up-modify-goal byz-learn-observed-risk-goal g:= byz-cmd-battle-risk-goal)
    (set-goal byz-learn-freshness-goal 100))

; Consequential event: command or strategic-state edge.
(defrule
    (up-compare-goal byz-learn-observed-command-goal != g:byz-learn-last-command-goal)
=>
    (set-goal byz-learn-event-lock-goal 1)
    (up-modify-goal byz-learn-sample-count-goal c:+ 1)
    (up-modify-goal byz-learn-command-success-count-goal c:+ 0)
    (up-modify-goal byz-learn-last-command-goal g:= byz-learn-observed-command-goal)
    (up-modify-goal byz-learn-last-state-goal g:= byz-learn-observed-state-goal)
    (up-modify-goal byz-learn-command-risk-goal g:= byz-learn-observed-risk-goal)
    (up-modify-goal byz-learn-action-value-goal g:= byz-learn-observed-value-goal))
(defrule
    (up-compare-goal byz-learn-observed-state-goal != g:byz-learn-last-state-goal)
=>
    (set-goal byz-learn-event-lock-goal 1)
    (up-modify-goal byz-learn-sample-count-goal c:+ 1)
    (up-modify-goal byz-learn-last-state-goal g:= byz-learn-observed-state-goal))

; Learn only from outcomes with a completed execution window.
(defrule
    (up-compare-goal byz-learn-action-value-goal >= c:70)
    (up-compare-goal byz-learn-command-risk-goal <= c:60)
    (goal byz-cmd-command-goal byz-cmd-engage)
=>
    (set-goal byz-learn-last-outcome-goal byz-learn-outcome-positive)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-command)
    (set-goal byz-learn-lesson-strength-goal 70)
    (set-goal byz-learn-lesson-confidence-goal 70)
    (set-goal byz-learn-confidence-delta-goal 4)
    (set-goal byz-learn-regret-delta-goal -4)
    (set-goal byz-learn-optionality-delta-goal 3)
    (up-modify-goal byz-learn-strong-exchange-count-goal c:+ 1)
    (set-goal byz-learn-policy-validity-goal 60))
(defrule
    (up-compare-goal byz-learn-action-value-goal <= c:30)
    (up-compare-goal byz-learn-command-risk-goal >= c:60)
    (goal byz-cmd-command-goal byz-cmd-engage)
=>
    (set-goal byz-learn-last-outcome-goal byz-learn-outcome-negative)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-battle)
    (set-goal byz-learn-lesson-strength-goal 80)
    (set-goal byz-learn-lesson-confidence-goal 80)
    (set-goal byz-learn-confidence-delta-goal -8)
    (set-goal byz-learn-regret-delta-goal 10)
    (set-goal byz-learn-optionality-delta-goal 8)
    (up-modify-goal byz-learn-bad-exchange-count-goal c:+ 1)
    (set-goal byz-learn-policy-validity-goal 70))
(defrule
    (up-compare-goal byz-learn-action-value-goal <= c:20)
    (up-compare-goal byz-learn-command-risk-goal >= c:80)
=>
    (set-goal byz-learn-last-outcome-goal byz-learn-outcome-catastrophic)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-battle)
    (set-goal byz-learn-lesson-strength-goal 100)
    (set-goal byz-learn-lesson-confidence-goal 90)
    (set-goal byz-learn-caution-goal 90)
    (set-goal byz-learn-confidence-delta-goal -12)
    (set-goal byz-learn-regret-delta-goal 15)
    (set-goal byz-learn-optionality-delta-goal 15)
    (set-goal byz-learn-policy-validity-goal 80))

; Reward successful restraint explicitly.
(defrule
    (goal byz-cmd-command-goal byz-cmd-delay)
    (up-compare-goal byz-cmd-battle-risk-goal <= c:60)
    (up-compare-goal byz-cmd-battle-value-goal <= c:45)
=>
    (up-modify-goal byz-learn-restraint-success-count-goal c:+ 1)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-restraint)
    (set-goal byz-learn-caution-goal 35)
    (set-goal byz-learn-preserve-bias-goal 80)
    (set-goal byz-learn-optionality-delta-goal 8)
    (set-goal byz-learn-policy-validity-goal 60))

; Prediction calibration is recommendation-only.
(defrule
    (up-compare-goal byz-threat-confidence-goal >= c:75)
    (up-compare-goal byz-cmd-battle-value-goal <= c:35)
=>
    (set-goal byz-learn-prediction-error-goal 80)
    (set-goal byz-learn-model-error-goal 80)
    (up-modify-goal byz-learn-prediction-miss-count-goal c:+ 1)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-model)
    (set-goal byz-learn-confidence-delta-goal -8)
    (set-goal byz-learn-policy-scout-delta-goal 8)
    (set-goal byz-learn-caution-goal 80)
    (set-goal byz-learn-policy-validity-goal 70))
(defrule
    (up-compare-goal byz-threat-confidence-goal <= c:40)
    (up-compare-goal byz-cmd-battle-value-goal >= c:70)
=>
    (set-goal byz-learn-prediction-error-goal 35)
    (set-goal byz-learn-model-error-goal 35)
    (up-modify-goal byz-learn-prediction-hit-count-goal c:+ 1)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-model)
    (set-goal byz-learn-confidence-delta-goal 4)
    (set-goal byz-learn-policy-validity-goal 50))

; Economic / conversion evidence.
(defrule
    (up-compare-goal byz-eco-starve-score-goal >= c:75)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:40)
=>
    (set-goal byz-learn-economic-error-goal 20)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-economy)
    (set-goal byz-learn-command-reward-goal 80)
    (set-goal byz-learn-policy-validity-goal 65))
(defrule
    (up-compare-goal byz-conversion-value-goal >= c:70)
    (up-compare-goal byz-cmd-conversion-window-goal >= c:70)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:40)
=>
    (up-modify-goal byz-learn-conversion-success-count-goal c:+ 1)
    (set-goal byz-learn-conversion-error-goal 15)
    (set-goal byz-learn-conversion-result-goal 85)
    (set-goal byz-learn-conversion-bias-goal 80)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-conversion)
    (set-goal byz-learn-policy-validity-goal 65))
(defrule
    (up-compare-goal byz-conversion-value-goal >= c:70)
    (up-compare-goal byz-cmd-conversion-window-goal <= c:30)
=>
    (up-modify-goal byz-learn-conversion-failure-count-goal c:+ 1)
    (set-goal byz-learn-conversion-error-goal 80)
    (set-goal byz-learn-conversion-result-goal 25)
    (set-goal byz-learn-conversion-bias-goal 35)
    (set-goal byz-learn-caution-goal 80)
    (set-goal byz-learn-lesson-goal byz-learn-lesson-conversion)
    (set-goal byz-learn-policy-validity-goal 65))

; Recommendations consumed only by Sovereign.
(defrule
    (up-compare-goal byz-learn-caution-goal >= c:75)
=>
    (set-goal byz-learn-preserve-bias-goal 85)
    (set-goal byz-learn-commitment-bias-goal 30)
    (set-goal byz-learn-policy-optionality-delta-goal 8))
(defrule
    (up-compare-goal byz-learn-conversion-bias-goal >= c:75)
    (up-compare-goal byz-learn-caution-goal <= c:55)
=>
    (set-goal byz-learn-preserve-bias-goal 45)
    (set-goal byz-learn-commitment-bias-goal 75))
(defrule
    (up-compare-goal byz-learn-scout-bias-goal >= c:75)
=>
    (set-goal byz-learn-policy-scout-delta-goal 6))

; Anti-thrashing: policy validity decays, memory lock preserves the strongest lesson.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-learn-policy-validity-goal c:- 5)
    (up-modify-goal byz-learn-caution-goal c:- 1)
    (up-modify-goal byz-learn-preserve-bias-goal c:- 1)
    (up-modify-goal byz-learn-policy-scout-delta-goal c:- 1)
    (set-goal byz-learn-cycle-goal byz-learn-observe)
    (set-goal byz-learn-event-lock-goal 0)
    (set-goal byz-learn-freshness-goal 100))
(defrule
    (up-compare-goal byz-learn-sample-count-goal >= c:4)
    (up-compare-goal byz-learn-policy-validity-goal >= c:50)
=>
    (set-goal byz-learn-memory-lock-goal 1)
    (set-goal byz-learn-confidence-goal 70))
(defrule
    (up-compare-goal byz-learn-policy-validity-goal <= c:0)
=>
    (set-goal byz-learn-memory-lock-goal 0)
    (set-goal byz-learn-caution-goal 50)
    (set-goal byz-learn-preserve-bias-goal 50)
    (set-goal byz-learn-confidence-delta-goal 0)
    (set-goal byz-learn-optionality-delta-goal 0)
    (set-goal byz-learn-policy-scout-delta-goal 0)
    (set-goal byz-learn-commitment-bias-goal 50))
