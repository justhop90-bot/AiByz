; ============================================================================
; AD BYZANTINE BATTLEFIELD COMMANDER
; ============================================================================
; The field marshal.
;
; This is the critical loop between planning and war.
;
; Doctrine taken directly from the Byzantine dissertation:
;   BattleValue = ResourceExchange + VillagerDamage + SiegeDamage
;              + MapControl + GoldDenial + ProductionDenial
;              + ReinforcementAdvantage - LostMilitaryValue - LostPosition
;
; The Commander adds the missing operational layer around that formula:
;   - fight only when the exchange is favorable enough;
;   - defend/hold when position is more valuable than pursuit;
;   - retreat before a bad exchange becomes a strategic disaster;
;   - intercept reinforcements instead of attacking the strongest point;
;   - pursue only when the enemy's army is already damaged and the pursuit is
;     likely to create permanent advantage;
;   - protect siege and monks as high-value assets;
;   - exploit transition windows and lock-forcing opportunities;
;   - convert successful fights into gold denial, production denial, map control,
;     and structural damage rather than endlessly chasing units.
;
; IMPORTANT ARCHITECTURE:
;   This module calculates authoritative COMMAND INTENT first. The final bridge
;   to units.per's attack-group authority is deliberately conservative because
;   the legacy AI contains many later attack/reset rules. A later integration
;   pass can move the bridge to the exact execution location after testing.
; ============================================================================

; ---------------------------- PRIVATE GOALS -----------------------------
(defconst byz-cmd-cycle-goal 920) ; commander cycle
(defconst byz-cmd-mode-goal 921) ; current battlefield mode
(defconst byz-cmd-command-goal 922) ; intended battlefield command
(defconst byz-cmd-battle-value-goal 923) ; BattleValue
(defconst byz-cmd-resource-exchange-goal 924) ; enemy resources lost minus ours
(defconst byz-cmd-villager-damage-goal 925) ; villager damage value
(defconst byz-cmd-siege-damage-goal 926) ; siege damage value
(defconst byz-cmd-map-control-value-goal 927) ; map-control value
(defconst byz-cmd-gold-denial-value-goal 928) ; gold denial value
(defconst byz-cmd-production-denial-value-goal 929) ; production denial value
(defconst byz-cmd-reinforcement-value-goal 930) ; reinforcement advantage
(defconst byz-cmd-lost-military-value-goal 931) ; military value at risk/lost
(defconst byz-cmd-lost-position-goal 932) ; value of losing current position
(defconst byz-cmd-battle-risk-goal 933) ; catastrophic battle risk
(defconst byz-cmd-battle-confidence-goal 934) ; confidence in battle read
(defconst byz-cmd-position-quality-goal 935) ; quality of current location
(defconst byz-cmd-mobility-fit-goal 936) ; mobility fit to battle
(defconst byz-cmd-siege-safety-goal 937) ; siege safety
(defconst byz-cmd-monk-safety-goal 938) ; monk safety
(defconst byz-cmd-micro-burden-goal 939) ; practical micro difficulty
(defconst byz-cmd-overextension-goal 940) ; army overextension
(defconst byz-cmd-reinforcement-gap-goal 941) ; friendly reinforcement advantage
(defconst byz-cmd-enemy-reinforcement-gap-goal 942) ; enemy reinforcement pressure
(defconst byz-cmd-enemy-damage-goal 943) ; enemy damage state
(defconst byz-cmd-enemy-retreat-goal 944) ; enemy retreat/low-strength state
(defconst byz-cmd-pursuit-window-goal 945) ; pursuit opportunity
(defconst byz-cmd-intercept-window-goal 946) ; reinforcement intercept opportunity
(defconst byz-cmd-raid-window-goal 947) ; raid opportunity
(defconst byz-cmd-siege-window-goal 948) ; siege conversion opportunity
(defconst byz-cmd-transition-window-goal 949) ; enemy transition vulnerability
(defconst byz-cmd-conversion-window-goal 950) ; permanent-damage window
(defconst byz-cmd-attrition-index-goal 951) ; dissertation Attrition Index
(defconst byz-cmd-lock-score-goal 952) ; lock-forcing pressure
(defconst byz-cmd-regret-goal 953) ; regret of wrong engagement
(defconst byz-cmd-time-pressure-goal 954) ; time/deadline pressure
(defconst byz-cmd-reserve-goal 955) ; reserve safety
(defconst byz-cmd-force-coverage-goal 956) ; chosen composition coverage
(defconst byz-cmd-command-score-goal 957) ; selected command score
(defconst byz-cmd-command-alt-score-goal 958) ; second-best command score
(defconst byz-cmd-command-risk-goal 959) ; selected command risk
(defconst byz-cmd-command-reward-goal 960) ; selected command reward
(defconst byz-cmd-command-cost-goal 961) ; selected command cost
(defconst byz-cmd-stall-value-goal 962) ; value of delaying
(defconst byz-cmd-chase-cost-goal 963) ; cost of pursuit
(defconst byz-cmd-position-loss-risk-goal 964) ; risk of losing key ground
(defconst byz-cmd-asset-priority-goal 965) ; highest-value protected asset
(defconst byz-cmd-execution-urgency-goal 966) ; urgency of command
(defconst byz-cmd-learning-result-goal 967) ; battle outcome memory
(defconst byz-cmd-battle-phase-goal 968) ; local battle phase

; ---------------------------- MODES -----------------------------------
(defconst byz-cmd-mode-neutralize 0)
(defconst byz-cmd-mode-contain 1)
(defconst byz-cmd-mode-starve 2)
(defconst byz-cmd-mode-convert 3)
(defconst byz-cmd-mode-choke 4)

; ---------------------------- COMMANDS --------------------------------
(defconst byz-cmd-hold 0)
(defconst byz-cmd-defend 1)
(defconst byz-cmd-engage 2)
(defconst byz-cmd-delay 3)
(defconst byz-cmd-retreat 4)
(defconst byz-cmd-intercept 5)
(defconst byz-cmd-flank 6)
(defconst byz-cmd-raid 7)
(defconst byz-cmd-pursue 8)
(defconst byz-cmd-siege-push 9)
(defconst byz-cmd-convert 10)
(defconst byz-cmd-reinforce 11)

; ---------------------------- LOCAL PHASES ------------------------------
(defconst byz-cmd-phase-approach 0)
(defconst byz-cmd-phase-contact 1)
(defconst byz-cmd-phase-exchange 2)
(defconst byz-cmd-phase-break 3)
(defconst byz-cmd-phase-pursuit 4)
(defconst byz-cmd-phase-convert 5)
(defconst byz-cmd-phase-withdraw 6)

; ============================================================================
; INITIALIZATION
; ============================================================================
(defrule
    (true)
=>
    (set-goal byz-cmd-cycle-goal 0)
    (set-goal byz-cmd-mode-goal byz-cmd-mode-neutralize)
    (set-goal byz-cmd-command-goal byz-cmd-hold)
    (set-goal byz-cmd-battle-value-goal 0)
    (set-goal byz-cmd-resource-exchange-goal 0)
    (set-goal byz-cmd-villager-damage-goal 0)
    (set-goal byz-cmd-siege-damage-goal 0)
    (set-goal byz-cmd-map-control-value-goal 0)
    (set-goal byz-cmd-gold-denial-value-goal 0)
    (set-goal byz-cmd-production-denial-value-goal 0)
    (set-goal byz-cmd-reinforcement-value-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-cmd-lost-military-value-goal 0)
    (set-goal byz-cmd-lost-position-goal 0)
    (set-goal byz-cmd-battle-risk-goal 0)
    (set-goal byz-cmd-battle-confidence-goal 0)
    (set-goal byz-cmd-position-quality-goal 50)
    (set-goal byz-cmd-mobility-fit-goal 50)
    (set-goal byz-cmd-siege-safety-goal 50)
    (set-goal byz-cmd-monk-safety-goal 50)
    (set-goal byz-cmd-micro-burden-goal 50)
    (set-goal byz-cmd-overextension-goal 0)
    (set-goal byz-cmd-reinforcement-gap-goal 50)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-cmd-enemy-reinforcement-gap-goal 50)
    (set-goal byz-cmd-enemy-damage-goal 0)
    (set-goal byz-cmd-enemy-retreat-goal 0)
    (set-goal byz-cmd-pursuit-window-goal 0)
    (set-goal byz-cmd-intercept-window-goal 0)
    (set-goal byz-cmd-raid-window-goal 0)
    (set-goal byz-cmd-siege-window-goal 0)
    (set-goal byz-cmd-transition-window-goal 0)
    (set-goal byz-cmd-conversion-window-goal 0)
    (set-goal byz-cmd-attrition-index-goal 50)
    (set-goal byz-cmd-lock-score-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-cmd-regret-goal 0)
    (set-goal byz-cmd-time-pressure-goal 0)
    (set-goal byz-cmd-reserve-goal 80)
    (set-goal byz-cmd-force-coverage-goal 50)
    (set-goal byz-cmd-command-score-goal 0)
    (set-goal byz-cmd-command-alt-score-goal 0)
    (set-goal byz-cmd-command-risk-goal 0)
    (set-goal byz-cmd-command-reward-goal 0)
    (set-goal byz-cmd-command-cost-goal 0)
    (set-goal byz-cmd-stall-value-goal 0)
    (set-goal byz-cmd-chase-cost-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-cmd-position-loss-risk-goal 0)
    (set-goal byz-cmd-asset-priority-goal 0)
    (set-goal byz-cmd-execution-urgency-goal 0)
    (set-goal byz-cmd-learning-result-goal 0)
    (set-goal byz-cmd-battle-phase-goal byz-cmd-phase-approach)
    (disable-self))

; ============================================================================
; PHASE 1 — OBSERVE THE BATTLEFIELD
; ============================================================================
; Existing engine state is treated as evidence, not as an automatic command.
; The commander reads:
;   threat severity/confidence, military level, attack status, position value,
;   map control, army composition coverage, transition pressure, and urgency.

(defrule
    (strategic-number sn-military-level >= 2)
=>
    (set-goal byz-cmd-force-coverage-goal 75))

(defrule
    (strategic-number sn-military-level <= -1)
=>
    (set-goal byz-cmd-force-coverage-goal 25))

(defrule
    (up-compare-goal byz-cmd-force-coverage-goal >= c:70)
    (up-compare-goal byz-threat-confidence-goal >= c:60)
=>
    (set-goal byz-cmd-battle-confidence-goal 75))

(defrule
    (up-compare-goal byz-threat-confidence-goal < c:40)
=>
    (set-goal byz-cmd-battle-confidence-goal 35)
    (set-goal byz-cmd-regret-goal 70))

; Under attack means preservation gets priority until the exchange proves favorable.
(defrule
    (goal under-attack-goal 1)
=>
    (set-goal byz-cmd-command-goal byz-cmd-defend)
    (set-goal byz-cmd-time-pressure-goal 80))

; Existing attack-status retreat is an authoritative legacy warning.
(defrule
    (goal attack-status-goal retreat)
=>
    (set-goal byz-cmd-command-goal byz-cmd-retreat)
    (set-goal byz-cmd-battle-risk-goal 90))

; ============================================================================
; PHASE 2 — BUILD THE DISSERTATION BATTLEVALUE
; ============================================================================
; We keep every ingredient separate so later battlefield facts can sharpen it.
; The values are intentionally coarse 0-100 scores; no fake precision.

; Resource exchange comes from relative force/quality. Positive advantage is
; represented by high value; low value means we should not voluntarily fight.
(defrule
    (up-compare-goal byz-enemy-quality-goal <= c:40)
    (up-compare-goal byz-enemy-mass-goal <= c:50)
=>
    (set-goal byz-cmd-resource-exchange-goal 75))

(defrule
    (up-compare-goal byz-enemy-quality-goal >= c:70)
    (up-compare-goal byz-enemy-mass-goal >= c:70)
=>
    (set-goal byz-cmd-resource-exchange-goal 25))

; Enemy recovery collapse creates persistent economic value.
(defrule
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:30)
=>
    (set-goal byz-cmd-production-denial-value-goal 75)
    (set-goal byz-cmd-gold-denial-value-goal 65))

; Production depth weakness is valuable when we can reach it.
(defrule
    (up-compare-goal byz-enemy-production-depth-goal <= c:30)
    (up-compare-goal byz-map-control-goal >= c:55)
=>
    (set-goal byz-cmd-production-denial-value-goal 85))

; Transition pressure itself is not damage, but it can create a timing window.
(defrule
    (up-compare-goal byz-enemy-transition-pressure-goal >= c:60)
=>
    (set-goal byz-cmd-transition-window-goal 75))

; A punishment window is more valuable when the enemy is already damaged.
(defrule
    (up-compare-goal byz-cmd-transition-window-goal >= c:60)
    (up-compare-goal byz-cmd-enemy-damage-goal >= c:40)
=>
    (set-goal byz-cmd-conversion-window-goal 75))

; Siege safety is explicitly required before siege conversion.
(defrule
    (up-compare-goal byz-force-siege-safe-demand-goal >= c:60)
    (up-compare-goal byz-cmd-siege-safety-goal < c:50)
=>
    (set-goal byz-cmd-command-goal byz-cmd-hold)
    (set-goal byz-cmd-battle-risk-goal 75))

; Add high-value asset risks to lost military value.
(defrule
    (up-compare-goal byz-cmd-siege-safety-goal < c:35)
    (up-compare-goal byz-force-siege-demand-goal >= c:40)
=>
    (set-goal byz-cmd-lost-military-value-goal 70))

(defrule
    (up-compare-goal byz-cmd-monk-safety-goal < c:35)
    (up-compare-goal byz-force-monk-demand-goal >= c:4)
=>
    (set-goal byz-cmd-lost-military-value-goal 75))

; Position becomes a direct economic value when it controls a critical area.
(defrule
    (up-compare-goal byz-map-control-importance-goal >= c:70)
    (up-compare-goal byz-map-control-goal >= c:60)
=>
    (set-goal byz-cmd-position-quality-goal 85)
    (set-goal byz-cmd-lost-position-goal 75))

(defrule
    (up-compare-goal byz-map-control-importance-goal <= c:30)
=>
    (set-goal byz-cmd-position-quality-goal 35)
    (set-goal byz-cmd-lost-position-goal 30))

; Reinforcement advantage is high when we have initiative and enemy freedom is low.
(defrule
    (up-compare-goal byz-initiative-goal >= c:65)
    (up-compare-goal byz-enemy-reinforcement-speed-goal <= c:45)
=>
    (set-goal byz-cmd-reinforcement-value-goal 80))

(defrule
    (up-compare-goal byz-enemy-reinforcement-speed-goal >= c:70)
    (up-compare-goal byz-initiative-goal <= c:45)
=>
    (set-goal byz-cmd-enemy-reinforcement-gap-goal 80))

; Aggregate BattleValue — bounded strategic model.
; Each family contributes through coarse bands so the result stays
; discriminative instead of saturating immediately at 100.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-cmd-battle-value-goal 50))
(defrule
    (up-compare-goal byz-cmd-resource-exchange-goal >= c:70)
    (up-compare-goal byz-cmd-gold-denial-value-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:+ 18))
(defrule
    (up-compare-goal byz-cmd-resource-exchange-goal >= c:55)
    (up-compare-goal byz-cmd-production-denial-value-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:+ 15))
(defrule
    (up-compare-goal byz-cmd-map-control-value-goal >= c:70)
    (up-compare-goal byz-cmd-reinforcement-value-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:+ 12))
(defrule
    (up-compare-goal byz-cmd-siege-damage-goal >= c:60)
    (up-compare-goal byz-cmd-conversion-window-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:+ 12))
(defrule
    (up-compare-goal byz-cmd-villager-damage-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:+ 10))
(defrule
    (up-compare-goal byz-cmd-lost-military-value-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:- 18))
(defrule
    (up-compare-goal byz-cmd-lost-position-goal >= c:60)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:- 12))
(defrule
    (up-compare-goal byz-cmd-battle-risk-goal >= c:75)
=>
    (up-modify-goal byz-cmd-battle-value-goal c:- 15))

; --------------------------------------------------------------------------
; Populate battlefield-value components from the information already available.
; These are proxies until the later spatial/micro integration supplies richer
; local-unit facts. The important point is that every component has an explicit
; strategic meaning instead of remaining a decorative variable.

(defrule
    (up-compare-goal byz-threat-score-goal >= c:60)
    (up-compare-goal byz-force-raid-demand-goal >= c:50)
=>
    (set-goal byz-cmd-villager-damage-goal 55))

(defrule
    (up-compare-goal byz-force-siege-demand-goal >= c:50)
    (up-compare-goal byz-cmd-conversion-window-goal >= c:60)
=>
    (set-goal byz-cmd-siege-damage-goal 65))

(defrule
    (up-compare-goal byz-map-control-goal >= c:60)
=>
    (set-goal byz-cmd-map-control-value-goal 60))

(defrule
    (up-compare-goal byz-map-control-goal >= c:75)
=>
    (set-goal byz-cmd-map-control-value-goal 80))

(defrule
    (up-compare-goal byz-force-current-cap-score-goal >= c:65)
=>
    (set-goal byz-cmd-force-coverage-goal 75))

(defrule
    (up-compare-goal byz-battle-risk-goal >= c:70)
=>
    (set-goal byz-cmd-battle-risk-goal 85))

(defrule
    (up-compare-goal byz-cmd-overextension-goal >= c:70)
=>
    (set-goal byz-cmd-position-loss-risk-goal 80))

; Micro burden is not an excuse to avoid strong armies; it is a practical cost
; applied when two strategies are otherwise close.
(defrule
    (up-compare-goal byz-force-flexibility-goal >= c:80)
    (up-compare-goal byz-cmd-mobility-fit-goal >= c:70)
=>
    (set-goal byz-cmd-micro-burden-goal 65))

(defrule
    (up-compare-goal byz-force-flexibility-goal <= c:40)
=>
    (set-goal byz-cmd-micro-burden-goal 35))

; Reserve safety is a direct practical risk control.
(defrule
    (up-compare-goal byz-optionality-goal <= c:30)
=>
    (set-goal byz-cmd-reserve-goal 35))

(defrule
    (up-compare-goal byz-optionality-goal >= c:70)
=>
    (set-goal byz-cmd-reserve-goal 80))

; --------------------------------------------------------------------------
; Normalize / clamp BattleValue after its component roll-up.
; This keeps later thresholds stable even when several value components stack.
(defrule
    (up-compare-goal byz-cmd-battle-value-goal >= c:100)
=>
    (set-goal byz-cmd-battle-value-goal 100))

(defrule
    (up-compare-goal byz-cmd-battle-value-goal <= c:0)
=>
    (set-goal byz-cmd-battle-value-goal 0))

; ============================================================================
; PHASE 3 — ATTRITION INDEX
; ============================================================================
; The dissertation asks whether we are making the enemy spend more than us.
; Positive attrition supports continued pressure; negative attrition demands
; adjustment, preservation, or a new lock.

(defrule
    (up-compare-goal byz-cmd-resource-exchange-goal >= c:60)
    (up-compare-goal byz-enemy-gold-dependence-goal >= c:60)
=>
    (set-goal byz-cmd-attrition-index-goal 80))

(defrule
    (up-compare-goal byz-cmd-resource-exchange-goal <= c:35)
    (up-compare-goal byz-enemy-gold-dependence-goal <= c:40)
=>
    (set-goal byz-cmd-attrition-index-goal 30))

; Gold denial is especially valuable when the opponent has expensive gold dependence.
(defrule
    (up-compare-goal byz-enemy-gold-dependence-goal >= c:75)
    (up-compare-goal byz-map-control-goal >= c:60)
=>
    (set-goal byz-cmd-gold-denial-value-goal 90))

; ============================================================================
; PHASE 4 — LOCK FORCING
; ============================================================================
; A lock is valuable when the opponent has committed heavily, changing is costly,
; and our next counter is already prepared.

(defrule
    (up-compare-goal byz-enemy-transition-pressure-goal >= c:65)
    (up-compare-goal byz-intel-ambiguity-goal <= c:50)
    (up-compare-goal byz-force-flexibility-goal >= c:50)
=>
    (set-goal byz-cmd-lock-score-goal 80))

(defrule
    (up-compare-goal byz-enemy-transition-pressure-goal <= c:25)
=>
    (set-goal byz-cmd-lock-score-goal 25))

; ============================================================================
; PHASE 5 — TRANSITION WINDOWS
; ============================================================================
; Attack when the enemy is aging, changing composition, exposed, or has lost
; a structural anchor. The Intelligence layer already provides transition pressure;
; the Commander decides whether the window is operationally worth taking.

(defrule
    (up-compare-goal byz-cmd-transition-window-goal >= c:70)
    (up-compare-goal byz-cmd-battle-risk-goal <= c:50)
=>
    (set-goal byz-cmd-time-pressure-goal 75))

(defrule
    (up-compare-goal byz-cmd-transition-window-goal >= c:70)
    (up-compare-goal byz-cmd-battle-risk-goal >= c:70)
=>
    (set-goal byz-cmd-command-goal byz-cmd-delay))

; ============================================================================
; PHASE 6 — REINFORCEMENT WAR
; ============================================================================
; Do not attack the enemy's strongest point when his reinforcements are the actual
; vulnerability. Interception can produce a better exchange than frontal contact.

(defrule
    (up-compare-goal byz-cmd-enemy-reinforcement-gap-goal >= c:70)
    (up-compare-goal byz-cmd-reinforcement-value-goal >= c:50)
=>
    (set-goal byz-cmd-intercept-window-goal 85)
    (set-goal byz-cmd-command-goal byz-cmd-intercept))

(defrule
    (up-compare-goal byz-cmd-intercept-window-goal >= c:75)
    (up-compare-goal byz-force-mobile-demand-goal >= c:55)
=>
    (set-goal byz-cmd-command-goal byz-cmd-intercept)
    (set-goal byz-cmd-command-score-goal 80))

; ============================================================================
; PHASE 7 — PURSUIT DISCIPLINE
; ============================================================================
; The default response to a damaged enemy is NOT chase. Pursuit must be worth
; more than protecting the position and preserving the army.

(defrule
    (up-compare-goal byz-cmd-enemy-damage-goal >= c:70)
    (up-compare-goal byz-cmd-enemy-retreat-goal >= c:60)
    (up-compare-goal byz-cmd-reinforcement-gap-goal >= c:55)
=>
    (set-goal byz-cmd-pursuit-window-goal 75))

(defrule
    (up-compare-goal byz-cmd-position-quality-goal >= c:75)
    (up-compare-goal byz-cmd-chase-cost-goal >= c:60)
=>
    (set-goal byz-cmd-pursuit-window-goal 30))

(defrule
    (up-compare-goal byz-cmd-pursuit-window-goal >= c:75)
    (up-compare-goal byz-cmd-attrition-index-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-pursue)
    (set-goal byz-cmd-command-score-goal 75))

; ============================================================================
; PHASE 8 — RAID / MAP WAR
; ============================================================================
; A main army that cannot be profitably attacked may still be strategically useless.
; Raid when the enemy's military concentration exposes the economy.

(defrule
    (up-compare-goal byz-cmd-attrition-index-goal <= c:45)
    (up-compare-goal byz-enemy-map-freedom-goal >= c:60)
    (up-compare-goal byz-force-raid-demand-goal >= c:55)
=>
    (set-goal byz-cmd-raid-window-goal 75)
    (set-goal byz-cmd-command-goal byz-cmd-raid))

(defrule
    (up-compare-goal byz-cmd-raid-window-goal >= c:70)
    (up-compare-goal byz-force-mobile-demand-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-raid)
    (set-goal byz-cmd-command-score-goal 72))

; ============================================================================
; PHASE 9 — SIEGE CONVERSION
; ============================================================================
; Siege turns battlefield control into irreversible damage. It should never be
; exposed merely because the commander is eager to attack.

(defrule
    (up-compare-goal byz-force-conversion-demand-goal >= c:70)
    (up-compare-goal byz-cmd-siege-safety-goal >= c:65)
    (up-compare-goal byz-cmd-battle-value-goal >= c:70)
=>
    (set-goal byz-cmd-siege-window-goal 85)
    (set-goal byz-cmd-command-goal byz-cmd-siege-push)
    (set-goal byz-cmd-conversion-window-goal 90))

(defrule
    (up-compare-goal byz-cmd-siege-window-goal >= c:80)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:35)
=>
    (set-goal byz-cmd-command-goal byz-cmd-convert)
    (set-goal byz-cmd-command-score-goal 90))

; ============================================================================
; PHASE 10 — OVEREXTENSION / RETREAT
; ============================================================================
; Retreat is not failure. It is a resource-preservation decision when the battle
; value turns negative or the army leaves valuable ground without compensation.

(defrule
    (up-compare-goal byz-cmd-battle-value-goal <= c:30)
    (up-compare-goal byz-cmd-battle-risk-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-retreat)
    (set-goal byz-cmd-command-score-goal 90))

(defrule
    (up-compare-goal byz-cmd-overextension-goal >= c:70)
    (up-compare-goal byz-cmd-reinforcement-gap-goal <= c:40)
=>
    (set-goal byz-cmd-command-goal byz-cmd-retreat)
    (set-goal byz-cmd-command-risk-goal 85))

(defrule
    (up-compare-goal byz-cmd-lost-position-goal >= c:75)
    (up-compare-goal byz-cmd-battle-value-goal < c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-hold))

; ============================================================================
; PHASE 11 — DEFAULT ENGAGEMENT GATE
; ============================================================================
; Engaging requires three things: good expected exchange, adequate confidence,
; and enough reserve to survive a tactical surprise.

(defrule
    (up-compare-goal byz-cmd-battle-value-goal >= c:70)
    (up-compare-goal byz-cmd-battle-confidence-goal >= c:60)
    (up-compare-goal byz-cmd-reserve-goal >= c:50)
    (up-compare-goal byz-cmd-battle-risk-goal <= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-engage)
    (set-goal byz-cmd-command-score-goal 80))

; Low confidence shifts the AI toward observation/delay instead of gambling.
(defrule
    (up-compare-goal byz-cmd-battle-confidence-goal <= c:35)
    (up-compare-goal byz-cmd-battle-risk-goal >= c:55)
=>
    (set-goal byz-cmd-command-goal byz-cmd-delay)
    (set-goal byz-cmd-command-score-goal 70))

; ============================================================================
; PHASE 12 — DISSERTATION STATE MACHINE
; ============================================================================
; Map the five conceptual states onto actual battlefield behavior.

(defrule
    (goal byz-state-goal byz-state-stabilize)
=>
    (set-goal byz-cmd-mode-goal byz-cmd-mode-neutralize))

(defrule
    (goal byz-state-goal byz-state-constrain)
=>
    (set-goal byz-cmd-mode-goal byz-cmd-mode-contain))

(defrule
    (goal byz-state-goal byz-state-exploit)
=>
    (set-goal byz-cmd-mode-goal byz-cmd-mode-starve))

(defrule
    (goal byz-state-goal byz-state-convert)
=>
    (set-goal byz-cmd-mode-goal byz-cmd-mode-convert))

(defrule
    (goal byz-state-goal byz-state-deny-recovery)
=>
    (set-goal byz-cmd-mode-goal byz-cmd-mode-choke))

; Mode-specific command bias. Bias does not override emergency retreat.
(defrule
    (goal byz-cmd-mode-goal byz-cmd-mode-neutralize)
    (up-compare-goal byz-cmd-battle-value-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-defend))

(defrule
    (goal byz-cmd-mode-goal byz-cmd-mode-contain)
    (up-compare-goal byz-map-control-importance-goal >= c:50)
=>
    (set-goal byz-cmd-command-goal byz-cmd-hold))

(defrule
    (goal byz-cmd-mode-goal byz-cmd-mode-starve)
    (up-compare-goal byz-cmd-gold-denial-value-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-raid))

(defrule
    (goal byz-cmd-mode-goal byz-cmd-mode-convert)
    (up-compare-goal byz-cmd-conversion-window-goal >= c:70)
=>
    (set-goal byz-cmd-command-goal byz-cmd-convert))

(defrule
    (goal byz-cmd-mode-goal byz-cmd-mode-choke)
    (up-compare-goal byz-cmd-conversion-window-goal >= c:60)
=>
    (set-goal byz-cmd-command-goal byz-cmd-siege-push))

; ============================================================================
; PHASE 13 — COMMAND INTENT EXPORT
; The Commander owns intent; the Execution Bridge owns engine attack state.
; ============================================================================
(defrule
    (up-compare-goal byz-cmd-command-goal == c:byz-cmd-retreat)
    (up-compare-goal byz-cmd-command-risk-goal >= c:75)
=>
    (set-goal byz-cmd-execution-urgency-goal 95))
(defrule
    (up-compare-goal byz-cmd-command-goal == c:engage)
    (up-compare-goal byz-cmd-command-score-goal >= c:75)
    (up-compare-goal byz-cmd-battle-confidence-goal >= c:60)
=>
    (set-goal byz-cmd-execution-urgency-goal 75))
(defrule
    (up-compare-goal byz-cmd-command-goal == c:delay)
=>
    (set-goal byz-cmd-execution-urgency-goal 25))

; ============================================================================
; PHASE 14 — AFTER-ACTION MEMORY
; ============================================================================
; We do not claim machine learning. We store the result of the strategic choice
; so the higher reasoning layer can later distinguish bad decisions from bad
; execution.

(defrule
    (up-compare-goal byz-cmd-battle-value-goal >= c:70)
    (up-compare-goal byz-cmd-command-goal == c:engage)
=>
    (set-goal byz-cmd-learning-result-goal 1)) ; successful engagement candidate

(defrule
    (up-compare-goal byz-cmd-battle-value-goal <= c:30)
    (up-compare-goal byz-cmd-command-goal == c:engage)
=>
    (set-goal byz-cmd-learning-result-goal -1)) ; poor engagement candidate

; Re-evaluate frequently. The battlefield is dynamic; no command should be immortal.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-cmd-cycle-goal 0)
    (set-goal byz-cmd-execution-urgency-goal 50))

; ============================================================================
; END OF AD BYZANTINE BATTLEFIELD COMMANDER
; ============================================================================
