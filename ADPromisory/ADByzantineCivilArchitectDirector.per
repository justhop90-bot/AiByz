; ============================================================================
; AD BYZANTINE CIVIL ARCHITECT & INFRASTRUCTURE DIRECTOR
; ============================================================================
; The civil architect.
;
; Doctrine derived from the dissertation:
;   Buildings are TIME PRODUCTION. Byzantine durability buys the army time to
;   train, villagers time to work, and the enemy time spent attacking structures
;   instead of achieving economic value.
;
; The Director treats infrastructure as a battlefield weapon:
;   DEFEND -> DELAY -> ANCHOR -> REINFORCE -> ENCLOSE -> CONVERT.
;
; It does not blindly spam walls, towers, TCs or castles. Every structure must
; answer a strategic question: what does this building protect, delay, enable,
; deny, or make harder for the opponent to recover from?
;
; Existing Promisory infrastructure primitives deliberately reused:
;   build, build-forward, can-build, can-afford-building, up-assign-builders,
;   up-set-placement-data, sn-town-center-placement and existing building counts.
;
; The Director is a planning/priority layer. The final Execution Bridge remains
; the command arbiter so old buildings.per rules do not get blindly fought.
; ============================================================================

(defconst byz-civil-cycle-goal 1850) ; civil infrastructure cycle
(defconst byz-civil-state-goal 1851) ; civil infrastructure state
(defconst byz-civil-priority-goal 1852) ; infrastructure priority
(defconst byz-civil-confidence-goal 1853) ; confidence in infrastructure plan
(defconst byz-civil-urgency-goal 1854) ; infrastructure urgency
(defconst byz-civil-time-value-goal 1855) ; building time-production value
(defconst byz-civil-space-value-goal 1856) ; space-for-time value
(defconst byz-civil-forward-value-goal 1857) ; forward infrastructure value
(defconst byz-civil-retreat-value-goal 1858) ; retreat anchor value
(defconst byz-civil-resource-protect-goal 1859) ; resource protection value
(defconst byz-civil-production-protect-goal 1860) ; production protection value
(defconst byz-civil-reinforce-value-goal 1861) ; reinforcement corridor value
(defconst byz-civil-map-control-goal 1862) ; infrastructure map-control value
(defconst byz-civil-expansion-value-goal 1863) ; expansion value
(defconst byz-civil-wall-value-goal 1864) ; walling value
(defconst byz-civil-tower-value-goal 1865) ; tower value
(defconst byz-civil-castle-value-goal 1866) ; castle value
(defconst byz-civil-tc-value-goal 1867) ; town-center value
(defconst byz-civil-production-build-value-goal 1868) ; forward production building value
(defconst byz-civil-siege-base-value-goal 1869) ; forward siege base value
(defconst byz-civil-market-value-goal 1870) ; market infrastructure value
(defconst byz-civil-monastery-value-goal 1871) ; monastery infrastructure value
(defconst byz-civil-bottleneck-goal 1872) ; infrastructure bottleneck
(defconst byz-civil-wood-pressure-goal 1873) ; wood pressure
(defconst byz-civil-stone-pressure-goal 1874) ; stone pressure
(defconst byz-civil-builder-pressure-goal 1875) ; builder availability pressure
(defconst byz-civil-building-deficit-goal 1876) ; building deficit
(defconst byz-civil-current-tc-goal 1877) ; current town centers
(defconst byz-civil-current-castle-goal 1878) ; current castles
(defconst byz-civil-current-tower-goal 1879) ; current towers
(defconst byz-civil-current-production-goal 1880) ; current forward production depth
(defconst byz-civil-frontline-distance-goal 1881) ; frontline distance
(defconst byz-civil-reinforcement-distance-goal 1882) ; reinforcement distance
(defconst byz-civil-fortification-gap-goal 1883) ; fortification gap
(defconst byz-civil-forward-risk-goal 1884) ; forward construction risk
(defconst byz-civil-exposure-goal 1885) ; civilian exposure
(defconst byz-civil-recovery-goal 1886) ; recovery infrastructure value
(defconst byz-civil-trade-route-goal 1887) ; trade route/infrastructure value
(defconst byz-civil-escape-route-goal 1888) ; escape/retreat route value
(defconst byz-civil-command-goal 1890) ; requested infrastructure command
(defconst byz-civil-command-lock-goal 1891) ; infrastructure command lock

(defconst byz-civil-observe 0)
(defconst byz-civil-measure 1)
(defconst byz-civil-defend 2)
(defconst byz-civil-delay 3)
(defconst byz-civil-forward 4)
(defconst byz-civil-expand 5)
(defconst byz-civil-convert 6)

; --------------------------- INIT -------------------------------------
(defrule
    (true)
=>
    (set-goal byz-civil-cycle-goal byz-civil-observe)
    (set-goal byz-civil-state-goal 0)
    (set-goal byz-civil-priority-goal 0)
    (set-goal byz-civil-confidence-goal 50)
    (set-goal byz-civil-urgency-goal 0)
    (set-goal byz-civil-time-value-goal 0)
    (set-goal byz-civil-space-value-goal 0)
    (set-goal byz-civil-forward-value-goal 0)
    (set-goal byz-civil-retreat-value-goal 0)
    (set-goal byz-civil-resource-protect-goal 0)
    (set-goal byz-civil-production-protect-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-civil-reinforce-value-goal 0)
    (set-goal byz-civil-map-control-goal 0)
    (set-goal byz-civil-expansion-value-goal 0)
    (set-goal byz-civil-wall-value-goal 0)
    (set-goal byz-civil-tower-value-goal 0)
    (set-goal byz-civil-castle-value-goal 0)
    (set-goal byz-civil-tc-value-goal 0)
    (set-goal byz-civil-production-build-value-goal 0)
    (set-goal byz-civil-siege-base-value-goal 0)
    (set-goal byz-civil-market-value-goal 0)
    (set-goal byz-civil-monastery-value-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-civil-bottleneck-goal 0)
    (set-goal byz-civil-wood-pressure-goal 0)
    (set-goal byz-civil-stone-pressure-goal 0)
    (set-goal byz-civil-builder-pressure-goal 0)
    (set-goal byz-civil-building-deficit-goal 0)
    (set-goal byz-civil-current-tc-goal 0)
    (set-goal byz-civil-current-castle-goal 0)
    (set-goal byz-civil-current-tower-goal 0)
    (set-goal byz-civil-current-production-goal 0)
    (set-goal byz-civil-frontline-distance-goal 0)
    (set-goal byz-civil-reinforcement-distance-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-civil-fortification-gap-goal 0)
    (set-goal byz-civil-forward-risk-goal 0)
    (set-goal byz-civil-exposure-goal 0)
    (set-goal byz-civil-recovery-goal 0)
    (set-goal byz-civil-trade-route-goal 0)
    (set-goal byz-civil-escape-route-goal 0)
    (set-goal byz-civil-command-goal 0)
    (set-goal byz-civil-command-lock-goal 0)
    (disable-self))

; --------------------------- SNAPSHOT --------------------------------
(defrule
    (timer-triggered fifteensec)
=>
    (up-get-fact building-type-count-total town-center byz-civil-current-tc-goal)
    (up-get-fact building-type-count-total castle byz-civil-current-castle-goal)
    (up-get-fact building-type-count-total watch-tower byz-civil-current-tower-goal)
    (up-get-fact building-type-count-total barracks temporary-goal)
    (up-get-fact building-type-count-total stable temporary-goal2)
    (up-get-fact building-type-count-total archery-range temporary-goal3)
    (up-get-fact building-type-count-total siege-workshop temporary-goal4)
    (set-goal byz-civil-current-production-goal 0)
    (up-modify-goal byz-civil-current-production-goal g:+ temporary-goal)
    (up-modify-goal byz-civil-current-production-goal g:+ temporary-goal2)
    (up-modify-goal byz-civil-current-production-goal g:+ temporary-goal3)
    )
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-civil-current-production-goal g:+ temporary-goal4)
    )

; --------------------------- TIME PRODUCTION -------------------------
; Enemy pressure + valuable position = buy time with durable infrastructure.
(defrule
    (up-compare-goal byz-threat-score-goal >= c:65)
    (up-compare-goal byz-position-value-goal >= c:60)
=>
    (set-goal byz-civil-time-value-goal 90)
    (set-goal byz-civil-space-value-goal 85)
    (set-goal byz-civil-priority-goal 90)
    (set-goal byz-civil-state-goal byz-civil-delay))

; Low threat + map control = infrastructure can move forward.
(defrule
    (up-compare-goal byz-threat-score-goal <= c:35)
    (up-compare-goal byz-map-control-goal >= c:65)
    (up-compare-goal byz-initiative-goal >= c:60)
=>
    (set-goal byz-civil-forward-value-goal 80)
    (set-goal byz-civil-state-goal byz-civil-forward))

; --------------------------- RESOURCE PROTECTION ---------------------
; Protect the resources the Economic War Director says are strategically vital.
(defrule
    (up-compare-goal byz-gold-denial-cap-goal >= c:60)
    (up-compare-goal byz-enemy-gold-dependence-goal >= c:60)
=>
    (set-goal byz-civil-resource-protect-goal 90)
    (set-goal byz-civil-map-control-goal 75))

(defrule
    (up-compare-goal byz-eco-security-goal <= c:35)
    (up-compare-goal byz-threat-score-goal >= c:55)
=>
    (set-goal byz-civil-resource-protect-goal 95)
    (set-goal byz-civil-exposure-goal 85)
    (set-goal byz-civil-state-goal byz-civil-defend))

; --------------------------- PRODUCTION / REINFORCEMENT ----------------
(defrule
    (up-compare-goal byz-prod-capacity-pressure-goal >= c:70)
    (up-compare-goal byz-map-control-goal >= c:50)
=>
    (set-goal byz-civil-production-build-value-goal 90)
    (set-goal byz-civil-reinforce-value-goal 85)
    (set-goal byz-civil-forward-value-goal 70))

(defrule
    (up-compare-goal byz-force-siege-demand-goal >= c:60)
    (up-compare-goal byz-civil-production-build-value-goal >= c:60)
=>
    (set-goal byz-civil-siege-base-value-goal 85)
    (set-goal byz-civil-reinforce-value-goal 90))

; Long reinforcement distance makes forward infrastructure more valuable.
(defrule
    (up-compare-goal byz-civil-frontline-distance-goal >= c:60)
    (up-compare-goal byz-force-map-demand-goal >= c:50)
=>
    (set-goal byz-civil-reinforce-value-goal 90)
    (set-goal byz-civil-forward-value-goal 80))

; --------------------------- TOWN CENTERS -----------------------------
; Existing buildings.per already selects lumber/mining placement for TCs.
; We only raise the strategic desire when expansion buys meaningful value.
(defrule
    (up-compare-goal byz-civil-expansion-value-goal >= c:75)
    (up-compare-goal byz-civil-current-tc-goal < c:4)
    (up-compare-goal byz-eco-security-goal >= c:55)
=>
    (set-goal byz-civil-tc-value-goal 85)
    (set-goal byz-civil-command-goal town-center))

(defrule
    (up-compare-goal byz-threat-score-goal >= c:75)
    (up-compare-goal byz-civil-current-tc-goal >= c:1)
=>
    (set-goal byz-civil-tc-value-goal 25))

; --------------------------- CASTLES ---------------------------------
; Castle = anchor + map denial + forward production + conversion platform.
(defrule
    (up-compare-goal byz-conversion-ready-goal >= c:75)
    (up-compare-goal byz-map-control-goal >= c:65)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:55)
=>
    (set-goal byz-civil-castle-value-goal 95)
    (set-goal byz-civil-forward-value-goal 90)
    (set-goal byz-civil-command-goal castle))

(defrule
    (up-compare-goal byz-eco-security-goal <= c:30)
    (up-compare-goal byz-threat-score-goal >= c:70)
=>
    (set-goal byz-civil-castle-value-goal 80)
    (set-goal byz-civil-time-value-goal 95))

; --------------------------- TOWERS / WALLS ----------------------------
; We use existing placement/build machinery; no invented map API.
(defrule
    (up-compare-goal byz-civil-time-value-goal >= c:75)
    (up-compare-goal byz-civil-resource-protect-goal >= c:70)
    (building-type-count-total watch-tower < 6)
=>
    (set-goal byz-civil-tower-value-goal 85)
    (set-goal byz-civil-wall-value-goal 75)
    (set-goal byz-civil-command-goal watch-tower))

(defrule
    (up-compare-goal byz-civil-forward-value-goal >= c:75)
    (up-compare-goal byz-civil-reinforce-value-goal >= c:70)
=>
    (set-goal byz-civil-production-build-value-goal 85)
    (set-goal byz-civil-builder-pressure-goal 80))

; --------------------------- RETREAT / RECOVERY -----------------------
; The architecture should preserve an army rather than force it to die beside
; an undefended resource line.
(defrule
    (up-compare-goal byz-battle-risk-goal >= c:75)
    (up-compare-goal byz-battle-exchange-goal < c:45)
=>
    (set-goal byz-civil-retreat-value-goal 90)
    (set-goal byz-civil-escape-route-goal 85)
    (set-goal byz-civil-state-goal byz-civil-defend))

(defrule
    (up-compare-goal byz-civil-recovery-goal >= c:70)
    (up-compare-goal byz-state-goal == byz-state-recover)
=>
    (set-goal byz-civil-retreat-value-goal 85)
    (set-goal byz-civil-resource-protect-goal 90))

; --------------------------- FORWARD CONVERSION -----------------------
(defrule
    (up-compare-goal byz-state-goal == byz-state-convert)
    (up-compare-goal byz-civil-forward-value-goal >= c:65)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:40)
=>
    (set-goal byz-civil-production-build-value-goal 95)
    (set-goal byz-civil-siege-base-value-goal 90)
    (set-goal byz-civil-castle-value-goal 90)
    (set-goal byz-civil-state-goal byz-civil-convert))

; --------------------------- BUILD SAFETY GATE ------------------------
; Never build forward merely because it is desirable: map control + initiative
; + safe economy are required, unless the position is explicitly being used to buy time.
(defrule
    (up-compare-goal byz-civil-forward-value-goal >= c:70)
    (up-compare-goal byz-map-control-goal <= c:35)
    (up-compare-goal byz-threat-score-goal <= c:70)
=>
    (set-goal byz-civil-forward-risk-goal 90))

(defrule
    (up-compare-goal byz-civil-forward-risk-goal >= c:80)
=>
    (set-goal byz-civil-production-build-value-goal 35)
    (set-goal byz-civil-forward-value-goal 35))

; --------------------------- COMMAND OUTPUT ---------------------------
; V4: Buildings.per retains placement/build authority. This director emits only
; a strategic request through increase-town-size-goal and a descriptive command.
(defrule
    (up-compare-goal byz-civil-command-goal == town-center)
    (up-compare-goal byz-civil-tc-value-goal >= c:70)
    (can-afford-building town-center)
    (can-build town-center)
=>
    (set-goal increase-town-size-goal town-center))
(defrule
    (up-compare-goal byz-civil-command-goal == castle)
    (up-compare-goal byz-civil-castle-value-goal >= c:80)
    (can-afford-building castle)
    (can-build castle)
=>
    (set-goal byz-civil-command-lock-goal 1))
(defrule
    (up-compare-goal byz-civil-forward-risk-goal >= c:80)
=>
    (set-goal byz-civil-command-lock-goal 0))

; --------------------------- HEARTBEAT --------------------------------
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-civil-cycle-goal byz-civil-observe))

; ============================================================================
; END OF AD BYZANTINE CIVIL ARCHITECT & INFRASTRUCTURE DIRECTOR
; ============================================================================
