; ============================================================================
; AD BYZANTINE COMMAND & COMMUNICATIONS NETWORK — V4
; ============================================================================
; Resolve commander intent into one coherent command. No engine attack/train/
; research/build execution occurs here. ExecutionBridge is the only military
; execution authority.
; ============================================================================
(defconst byz-net-cycle-goal 970)
(defconst byz-net-state-goal 971)
(defconst byz-net-priority-goal 972)
(defconst byz-net-source-goal 973)
(defconst byz-net-command-goal 974)
(defconst byz-net-objective-goal 975)
(defconst byz-net-target-goal 976)
(defconst byz-net-command-score-goal 977)
(defconst byz-net-command-confidence-goal 978)
(defconst byz-net-command-urgency-goal 979)
(defconst byz-net-command-risk-goal 980)
(defconst byz-net-command-cost-goal 981)
(defconst byz-net-message-age-goal 982)
(defconst byz-net-message-fresh-goal 983)
(defconst byz-net-ack-goal 984)
(defconst byz-net-ack-time-goal 985)
(defconst byz-net-conflict-goal 986)
(defconst byz-net-veto-goal 987)
(defconst byz-net-emergency-goal 988)
(defconst byz-net-escalation-goal 989)
(defconst byz-net-deescalation-goal 990)
(defconst byz-net-reserve-commit-goal 991)
(defconst byz-net-force-commit-goal 992)
(defconst byz-net-production-commit-goal 993)
(defconst byz-net-economy-commit-goal 994)
(defconst byz-net-intel-request-goal 995)
(defconst byz-net-scout-request-goal 996)
(defconst byz-net-reinforce-request-goal 997)
(defconst byz-net-siege-request-goal 998)
(defconst byz-net-raid-request-goal 999)
(defconst byz-net-retreat-request-goal 1000)
(defconst byz-net-conversion-request-goal 1001)
(defconst byz-net-map-request-goal 1002)
(defconst byz-net-naval-request-goal 1003)
(defconst byz-net-resource-priority-goal 1004)
(defconst byz-net-tech-priority-goal 1005)
(defconst byz-net-building-priority-goal 1006)
(defconst byz-net-micro-priority-goal 1007)
(defconst byz-net-battle-feedback-goal 1008)
(defconst byz-net-economic-feedback-goal 1009)
(defconst byz-net-intel-feedback-goal 1010)
(defconst byz-net-production-feedback-goal 1011)
(defconst byz-net-plan-feedback-goal 1012)
(defconst byz-net-dissent-goal 1013)
(defconst byz-net-command-lock-goal 1014)
(defconst byz-net-last-command-goal 1015)
(defconst byz-net-last-objective-goal 1016)
(defconst byz-net-heartbeat-goal 1017)
(defconst byz-net-decision-integrity-goal 1018)
(defconst byz-net-failure-mode-goal 1019)
(defconst byz-net-safety-mode-goal 1020)
(defconst byz-net-sync-goal 1021)
(defconst byz-net-proposed-command-goal 1022)
(defconst byz-net-proposed-score-goal 1023)
(defconst byz-net-proposed-risk-goal 1024)
(defconst byz-net-proposed-urgency-goal 1025)
(defconst byz-net-command-epoch-goal 1026)
(defconst byz-net-last-epoch-goal 1027)
(defconst byz-net-arbitration-reason-goal 1028)

(defconst byz-net-idle 0)
(defconst byz-net-collect 1)
(defconst byz-net-arbitrate 2)
(defconst byz-net-broadcast 3)
(defconst byz-net-acknowledge 4)
(defconst byz-net-recover 5)
(defconst byz-net-priority-routine 10)
(defconst byz-net-priority-important 40)
(defconst byz-net-priority-urgent 70)
(defconst byz-net-priority-emergency 100)
(defconst byz-net-source-intelligence 1)
(defconst byz-net-source-reasoning 2)
(defconst byz-net-source-force 3)
(defconst byz-net-source-optimizer 4)
(defconst byz-net-source-production 5)
(defconst byz-net-source-battlefield 6)
(defconst byz-net-source-economy 7)
(defconst byz-net-source-siege 8)
(defconst byz-net-source-scout 9)
(defconst byz-net-source-execution 10)
(defconst byz-net-lock-none 0)
(defconst byz-net-lock-soft 1)
(defconst byz-net-lock-hard 2)
(defconst byz-net-lock-emergency 3)
(defconst byz-net-failure-none 0)
(defconst byz-net-failure-stale-info 1)
(defconst byz-net-failure-conflict 2)
(defconst byz-net-failure-uncertain 3)
(defconst byz-net-failure-execution-lag 4)
(defconst byz-net-ack-none 0)
(defconst byz-net-ack-sent 1)
(defconst byz-net-ack-seen 2)
(defconst byz-net-ack-accepted 3)
(defconst byz-net-ack-rejected 4)
(defconst byz-net-ack-expired 5)

(defrule
    (true)
=>
    (set-goal byz-net-cycle-goal byz-net-idle)
    (set-goal byz-net-state-goal byz-net-collect)
    (set-goal byz-net-priority-goal byz-net-priority-routine)
    (set-goal byz-net-source-goal byz-net-source-battlefield)
    (set-goal byz-net-command-goal byz-cmd-hold)
    (set-goal byz-net-proposed-command-goal byz-cmd-hold)
    (set-goal byz-net-command-score-goal 0)
    (set-goal byz-net-command-confidence-goal 0)
    (set-goal byz-net-command-urgency-goal 0)
    (set-goal byz-net-command-risk-goal 0)
    (set-goal byz-net-command-cost-goal 0)
    (set-goal byz-net-message-age-goal 0)
    (set-goal byz-net-message-fresh-goal 100)
    (set-goal byz-net-ack-goal byz-net-ack-none)
    (set-goal byz-net-ack-time-goal 0)
    (set-goal byz-net-conflict-goal 0)
    (set-goal byz-net-veto-goal 0)
    (set-goal byz-net-emergency-goal 0)
    (set-goal byz-net-command-lock-goal byz-net-lock-none)
    (set-goal byz-net-sync-goal 100))
(defrule
    (true)
=>
    (set-goal byz-net-command-epoch-goal 0)
    (set-goal byz-net-last-epoch-goal 0)
    (set-goal byz-net-arbitration-reason-goal 0)
    (set-goal byz-net-decision-integrity-goal 100)
    (set-goal byz-net-failure-mode-goal byz-net-failure-none)
    (set-goal byz-net-safety-mode-goal 1)
    (set-goal byz-net-retreat-request-goal 0)
    (set-goal byz-net-siege-request-goal 0)
    (set-goal byz-net-raid-request-goal 0)
    (set-goal byz-net-conversion-request-goal 0)
    (set-goal byz-net-intercept-request-goal 0)
    (set-goal byz-net-scout-request-goal 0))

; Snapshot the field marshal's proposal.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-net-proposed-command-goal g:= byz-cmd-command-goal)
    (up-modify-goal byz-net-proposed-score-goal g:= byz-cmd-command-score-goal)
    (up-modify-goal byz-net-proposed-risk-goal g:= byz-cmd-command-risk-goal)
    (up-modify-goal byz-net-proposed-urgency-goal g:= byz-cmd-execution-urgency-goal)
    (up-modify-goal byz-net-command-confidence-goal g:= byz-cmd-battle-confidence-goal)
    (up-modify-goal byz-net-command-cost-goal g:= byz-cmd-command-cost-goal)
    (up-modify-goal byz-net-command-score-goal g:= byz-cmd-command-score-goal)
    (set-goal byz-net-cycle-goal byz-net-arbitrate))

; Fresh command epoch.
(defrule
    (up-compare-goal byz-net-proposed-command-goal != g:byz-net-command-goal)
=>
    (up-modify-goal byz-net-command-epoch-goal c:+ 1)
    (set-goal byz-net-message-age-goal 0)
    (set-goal byz-net-message-fresh-goal 100)
    (set-goal byz-net-ack-goal byz-net-ack-sent))

; Sovereign hard veto dominates all positive plans.
(defrule
    (up-compare-goal byz-sov-veto-goal >= c:85)
    (up-compare-goal byz-sov-emergency-override-goal < c:90)
=>
    (set-goal byz-net-command-goal byz-cmd-retreat)
    (set-goal byz-net-veto-goal 100)
    (set-goal byz-net-command-lock-goal byz-net-lock-emergency)
    (set-goal byz-net-priority-goal byz-net-priority-emergency)
    (set-goal byz-net-arbitration-reason-goal 1))
; Explicit commander retreat outranks all other requests.
(defrule
    (up-compare-goal byz-sov-veto-goal < c:85)
    (up-compare-goal byz-net-proposed-command-goal == c:byz-cmd-retreat)
=>
    (set-goal byz-net-command-goal byz-cmd-retreat)
    (set-goal byz-net-priority-goal byz-net-priority-emergency)
    (set-goal byz-net-command-lock-goal byz-net-lock-hard)
    (set-goal byz-net-arbitration-reason-goal 2))
; High-risk engage is converted to hold/retreat rather than allowing optimistic overrides.
(defrule
    (up-compare-goal byz-sov-veto-goal < c:85)
    (up-compare-goal byz-net-proposed-risk-goal >= c:80)
    (up-compare-goal byz-net-proposed-command-goal == c:byz-cmd-engage)
=>
    (set-goal byz-net-command-goal byz-cmd-hold)
    (set-goal byz-net-conflict-goal 1)
    (set-goal byz-net-command-lock-goal byz-net-lock-hard)
    (set-goal byz-net-priority-goal byz-net-priority-urgent)
    (set-goal byz-net-arbitration-reason-goal 3))
; Normal commands are accepted if communication health is adequate.
(defrule
    (up-compare-goal byz-sov-veto-goal < c:85)
    (up-compare-goal byz-net-proposed-risk-goal < c:80)
    (up-compare-goal byz-net-proposed-command-goal != c:byz-cmd-retreat)
    (up-compare-goal byz-net-failure-mode-goal < c:2)
=>
    (up-modify-goal byz-net-command-goal g:= byz-net-proposed-command-goal)
    (set-goal byz-net-command-lock-goal byz-net-lock-soft)
    (set-goal byz-net-arbitration-reason-goal 4))

; Specialist requests may only replace a weak non-retreat plan.
(defrule
    (up-compare-goal byz-net-command-goal == c:byz-cmd-engage)
    (up-compare-goal byz-net-intercept-request-goal >= c:80)
    (up-compare-goal byz-cmd-reinforcement-gap-goal >= c:50)
=>
    (set-goal byz-net-command-goal byz-cmd-intercept)
    (set-goal byz-net-command-lock-goal byz-net-lock-soft))
(defrule
    (up-compare-goal byz-net-command-goal != c:byz-cmd-retreat)
    (up-compare-goal byz-net-command-goal != c:byz-cmd-hold)
    (up-compare-goal byz-net-siege-request-goal >= c:85)
    (up-compare-goal byz-cmd-siege-safety-goal >= c:70)
=>
    (set-goal byz-net-command-goal byz-cmd-siege-push))

; Expire commands rather than preserve a stale aggressive order forever.
(defrule
    (timer-triggered fifteensec)
    (up-compare-goal byz-net-command-goal != c:byz-cmd-hold)
=>
    (up-modify-goal byz-net-message-age-goal c:+ 15)
    (up-modify-goal byz-net-message-fresh-goal c:- 15))
(defrule
    (up-compare-goal byz-net-message-age-goal >= c:45)
    (up-compare-goal byz-net-command-goal != c:byz-cmd-retreat)
=>
    (set-goal byz-net-command-goal byz-cmd-hold)
    (set-goal byz-net-failure-mode-goal byz-net-failure-stale-info)
    (set-goal byz-net-command-lock-goal byz-net-lock-soft)
    (set-goal byz-net-ack-goal byz-net-ack-expired))

; Health and feedback. ExecutionBridge alone marks accepted.
(defrule
    (up-compare-goal byz-net-command-goal == g:byz-net-last-command-goal)
    (up-compare-goal byz-net-ack-goal == c:byz-net-ack-accepted)
=>
    (set-goal byz-net-decision-integrity-goal 100))
(defrule
    (up-compare-goal byz-net-conflict-goal >= c:1)
=>
    (set-goal byz-net-decision-integrity-goal 60)
    (set-goal byz-net-sync-goal 60))
(defrule
    (up-compare-goal byz-net-veto-goal >= c:90)
=>
    (set-goal byz-net-decision-integrity-goal 90)
    (set-goal byz-net-safety-mode-goal 2))
(defrule
    (up-compare-goal byz-net-command-goal != g:byz-net-last-command-goal)
=>
    (up-modify-goal byz-net-last-command-goal g:= byz-net-command-goal)
    (up-modify-goal byz-net-last-objective-goal g:= byz-net-objective-goal))
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-net-heartbeat-goal 100)
    (up-modify-goal byz-net-ack-time-goal c:+ 15)
    (set-goal byz-net-cycle-goal byz-net-broadcast))
