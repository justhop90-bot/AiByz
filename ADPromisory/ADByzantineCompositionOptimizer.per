; ============================================================================
; AD BYZANTINE COMPOSITION OPTIMIZER
; ============================================================================
; The blade.
;
; This module does not ask for the strongest unit or the largest army.
; It runs a compact tournament between seven Byzantine doctrines:
;   SHIELD, SPEAR, ANVIL, HAMMER, NET, SIEGE TRAIN, PHOENIX.
;
; Each candidate is scored from state already available in the AD stack:
;   Intelligence -> enemy pressure, ambiguity, transition confidence.
;   Reasoning    -> state, risk, conversion and recovery.
;   Force Plan   -> required capabilities.
;   Memory       -> economy, production, initiative and optionality.
;
; The key design rule is ROBUSTNESS:
; a candidate that is excellent only when one prediction is correct can lose
; to a candidate that is slightly weaker now but survives the likely next branch.
;
; Therefore the tournament rewards:
;   immediate fit + future resistance + conversion + map/mobility proxy
;   + production fit + optionality + continuity
; and penalizes:
;   cost pressure + time pressure + counter exposure + catastrophic regret.
;
; Only syntax and identifiers already used by the copied Promisory/AD stack are
; used here: defconst, defrule, set-goal, up-compare-goal, up-modify-goal,
; timer-triggered and existing train/force goals.
; ============================================================================

(defconst byz-opt-cycle-goal 740) ; optimizer cycle
(defconst byz-opt-candidate-goal 741) ; selected candidate
(defconst byz-opt-best-score-goal 742) ; winning score
(defconst byz-opt-runner-score-goal 743) ; second-best score
(defconst byz-opt-margin-goal 744) ; winner margin
(defconst byz-opt-lock-goal 745) ; plan stability lock
(defconst byz-opt-regret-goal 748) ; catastrophic regret
(defconst byz-opt-confidence-goal 749) ; decision confidence
(defconst byz-opt-shield-score-goal 752) ; Shield score
(defconst byz-opt-spear-score-goal 758) ; Spear score
(defconst byz-opt-anvil-score-goal 763) ; Anvil score
(defconst byz-opt-hammer-score-goal 764) ; Hammer score
(defconst byz-opt-net-score-goal 765) ; Net score
(defconst byz-opt-siege-score-goal 769) ; Siege Train score
(defconst byz-opt-phoenix-score-goal 770) ; Phoenix score
(defconst byz-opt-now-goal 771) ; immediate fit
(defconst byz-opt-future-goal 772) ; transition resistance
(defconst byz-opt-map-goal 773) ; map fit proxy
(defconst byz-opt-convert-goal 776) ; conversion value
(defconst byz-opt-cost-goal 777) ; cost penalty
(defconst byz-opt-production-goal 778) ; production fit
(defconst byz-opt-tech-goal 779) ; tech readiness proxy
(defconst byz-opt-time-goal 781) ; time fit
(defconst byz-opt-micro-goal 790) ; micro burden proxy
(defconst byz-opt-optionality-goal 791) ; future optionality
(defconst byz-opt-counter-exposure-goal 794) ; counter exposure
(defconst byz-opt-current-fit-goal 795) ; current army continuity
(defconst byz-opt-scouting-bias-goal 798) ; uncertainty bias
(defconst byz-opt-deficit-severity-goal 799) ; desired army deficit
(defconst byz-opt-transition-risk-goal 805) ; predicted enemy answer risk
(defconst byz-opt-last-candidate-goal 2170) ; previous winner
(defconst byz-opt-stability-count-goal 2171) ; consecutive winner count


; Candidate enums are local symbolic labels, not engine strategic numbers.
(defconst byz-opt-none 0)
(defconst byz-opt-shield 1)
(defconst byz-opt-spear 2)
(defconst byz-opt-anvil 3)
(defconst byz-opt-hammer 4)
(defconst byz-opt-net 5)
(defconst byz-opt-siege-train 6)
(defconst byz-opt-phoenix 7)

; ------------------------- INITIALIZATION ------------------------------
(defrule
    (true)
=>
    (set-goal byz-opt-cycle-goal 0)
    (set-goal byz-opt-candidate-goal byz-opt-none)
    (set-goal byz-opt-best-score-goal 0)
    (set-goal byz-opt-runner-score-goal 0)
    (set-goal byz-opt-margin-goal 0)
    (set-goal byz-opt-lock-goal 0)
    (set-goal byz-opt-regret-goal 0)
    (set-goal byz-opt-confidence-goal 0)
    (set-goal byz-opt-shield-score-goal 0)
    (set-goal byz-opt-spear-score-goal 0)
    (set-goal byz-opt-anvil-score-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-opt-hammer-score-goal 0)
    (set-goal byz-opt-net-score-goal 0)
    (set-goal byz-opt-siege-score-goal 0)
    (set-goal byz-opt-phoenix-score-goal 0)
    (set-goal byz-opt-now-goal 0)
    (set-goal byz-opt-future-goal 0)
    (set-goal byz-opt-map-goal 0)
    (set-goal byz-opt-convert-goal 0)
    (set-goal byz-opt-cost-goal 0)
    (set-goal byz-opt-production-goal 0)
    (set-goal byz-opt-tech-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-opt-time-goal 0)
    (set-goal byz-opt-micro-goal 0)
    (set-goal byz-opt-optionality-goal 0)
    (set-goal byz-opt-counter-exposure-goal 0)
    (set-goal byz-opt-current-fit-goal 0)
    (set-goal byz-opt-scouting-bias-goal 0)
    (set-goal byz-opt-deficit-severity-goal 0)
    (set-goal byz-opt-transition-risk-goal 0)
    (set-goal byz-opt-last-candidate-goal byz-opt-none)
    (set-goal byz-opt-stability-count-goal 0)
    (disable-self))

; =========================================================================
; ACT I — REALITY
; =========================================================================
; Reset the common score components every cycle. Scores are deliberately built
; from observed AD state rather than imaginary unit-stat arithmetic.

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-cycle-goal 1)
    (set-goal byz-opt-now-goal 35)
    (set-goal byz-opt-future-goal 35)
    (set-goal byz-opt-map-goal 35)
    (set-goal byz-opt-convert-goal 20)
    (set-goal byz-opt-cost-goal 20)
    (set-goal byz-opt-production-goal 35)
    (set-goal byz-opt-tech-goal 35)
    (set-goal byz-opt-time-goal 35)
    (set-goal byz-opt-micro-goal 20)
    (set-goal byz-opt-optionality-goal 35)
    )
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-counter-exposure-goal 20)
    (set-goal byz-opt-current-fit-goal 50)
    (set-goal byz-opt-scouting-bias-goal 0)
    (set-goal byz-opt-transition-risk-goal 0)
    (set-goal byz-opt-regret-goal 0)
    )

; Immediate fit rises with a strong, understood threat.
(defrule
    (up-compare-goal byz-threat-score-goal >= c:60)
    (up-compare-goal byz-threat-confidence-goal >= c:60)
=>
    (set-goal byz-opt-now-goal 75))

(defrule
    (up-compare-goal byz-threat-score-goal >= c:80)
=>
    (set-goal byz-opt-now-goal 90)
    (set-goal byz-opt-time-goal 85))

; Ambiguity changes doctrine: preserve options rather than pretend certainty.
(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:60)
=>
    (set-goal byz-opt-scouting-bias-goal 70)
    (set-goal byz-opt-optionality-goal 85)
    (set-goal byz-opt-future-goal 70))

(defrule
    (up-compare-goal byz-intel-surprise-risk-goal >= c:70)
=>
    (set-goal byz-opt-scouting-bias-goal 90)
    (set-goal byz-opt-counter-exposure-goal 70)
    (set-goal byz-opt-regret-goal 75))

; Transition confidence is a future-risk input, not an automatic unit order.
(defrule
    (up-compare-goal byz-enemy-transition-pressure-goal >= c:60)
=>
    (set-goal byz-opt-future-goal 80)
    (set-goal byz-opt-transition-risk-goal 70))

(defrule
    (up-compare-goal byz-enemy-transition-pressure-goal >= c:80)
=>
    (set-goal byz-opt-future-goal 90)
    (set-goal byz-opt-transition-risk-goal 90)
    (set-goal byz-opt-regret-goal 85))

; Economy: low security punishes expensive irreversible answers.
(defrule
    (up-compare-goal byz-eco-security-goal <= c:35)
=>
    (set-goal byz-opt-cost-goal 85)
    (set-goal byz-opt-production-goal 30)
    (set-goal byz-opt-optionality-goal 85))

(defrule
    (up-compare-goal byz-eco-security-goal >= c:70)
=>
    (set-goal byz-opt-cost-goal 20)
    (set-goal byz-opt-production-goal 75))

; Map proxy: mobility and map-control demand stand in for geometry until the
; later battlefield evaluator supplies richer spatial facts.
(defrule
    (up-compare-goal byz-force-mobile-demand-goal >= c:60)
=>
    (set-goal byz-opt-map-goal 80))

(defrule
    (up-compare-goal byz-force-map-demand-goal >= c:60)
=>
    (set-goal byz-opt-map-goal 85))

; Conversion and siege readiness.
(defrule
    (up-compare-goal byz-force-conversion-demand-goal >= c:60)
=>
    (set-goal byz-opt-convert-goal 80))

(defrule
    (up-compare-goal byz-force-siege-demand-goal >= c:60)
=>
    (set-goal byz-opt-convert-goal 90)
    (set-goal byz-opt-production-goal 70))

; =========================================================================
; ACT II — FORGE THE SEVEN CANDIDATES
; =========================================================================

; SHIELD: minimum sufficient counter, cheap, robust, defensive.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-shield-score-goal 35))

(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-shield-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-force-anti-ranged-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-shield-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-eco-security-goal <= c:50)
=>
    (up-modify-goal byz-opt-shield-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:60)
=>
    (up-modify-goal byz-opt-shield-score-goal g:+ 15))

; SPEAR: precise, fast exploitation of a clear weakness.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-spear-score-goal 30))

(defrule
    (up-compare-goal byz-threat-confidence-goal >= c:70)
    (up-compare-goal byz-threat-score-goal >= c:55)
=>
    (up-modify-goal byz-opt-spear-score-goal g:+ 35))

(defrule
    (up-compare-goal byz-intel-threat-diversity-goal <= c:40)
=>
    (up-modify-goal byz-opt-spear-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:70)
=>
    (up-modify-goal byz-opt-spear-score-goal g:- 25))

; ANVIL: sustained combined arms, positional safety, siege protection.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-anvil-score-goal 30))

(defrule
    (up-compare-goal byz-force-frontline-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-anvil-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-force-siege-safe-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-anvil-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-intel-threat-diversity-goal >= c:60)
=>
    (up-modify-goal byz-opt-anvil-score-goal g:+ 25))

; HAMMER: breakthrough and mobility, but expensive and prediction-sensitive.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-hammer-score-goal 20))

(defrule
    (up-compare-goal byz-force-breakthrough-demand-goal >= c:65)
=>
    (up-modify-goal byz-opt-hammer-score-goal g:+ 35))

(defrule
    (up-compare-goal byz-force-mobile-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-hammer-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-force-anti-infantry-demand-goal >= c:65)
=>
    (up-modify-goal byz-opt-hammer-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-eco-security-goal <= c:45)
=>
    (up-modify-goal byz-opt-hammer-score-goal g:- 30))

(defrule
    (up-compare-goal byz-intel-surprise-risk-goal >= c:70)
=>
    (up-modify-goal byz-opt-hammer-score-goal g:- 25))

; NET: broad coverage and multi-front response.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-net-score-goal 25))

(defrule
    (up-compare-goal byz-force-mobile-demand-goal >= c:60)
    (up-compare-goal byz-force-map-demand-goal >= c:50)
=>
    (up-modify-goal byz-opt-net-score-goal g:+ 35))

(defrule
    (up-compare-goal byz-intel-threat-diversity-goal >= c:65)
=>
    (up-modify-goal byz-opt-net-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:55)
=>
    (up-modify-goal byz-opt-net-score-goal g:+ 20))

; SIEGE TRAIN: selected only when winning can be converted.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-siege-score-goal 15))

(defrule
    (up-compare-goal byz-force-conversion-demand-goal >= c:65)
    (up-compare-goal byz-force-siege-demand-goal >= c:50)
=>
    (up-modify-goal byz-opt-siege-score-goal g:+ 50))

(defrule
    (up-compare-goal byz-force-siege-safe-demand-goal >= c:60)
=>
    (up-modify-goal byz-opt-siege-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-eco-security-goal <= c:35)
=>
    (up-modify-goal byz-opt-siege-score-goal g:- 25))

; PHOENIX: uncertainty doctrine. Low commitment, high optionality.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-phoenix-score-goal 25))

(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:60)
=>
    (up-modify-goal byz-opt-phoenix-score-goal g:+ 35))

(defrule
    (up-compare-goal byz-intel-surprise-risk-goal >= c:60)
=>
    (up-modify-goal byz-opt-phoenix-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-optionality-goal >= c:65)
=>
    (up-modify-goal byz-opt-phoenix-score-goal g:+ 20))

(defrule
    (up-compare-goal byz-threat-confidence-goal >= c:75)
    (up-compare-goal byz-threat-score-goal >= c:75)
=>
    (up-modify-goal byz-opt-phoenix-score-goal g:- 20))

; =========================================================================
; ACT III — COUNTERFACTUAL / REGRET ADJUSTMENTS
; =========================================================================
; We cannot literally simulate future battles in .per. Instead, transition
; confidence and surprise risk penalize narrow commitments and reward armies
; with more surviving branches.

(defrule
    (up-compare-goal byz-opt-transition-risk-goal >= c:70)
=>
    (up-modify-goal byz-opt-spear-score-goal g:- 20)
    (up-modify-goal byz-opt-hammer-score-goal g:- 15)
    (up-modify-goal byz-opt-anvil-score-goal g:+ 10)
    (up-modify-goal byz-opt-net-score-goal g:+ 15)
    (up-modify-goal byz-opt-phoenix-score-goal g:+ 25))

(defrule
    (up-compare-goal byz-opt-regret-goal >= c:75)
=>
    (up-modify-goal byz-opt-spear-score-goal g:- 20)
    (up-modify-goal byz-opt-hammer-score-goal g:- 20)
    (up-modify-goal byz-opt-shield-score-goal g:+ 10)
    (up-modify-goal byz-opt-phoenix-score-goal g:+ 25))

; =========================================================================
; ACT IV — SELECT THE WINNER
; =========================================================================
; Tournament selection uses only comparisons/copies already present in the AD
; stack. First establish a baseline, then replace it when another candidate wins.

(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-shield-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-shield)
    (set-goal byz-opt-runner-score-goal 0))

(defrule
    (up-compare-goal byz-opt-spear-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-spear-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-spear))

(defrule
    (up-compare-goal byz-opt-anvil-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-anvil-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-anvil))

(defrule
    (up-compare-goal byz-opt-hammer-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-hammer-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-hammer))

(defrule
    (up-compare-goal byz-opt-net-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-net-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-net))

(defrule
    (up-compare-goal byz-opt-siege-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-siege-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-siege-train))

(defrule
    (up-compare-goal byz-opt-phoenix-score-goal g:> byz-opt-best-score-goal)
=>
    (up-modify-goal byz-opt-best-score-goal g:= byz-opt-phoenix-score-goal)
    (set-goal byz-opt-candidate-goal byz-opt-phoenix))

; Runner-up and margin are now explicit, so a one-point score win does not
; look like a high-confidence strategic lock.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-opt-runner-score-goal 0))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-shield) (up-compare-goal byz-opt-shield-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-shield-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-spear) (up-compare-goal byz-opt-spear-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-spear-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-anvil) (up-compare-goal byz-opt-anvil-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-anvil-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-hammer) (up-compare-goal byz-opt-hammer-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-hammer-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-net) (up-compare-goal byz-opt-net-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-net-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-siege-train) (up-compare-goal byz-opt-siege-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-siege-score-goal))
(defrule (up-compare-goal byz-opt-candidate-goal != c:byz-opt-phoenix) (up-compare-goal byz-opt-phoenix-score-goal g:> byz-opt-runner-score-goal) => (up-modify-goal byz-opt-runner-score-goal g:= byz-opt-phoenix-score-goal))
(defrule
    (up-compare-goal byz-opt-best-score-goal >= c:0)
=>
    (up-modify-goal byz-opt-margin-goal g:= byz-opt-best-score-goal)
    (up-modify-goal byz-opt-margin-goal g:- byz-opt-runner-score-goal))
(defrule
    (up-compare-goal byz-opt-candidate-goal == g:byz-opt-last-candidate-goal)
=>
    (up-modify-goal byz-opt-stability-count-goal c:+ 1))
(defrule
    (up-compare-goal byz-opt-candidate-goal != g:byz-opt-last-candidate-goal)
=>
    (set-goal byz-opt-stability-count-goal 1)
    (up-modify-goal byz-opt-last-candidate-goal g:= byz-opt-candidate-goal))
(defrule
    (up-compare-goal byz-opt-stability-count-goal >= c:2)
    (up-compare-goal byz-opt-margin-goal >= c:10)
=>
    (set-goal byz-opt-lock-goal 1))
(defrule
    (up-compare-goal byz-opt-margin-goal < c:10)
=>
    (set-goal byz-opt-lock-goal 0))

; Decision confidence follows the enemy model, with a stability bonus when
; the model itself is stable.
(defrule
    (true)
=>
    (up-modify-goal byz-opt-confidence-goal g:= byz-threat-confidence-goal))

(defrule
    (up-compare-goal byz-intel-model-stability-goal >= c:70)
=>
    (up-modify-goal byz-opt-confidence-goal g:+ 15))

; =========================================================================
; ACT V — THE BLUEPRINT
; =========================================================================
; The winner writes desired force demands. It does not invent new production
; commands; ForcePlanner remains the execution bridge.

; SHIELD
(defrule
    (goal byz-opt-candidate-goal byz-opt-shield)
=>
    (set-goal byz-force-cataph-demand-goal 0)
    (set-goal byz-force-hussar-demand-goal 0)
    (set-goal byz-force-siege-demand-goal 0))

; SPEAR: keep the planner's strongest immediate counter, avoid over-layering.
(defrule
    (goal byz-opt-candidate-goal byz-opt-spear)
=>
    (set-goal byz-force-flexibility-goal 35))

; ANVIL: preserve mixed frontage and siege safety.
(defrule
    (goal byz-opt-candidate-goal byz-opt-anvil)
=>
    (set-goal byz-force-frontline-demand-goal 75)
    (set-goal byz-force-siege-safe-demand-goal 75)
    (set-goal byz-force-flexibility-goal 75))

; HAMMER: Cataphracts only as a deliberate breakthrough instrument.
(defrule
    (goal byz-opt-candidate-goal byz-opt-hammer)
    (unit-available cataphract-line)
=>
    (set-goal byz-force-cataph-demand-goal 12)
    (set-goal byz-force-mobile-demand-goal 80)
    (set-goal byz-force-breakthrough-demand-goal 85))

; NET: distributed mobility and broad counter coverage.
(defrule
    (goal byz-opt-candidate-goal byz-opt-net)
=>
    (set-goal byz-force-mobile-demand-goal 80)
    (set-goal byz-force-map-demand-goal 80)
    (set-goal byz-force-flexibility-goal 90)
    (set-goal byz-force-hussar-demand-goal 12))

; SIEGE TRAIN: commit to conversion, but keep protection first.
(defrule
    (goal byz-opt-candidate-goal byz-opt-siege-train)
=>
    (set-goal byz-force-conversion-demand-goal 90)
    (set-goal byz-force-siege-demand-goal 80)
    (set-goal byz-force-siege-safe-demand-goal 85))

; PHOENIX: deliberately refuse expensive lock-in; preserve cheap coverage and
; scouting value until the model sharpens.
(defrule
    (goal byz-opt-candidate-goal byz-opt-phoenix)
=>
    (set-goal byz-force-flexibility-goal 95)
