    (up-compare-goal byz-sov-tech-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-veto-goal < c:85)
    (up-compare-goal byz-tech-command-goal == c:byz-tech-cmd-halberdier)
    (can-research ri-halberdier)
=>
    (research ri-halberdier)
    (set-goal byz-exec-research-done-goal 1)
