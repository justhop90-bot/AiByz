; Stale communications fail safe: stop proactive production except emergency spears/skirms.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-net-failure-mode-goal >= c:2)
    (up-compare-goal byz-net-command-goal != c:byz-cmd-retreat)
=>
    (set-goal traincamel no)
    (set-goal trainhussar no)
    (set-goal trainchamp no)
    (set-goal trainunique no)
    (set-goal trainhandcannon no)
    (set-goal trainmonk no)
    (set-goal trainmangonel no)
    (set-goal trainram no)
    (set-goal traintrebuchet no)
    (set-goal trainbombard no)
    (set-goal byz-exec-stale-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-net-failure-mode-goal >= c:2)
    (up-compare-goal byz-cmd-battle-risk-goal >= c:70)
=>
    (set-goal trainpike yes)
    (set-goal trainskirm yes))

; Tech execution: one approved request per second.
