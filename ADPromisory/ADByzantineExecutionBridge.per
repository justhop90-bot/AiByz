; ============================================================================
; AD BYZANTINE EXECUTION AUTHORITY BRIDGE — V4
; ============================================================================
; Final military/technology execution authority. Loaded after finaling.per.
; Reads resolved command, Sovereign gates, Force deficits and Tech request.
; It alone writes attack state, military train flags, and research commands.
; ============================================================================
(defconst byz-exec-timer 35)
(defconst byz-exec-cycle-goal 1030)
(defconst byz-exec-authority-goal 1031)
(defconst byz-exec-attack-state-goal 1032)
(defconst byz-exec-production-state-goal 1033)
(defconst byz-exec-emergency-goal 1034)
(defconst byz-exec-veto-goal 1035)
(defconst byz-exec-sync-goal 1036)
(defconst byz-exec-last-command-goal 1037)
(defconst byz-exec-last-plan-goal 1038)
(defconst byz-exec-stale-goal 1039)
(defconst byz-exec-override-count-goal 1040)
(defconst byz-exec-training-score-goal 1041)
(defconst byz-exec-attack-score-goal 1042)
(defconst byz-exec-safety-score-goal 1043)
(defconst byz-exec-research-done-goal 1044)
(defconst byz-exec-command-accepted-goal 1045)
(defconst byz-exec-training-window-goal 1046)
(defconst byz-exec-tech-window-goal 1047)
(defconst byz-exec-engine-lease-goal 1048)
(defconst byz-exec-authority-off 0)
(defconst byz-exec-authority-advisory 1)
(defconst byz-exec-authority-active 2)
(defconst byz-exec-authority-emergency 3)
(defconst byz-exec-attack-neutral 0)
(defconst byz-exec-attack-press 1)
(defconst byz-exec-attack-retreat 2)
(defconst byz-exec-attack-delay 3)
(defconst byz-exec-attack-intercept 4)
(defconst byz-exec-attack-convert 5)

(defrule
    (true)
=>
    (set-goal byz-exec-cycle-goal 0)
    (set-goal byz-exec-authority-goal byz-exec-authority-off)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-neutral)
    (set-goal byz-exec-production-state-goal 0)
    (set-goal byz-exec-emergency-goal 0)
    (set-goal byz-exec-veto-goal 0)
    (set-goal byz-exec-sync-goal 0)
    (set-goal byz-exec-last-command-goal byz-cmd-hold)
    (set-goal byz-exec-last-plan-goal 0)
    (set-goal byz-exec-stale-goal 0)
    (set-goal byz-exec-override-count-goal 0)
    (set-goal byz-exec-training-score-goal 0)
    (set-goal byz-exec-attack-score-goal 0)
    (set-goal byz-exec-safety-score-goal 100)
    (set-goal byz-exec-research-done-goal 0)
    (set-goal byz-exec-command-accepted-goal 0)
    (set-goal byz-exec-training-window-goal 0)
    (set-goal byz-exec-tech-window-goal 0)
    (set-goal byz-exec-engine-lease-goal 15)
    (enable-timer byz-exec-timer 1))

; Authority.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-sov-military-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-veto-goal < c:85)
    (up-compare-goal byz-net-decision-integrity-goal >= c:60)
    (up-compare-goal byz-net-sync-goal >= c:60)
=>
    (set-goal byz-exec-authority-goal byz-exec-authority-active)
    (set-goal byz-exec-sync-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-net-emergency-goal >= c:90)
    (up-compare-goal byz-sov-emergency-override-goal >= c:90)
=>
    (set-goal byz-exec-authority-goal byz-exec-authority-emergency)
    (set-goal byz-exec-emergency-goal 100)
    (set-goal byz-exec-sync-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-sov-military-authority-goal == c:byz-sov-authority-quarantine)
=>
    (set-goal byz-exec-authority-goal byz-exec-authority-off)
    (set-goal byz-exec-veto-goal 100)
    (set-goal byz-exec-safety-score-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-sov-veto-goal >= c:85)
    (up-compare-goal byz-sov-emergency-override-goal < c:90)
=>
    (set-goal byz-exec-veto-goal 100)
    (set-goal byz-exec-safety-score-goal 100))

; Clear the military flags only while AD has execution authority.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
=>
    (set-goal trainpike no)
    (set-goal trainskirm no)
    (set-goal traincamel no)
    (set-goal trainhussar no)
    (set-goal trainchamp no)
    (set-goal trainunique no)
    (set-goal trainhandcannon no)
    (set-goal trainmonk no)
    (set-goal trainmangonel no)
    (set-goal trainram no)
    (set-goal traintrebuchet no)
    (set-goal trainbombard no)
    (set-goal byz-exec-training-window-goal 0))

; Retreat/hard safety has absolute precedence.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-retreat)
=>
    (set-goal byz-exec-attack-state-goal byz-exec-attack-retreat)
    (set-goal attack-status-goal retreat)
    (set-goal attack-goal 0)
    (set-goal retreat-now-goal 1)
    (enable-timer retreat-timer 8)
    (set-goal reset 1)
    (set-goal byz-exec-command-accepted-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal >= c:85)
=>
    (set-goal attack-goal 0)
    (set-goal attack-status-goal retreat)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-retreat))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-delay)
    (up-compare-goal byz-exec-veto-goal < c:85)
=>
    (set-goal attack-goal 0)
    (set-goal attack-status-goal 0)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-delay)
    (set-goal byz-exec-command-accepted-goal 100))

; Positive commands only after final safety check.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal < c:85)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-engage)
    (up-compare-goal byz-net-command-risk-goal < c:80)
=>
    (set-goal attack-goal 1)
    (set-goal attack-status-goal 0)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-press)
    (set-goal byz-exec-command-accepted-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal < c:85)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-intercept)
=>
    (set-goal attack-goal 1)
    (set-goal attack-status-goal 0)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-intercept)
    (set-goal byz-exec-command-accepted-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal < c:85)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-siege-push)
    (up-compare-goal byz-cmd-siege-safety-goal >= c:65)
=>
    (set-goal attack-goal 1)
    (set-goal attack-status-goal 0)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-convert)
    (set-goal byz-exec-command-accepted-goal 100))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-raid)
    (up-compare-goal byz-exec-veto-goal < c:85)
=>
    (set-goal attack-goal 1)
    (set-goal attack-status-goal 0)
    (set-goal byz-exec-attack-state-goal byz-exec-attack-press))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-hold)
=>
    (set-goal attack-goal 0)
    (set-goal attack-status-goal 0))

; Production training — deficits + demand, gated by Sovereign.
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-sov-production-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-prod-spears-deficit-goal >= c:2)
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:50)
