; Acknowledgment is generated by execution, not assumed by the bus.
(defrule
    (timer-triggered byz-exec-timer)
=>
    (up-modify-goal byz-exec-last-command-goal g:= byz-net-command-goal)
    (up-modify-goal byz-exec-last-plan-goal g:= byz-prod-plan-state-goal)
    (up-modify-goal byz-net-production-feedback-goal g:= byz-prod-deficit-total-goal)
    (up-modify-goal byz-net-battle-feedback-goal g:= byz-cmd-battle-value-goal)
    (set-goal byz-exec-cycle-goal 1))

(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal < c:85)
    (up-compare-goal byz-net-command-goal == c:byz-cmd-retreat)
=>
    (set-goal byz-exec-command-accepted-goal 100)
    (set-goal byz-net-ack-goal byz-net-ack-accepted)
    (set-goal byz-net-sync-goal 100)
    (set-goal byz-exec-engine-lease-goal 15))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal >= c:byz-exec-authority-active)
    (up-compare-goal byz-exec-veto-goal < c:85)
    (up-compare-goal byz-net-command-goal != c:byz-cmd-retreat)
=>
    (set-goal byz-exec-command-accepted-goal 100)
    (set-goal byz-net-ack-goal byz-net-ack-accepted)
    (set-goal byz-net-sync-goal 100)
    (set-goal byz-exec-engine-lease-goal 15))
(defrule
    (timer-triggered byz-exec-timer)
    (up-compare-goal byz-exec-authority-goal == c:byz-exec-authority-off)
=>
    (set-goal byz-exec-command-accepted-goal 0)
    (set-goal byz-net-ack-goal byz-net-ack-rejected)
    (set-goal byz-net-sync-goal 40)
    (set-goal byz-exec-engine-lease-goal 0))
