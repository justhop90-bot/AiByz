; ============================================================================
; AD BYZANTINE CAPABILITY & FORCE PLANNER
; ============================================================================
; The battlefield general.
;
; Doctrine:
;   Do not ask "Which unit counters their unit?"
;   Ask "What battlefield capabilities do I need, how much, by when, and
;   what is the cheapest durable package that gives me those capabilities?"
;
; This module translates Intelligence + Reasoning into a force blueprint.
; It does NOT assume one fixed army. It builds:
;   CORE + SECONDARY + SUPPORT + SIEGE + CONVERSION + RESERVE.
;
; The planner prefers:
;   1. efficient counters when the threat is local,
;   2. mixed capability when the threat is layered,
;   3. Cataphracts when breakthrough / mobility / anti-infantry value is high,
;   4. siege when mass/fortification/position value is high,
;   5. monks when expensive-unit preservation or relic/economic value justifies it,
;   6. gunpowder when infantry mass or high-value targets make the gold spend worthwhile,
;   7. raids/map pressure when direct engagement is inefficient.
;
; This is a planning layer; later units.per / AD production modules can execute
; its demands. We only set existing train-* goals where a strong, clear demand
; exists, avoiding a deterministic "always make X" loop.
; ============================================================================

(defconst byz-force-cycle-goal 701) ; force planning cycle
(defconst byz-force-core-goal 702) ; core army capability
(defconst byz-force-secondary-goal 703) ; secondary army capability
(defconst byz-force-support-goal 704) ; support capability
(defconst byz-force-frontline-demand-goal 705) ; frontline demand
(defconst byz-force-anti-cav-demand-goal 706) ; anti-cavalry demand
(defconst byz-force-anti-ranged-demand-goal 707) ; anti-ranged demand
(defconst byz-force-anti-infantry-demand-goal 708) ; anti-infantry demand
(defconst byz-force-mobile-demand-goal 709) ; mobility demand
(defconst byz-force-breakthrough-demand-goal 710) ; breakthrough demand
(defconst byz-force-area-demand-goal 711) ; area damage demand
(defconst byz-force-healing-demand-goal 712) ; healing demand
(defconst byz-force-siege-safe-demand-goal 713) ; siege safety demand
(defconst byz-force-conversion-demand-goal 714) ; conversion demand
(defconst byz-force-raid-demand-goal 715) ; raid demand
(defconst byz-force-map-demand-goal 716) ; map-control demand
(defconst byz-force-siege-role-goal 717) ; siege role
(defconst byz-force-siege-demand-goal 718) ; overall siege demand
(defconst byz-force-ram-demand-goal 719) ; ram demand
(defconst byz-force-mango-demand-goal 720) ; mangonel/onager demand
(defconst byz-force-treb-demand-goal 721) ; trebuchet demand
(defconst byz-force-bbc-demand-goal 722) ; bombard cannon demand
(defconst byz-force-monk-demand-goal 723) ; monk demand
(defconst byz-force-camel-demand-goal 724) ; camel demand
(defconst byz-force-spears-demand-goal 725) ; spear-line demand
(defconst byz-force-skirm-demand-goal 726) ; skirmisher demand
(defconst byz-force-archer-demand-goal 727) ; archer-line demand
(defconst byz-force-champ-demand-goal 728) ; champion demand
(defconst byz-force-cataph-demand-goal 729) ; Cataphract demand
(defconst byz-force-hussar-demand-goal 730) ; Hussar demand
(defconst byz-force-hc-demand-goal 731) ; Hand Cannoneer demand
(defconst byz-force-siege-protect-score-goal 732) ; ability to protect siege
(defconst byz-force-current-cap-score-goal 733) ; current capability coverage
(defconst byz-force-gap-score-goal 734) ; overall force gap
(defconst byz-force-resource-fit-goal 735) ; resource fit
(defconst byz-force-production-fit-goal 736) ; production fit
(defconst byz-force-overkill-goal 737) ; overkill risk
(defconst byz-force-flexibility-goal 738) ; composition flexibility

; ------------------------- CYCLE VALUES --------------------------------
(defconst byz-force-observe 0)
(defconst byz-force-assemble 1)
(defconst byz-force-balance 2)
(defconst byz-force-execute 3)

; ------------------------- INITIALIZATION ------------------------------
(defrule
    (true)
=>
    (set-goal byz-force-cycle-goal byz-force-observe)
    (set-goal byz-force-core-goal byz-cap-none)
    (set-goal byz-force-secondary-goal byz-cap-none)
    (set-goal byz-force-support-goal byz-cap-none)
    (set-goal byz-force-frontline-demand-goal 0)
    (set-goal byz-force-anti-cav-demand-goal 0)
    (set-goal byz-force-anti-ranged-demand-goal 0)
    (set-goal byz-force-anti-infantry-demand-goal 0)
    (set-goal byz-force-mobile-demand-goal 0)
    (set-goal byz-force-breakthrough-demand-goal 0)
    (set-goal byz-force-area-demand-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-force-healing-demand-goal 0)
    (set-goal byz-force-siege-safe-demand-goal 0)
    (set-goal byz-force-conversion-demand-goal 0)
    (set-goal byz-force-raid-demand-goal 0)
    (set-goal byz-force-map-demand-goal 0)
    (set-goal byz-force-siege-role-goal byz-siege-none)
    (set-goal byz-force-siege-demand-goal 0)
    (set-goal byz-force-ram-demand-goal 0)
    (set-goal byz-force-mango-demand-goal 0)
    (set-goal byz-force-treb-demand-goal 0)
    (set-goal byz-force-bbc-demand-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-force-monk-demand-goal 0)
    (set-goal byz-force-camel-demand-goal 0)
    (set-goal byz-force-spears-demand-goal 0)
    (set-goal byz-force-skirm-demand-goal 0)
    (set-goal byz-force-archer-demand-goal 0)
    (set-goal byz-force-champ-demand-goal 0)
    (set-goal byz-force-cataph-demand-goal 0)
    (set-goal byz-force-hussar-demand-goal 0)
    (set-goal byz-force-hc-demand-goal 0)
    (set-goal byz-force-siege-protect-score-goal 0)
    (set-goal byz-force-current-cap-score-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-force-gap-score-goal 0)
    (set-goal byz-force-resource-fit-goal 50)
    (set-goal byz-force-production-fit-goal 50)
    (set-goal byz-force-overkill-goal 0)
    (set-goal byz-force-flexibility-goal 50)
    (disable-self))

; ------------------------- START WITH NO DEMAND ------------------------
; This is crucial: stale demands must not survive a strategic transition.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-frontline-demand-goal 0)
    (set-goal byz-force-anti-cav-demand-goal 0)
    (set-goal byz-force-anti-ranged-demand-goal 0)
    (set-goal byz-force-anti-infantry-demand-goal 0)
    (set-goal byz-force-mobile-demand-goal 0)
    (set-goal byz-force-breakthrough-demand-goal 0)
    (set-goal byz-force-area-demand-goal 0)
    (set-goal byz-force-healing-demand-goal 0)
    (set-goal byz-force-siege-safe-demand-goal 0)
    (set-goal byz-force-conversion-demand-goal 0)
    (set-goal byz-force-raid-demand-goal 0)
    )
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-map-demand-goal 0)
    (set-goal byz-force-siege-demand-goal 0)
    (set-goal byz-force-ram-demand-goal 0)
    (set-goal byz-force-mango-demand-goal 0)
    (set-goal byz-force-treb-demand-goal 0)
    (set-goal byz-force-bbc-demand-goal 0)
    (set-goal byz-force-monk-demand-goal 0)
    (set-goal byz-force-camel-demand-goal 0)
    (set-goal byz-force-spears-demand-goal 0)
    (set-goal byz-force-skirm-demand-goal 0)
    (set-goal byz-force-archer-demand-goal 0)
    )
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-champ-demand-goal 0)
    (set-goal byz-force-cataph-demand-goal 0)
    (set-goal byz-force-hussar-demand-goal 0)
    (set-goal byz-force-hc-demand-goal 0)
    (set-goal byz-force-cycle-goal byz-force-assemble)
    )

; =========================================================================
; GENERAL: TURN INTELLIGENCE INTO CAPABILITY DEMAND
; =========================================================================

; Cavalry pressure -> anti-cavalry + frontline, but never anti-cav alone.
(defrule
    (up-compare-goal byz-cavalry-pressure-goal >= c:60)
=>
    (set-goal byz-force-anti-cav-demand-goal 75)
    (set-goal byz-force-frontline-demand-goal 45)
    (set-goal byz-force-core-goal byz-cap-anti-cavalry))

(defrule
    (up-compare-goal byz-cavalry-pressure-goal >= c:80)
=>
    (set-goal byz-force-anti-cav-demand-goal 90)
    (set-goal byz-force-mobile-demand-goal 35)
    (set-goal byz-force-secondary-goal byz-cap-mobile-response))

; Ranged pressure -> anti-ranged plus area damage once massed.
(defrule
    (up-compare-goal byz-ranged-pressure-goal >= c:50)
=>
    (set-goal byz-force-anti-ranged-demand-goal 70)
    (set-goal byz-force-frontline-demand-goal 35)
    (set-goal byz-force-core-goal byz-cap-anti-ranged))

(defrule
    (up-compare-goal byz-ranged-pressure-goal >= c:75)
=>
    (set-goal byz-force-area-demand-goal 65)
    (set-goal byz-force-secondary-goal byz-cap-area-damage))

; Infantry pressure -> ranged/gunpowder/siege options.
(defrule
    (up-compare-goal byz-infantry-pressure-goal >= c:50)
=>
    (set-goal byz-force-anti-infantry-demand-goal 70)
    (set-goal byz-force-secondary-goal byz-cap-anti-infantry))

(defrule
    (up-compare-goal byz-infantry-pressure-goal >= c:75)
=>
    (set-goal byz-force-breakthrough-demand-goal 60)
    (set-goal byz-force-area-demand-goal 40)
    (set-goal byz-force-hc-demand-goal 60))

; Mobility pressure -> intercept instead of static overinvestment.
(defrule
    (up-compare-goal byz-enemy-map-freedom-goal >= c:60)
    (up-compare-goal byz-intel-mobile-belief-goal >= c:60)
=>
    (set-goal byz-force-mobile-demand-goal 75)
    (set-goal byz-force-raid-demand-goal 55)
    (set-goal byz-force-secondary-goal byz-cap-mobile-response))

; Siege pressure -> counter-siege + protection, not an automatic mass attack.
(defrule
    (up-compare-goal byz-siege-pressure-goal >= c:40)
=>
    (set-goal byz-force-siege-safe-demand-goal 85)
    (set-goal byz-force-secondary-goal byz-cap-anti-siege))

(defrule
    (up-compare-goal byz-siege-pressure-goal >= c:65)
=>
    (set-goal byz-force-conversion-demand-goal 60)
    (set-goal byz-force-siege-demand-goal 40)
    (set-goal byz-force-siege-role-goal byz-siege-anti-siege))

; =========================================================================
; STRATEGIC MODES
; =========================================================================

; STABILIZE: survival and cheap coverage.
(defrule
    (goal byz-state-goal byz-state-stabilize)
=>
    (set-goal byz-force-frontline-demand-goal 60)
    (set-goal byz-force-flexibility-goal 80))

; CONSTRAIN: cover counters while denying enemy strategic freedom.
(defrule
    (goal byz-state-goal byz-state-constrain)
=>
    (set-goal byz-force-map-demand-goal 65)
    (set-goal byz-force-mobile-demand-goal 55))

; EXPLOIT: invest in mobility, breakthrough, and reinforcement interception.
(defrule
    (goal byz-state-goal byz-state-exploit)
=>
    (set-goal byz-force-mobile-demand-goal 75)
    (set-goal byz-force-breakthrough-demand-goal 65)
    (set-goal byz-force-raid-demand-goal 70)
    (set-goal byz-force-map-demand-goal 70))

; CONVERT: siege/army damage becomes more important than raw counter density.
(defrule
    (goal byz-state-goal byz-state-convert)
=>
    (set-goal byz-force-conversion-demand-goal 90)
    (set-goal byz-force-siege-demand-goal 70)
    (set-goal byz-force-siege-safe-demand-goal 80)
    (set-goal byz-force-breakthrough-demand-goal 70))

; DENY RECOVERY: favor structural damage over chasing units.
(defrule
    (goal byz-state-goal byz-state-deny-recovery)
=>
    (set-goal byz-force-conversion-demand-goal 95)
    (set-goal byz-force-siege-demand-goal 85)
    (set-goal byz-force-map-demand-goal 75)
    (set-goal byz-force-production-fit-goal 80))

; =========================================================================
; CAPABILITY -> SPECIFIC FORCE
; =========================================================================

; ------------------------- ANTI-CAVALRY -------------------------------
; Cheap spear-line first, then Camels when mobility/value justifies it.
(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:60)
    (strategic-number spears < 18)
=>
    (set-goal byz-force-spears-demand-goal 18))

(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:80)
    (strategic-number cavalry >= 10)
    (strategic-number spears < 30)
=>
    (set-goal byz-force-spears-demand-goal 30))

(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:70)
    (strategic-number cavalry >= 15)
=>
    (set-goal byz-force-camel-demand-goal 12))

; Cataphracts are NOT treated as anti-cav spam; they are reserved for
; breakthrough / anti-infantry / mobility value.
(defrule
    (up-compare-goal byz-force-breakthrough-demand-goal >= c:70)
    (up-compare-goal byz-force-anti-infantry-demand-goal >= c:50)
    (unit-available cataphract-line)
=>
    (set-goal byz-force-cataph-demand-goal 8))

; ------------------------- ANTI-RANGED --------------------------------
; Skirms are the default efficiency answer; Cataphracts/mobility/siege are
; secondary answers when the opponent's ranged mass is too large.
(defrule
    (up-compare-goal byz-force-anti-ranged-demand-goal >= c:50)
    (strategic-number archers >= 5)
    (strategic-number skirms < 15)
=>
    (set-goal byz-force-skirm-demand-goal 15))

(defrule
    (up-compare-goal byz-force-anti-ranged-demand-goal >= c:75)
    (strategic-number archers >= 15)
    (strategic-number skirms < 30)
=>
    (set-goal byz-force-skirm-demand-goal 30)
    (set-goal byz-force-area-demand-goal 55))

; ------------------------- ANTI-INFANTRY ------------------------------
(defrule
    (up-compare-goal byz-force-anti-infantry-demand-goal >= c:55)
    (strategic-number infantry >= 10)
    (unit-available hand-cannoneer)
=>
    (set-goal byz-force-hc-demand-goal 10))

(defrule
    (up-compare-goal byz-force-anti-infantry-demand-goal >= c:70)
    (strategic-number infantry >= 20)
=>
    (set-goal byz-force-hc-demand-goal 18))

(defrule
    (up-compare-goal byz-force-anti-infantry-demand-goal >= c:65)
    (unit-available cataphract-line)
=>
    (set-goal byz-force-cataph-demand-goal 10))

; ------------------------- FRONTLINE ----------------------------------
; Champions become a mass frontline option when gold pressure is low;
; Halberdiers remain an efficient emergency screen.
(defrule
    (up-compare-goal byz-force-frontline-demand-goal >= c:55)
    (strategic-number infantry < 15)
=>
    (set-goal byz-force-champ-demand-goal 12))

(defrule
    (up-compare-goal byz-force-frontline-demand-goal >= c:75)
    (strategic-number infantry < 25)
=>
    (set-goal byz-force-champ-demand-goal 20))

; ------------------------- MOBILITY -----------------------------------
(defrule
    (up-compare-goal byz-force-mobile-demand-goal >= c:60)
    (strategic-number cavalry < 12)
=>
    (set-goal byz-force-hussar-demand-goal 12))

(defrule
    (up-compare-goal byz-force-raid-demand-goal >= c:65)
    (strategic-number cavalry < 18)
=>
    (set-goal byz-force-hussar-demand-goal 18))

; ------------------------- MONKS --------------------------------------
; Monks are a support capability: preserve expensive units, convert high-value
; targets, contest relic economy. They are never a default bulk army.
(defrule
    (up-compare-goal byz-force-healing-demand-goal >= c:55)
    (strategic-number moenche < 4)
=>
    (set-goal byz-force-monk-demand-goal 4))

(defrule
    (up-compare-goal byz-force-healing-demand-goal >= c:75)
    (strategic-number moenche < 8)
=>
    (set-goal byz-force-monk-demand-goal 8))

; =========================================================================
; SIEGE DOCTRINE
; =========================================================================

; Area damage: anti-mass siege.
(defrule
    (up-compare-goal byz-force-area-demand-goal >= c:60)
    (up-compare-goal byz-force-siege-demand-goal < c:80)
=>
    (set-goal byz-force-siege-demand-goal 55)
    (set-goal byz-force-siege-role-goal byz-siege-anti-mass)
    (set-goal byz-force-mango-demand-goal 4))

; Buildings/Castles: rams + trebuchets, chosen by age/context.
(defrule
    (up-compare-goal byz-force-conversion-demand-goal >= c:60)
    (up-compare-goal byz-force-siege-demand-goal >= c:50)
=>
    (set-goal byz-force-ram-demand-goal 2)
    (set-goal byz-force-treb-demand-goal 2)
    (set-goal byz-force-siege-role-goal byz-siege-anti-building))

(defrule
    (up-compare-goal byz-force-conversion-demand-goal >= c:80)
    (goal enemy-fortifications-goal yes)
=>
    (set-goal byz-force-treb-demand-goal 3)
    (set-goal byz-force-siege-role-goal byz-siege-anti-castle))

; Counter-siege: Bombard Cannon if available, otherwise mangonel/anti-siege
; logic in units.per can satisfy the need.
(defrule
    (up-compare-goal byz-force-siege-safe-demand-goal >= c:70)
    (unit-available bombard-cannon)
=>
    (set-goal byz-force-bbc-demand-goal 3)
    (set-goal byz-force-siege-role-goal byz-siege-anti-siege))

; =========================================================================
; FLEXIBILITY / OVERKILL CONTROL
; =========================================================================

; If one threat is overwhelmingly dominant, keep the secondary component small
; rather than wasting resources on a universal counter mesh.
(defrule
    (up-compare-goal byz-threat-score-goal >= c:75)
    (up-compare-goal byz-intel-threat-diversity-goal < c:40)
=>
    (set-goal byz-force-flexibility-goal 35))

; If enemy composition is diverse, a single counter is not sufficient.
(defrule
    (up-compare-goal byz-intel-threat-diversity-goal >= c:70)
=>
    (set-goal byz-force-flexibility-goal 85)
    (set-goal byz-force-secondary-goal byz-cap-frontline))

; Cost/commitment control: don't ask for a giant army when resources are unsafe.
(defrule
    (up-compare-goal byz-eco-security-goal <= c:35)
=>
    (set-goal byz-force-overkill-goal 80)
    (set-goal byz-force-flexibility-goal 85))

; If the enemy is weak and recovery is collapsing, overkill risk can be accepted.
(defrule
    (up-compare-goal byz-win-pressure-goal >= c:75)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:30)
=>
    (set-goal byz-force-overkill-goal 20)
    (set-goal byz-force-conversion-demand-goal 90))

; =========================================================================
; EXECUTION CONTRACT
; =========================================================================
; V4: Force Planner is planning-only. It never writes train-* flags.
; ExecutionBridge owns military training authority.

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-current-cap-score-goal 50))
(defrule
    (strategic-number spears >= 18)
=>
    (up-modify-goal byz-force-current-cap-score-goal c:+ 10))
(defrule
    (strategic-number skirms >= 15)
=>
    (up-modify-goal byz-force-current-cap-score-goal c:+ 10))
(defrule
    (strategic-number cavalry >= 12)
=>
    (up-modify-goal byz-force-current-cap-score-goal c:+ 10))
(defrule
    (strategic-number infantry >= 12)
=>
    (up-modify-goal byz-force-current-cap-score-goal c:+ 10))
(defrule
    (up-compare-goal byz-force-current-cap-score-goal >= c:90)
=>
    (set-goal byz-force-current-cap-score-goal 90))
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-gap-score-goal 50))
(defrule
    (up-compare-goal byz-force-current-cap-score-goal <= c:40)
=>
    (set-goal byz-force-gap-score-goal 85))
(defrule
    (up-compare-goal byz-force-current-cap-score-goal >= c:70)
=>
    (set-goal byz-force-gap-score-goal 30))

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-desired-spears-goal byz-force-spears-demand-goal)
    (set-goal byz-desired-skirmishers-goal byz-force-skirm-demand-goal)
    (set-goal byz-desired-camels-goal byz-force-camel-demand-goal)
    (set-goal byz-desired-cataphracts-goal byz-force-cataph-demand-goal)
    (set-goal byz-desired-siege-goal byz-force-siege-demand-goal))
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-force-cycle-goal byz-force-observe))

; ============================================================================
; END OF AD BYZANTINE CAPABILITY & FORCE PLANNER
; ============================================================================
