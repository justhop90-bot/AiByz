(defconst byz-intel-raw-observation-goal 691)
(defconst byz-intel-scout-request-goal 692)
(defconst byz-intel-observation-integrity-goal 693)

(defrule
    (true)
=>
    (set-goal byz-intel-cycle-goal byz-intel-observe)
