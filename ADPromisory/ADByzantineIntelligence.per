=>
    (set-goal byz-threat-score-goal 85)
    (set-goal byz-threat-class-goal byz-threat-critical))
(defrule
    (up-compare-goal byz-intel-signal-mass-goal <= c:6)
    (up-compare-goal byz-intel-threat-diversity-goal < c:60)
=>
    (set-goal byz-threat-score-goal 25))
(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:70)
=>
    (set-goal byz-threat-confidence-goal 45)
    (set-goal byz-intel-observation-integrity-goal 70))
(defrule
    (up-compare-goal byz-intel-ambiguity-goal <= c:30)
    (up-compare-goal byz-intel-freshness-goal >= c:70)
=>
    (set-goal byz-threat-confidence-goal 80)
    (set-goal byz-intel-observation-integrity-goal 95))
(defrule
    (up-compare-goal byz-intel-last-seen-age-goal >= c:90)
=>
    (set-goal byz-threat-confidence-goal 25)
    (set-goal byz-threat-score-goal 40)
    (set-goal byz-intel-observation-integrity-goal 35))

; Diversity / hypotheses.
(defrule
    (up-compare-goal byz-intel-cavalry-belief-goal >= c:60)
    (up-compare-goal byz-intel-ranged-belief-goal >= c:60)
    (up-compare-goal byz-intel-infantry-belief-goal >= c:40)
=>
    (set-goal byz-intel-threat-diversity-goal 80)
    (set-goal byz-intel-hypothesis-a-goal byz-army-mixed))
(defrule
    (up-compare-goal byz-intel-cavalry-belief-goal < c:60)
    (up-compare-goal byz-intel-ranged-belief-goal < c:60)
    (up-compare-goal byz-intel-infantry-belief-goal < c:60)
=>
    (set-goal byz-intel-threat-diversity-goal 25))
(defrule (up-compare-goal byz-intel-cavalry-belief-goal >= c:70) => (set-goal byz-intel-hypothesis-a-goal byz-army-cavalry))
(defrule (up-compare-goal byz-intel-ranged-belief-goal >= c:70) => (set-goal byz-intel-hypothesis-a-goal byz-army-ranged))
(defrule (up-compare-goal byz-intel-infantry-belief-goal >= c:70) => (set-goal byz-intel-hypothesis-a-goal byz-army-infantry))
(defrule (up-compare-goal byz-intel-siege-belief-goal >= c:60) => (set-goal byz-intel-hypothesis-b-goal byz-army-siege))

; Pivot prediction.
(defrule
    (up-compare-goal byz-intel-cavalry-belief-goal >= c:70)
    (up-compare-goal byz-intel-signal-production-goal >= c:3)
=>
    (set-goal byz-intel-transition-candidate-goal byz-army-ranged)
    (set-goal byz-intel-transition-confidence-goal 55))
(defrule
    (up-compare-goal byz-intel-ranged-belief-goal >= c:70)
    (up-compare-goal byz-intel-signal-siege-goal >= c:3)
=>
    (set-goal byz-intel-transition-candidate-goal byz-army-siege)
