    (set-goal byz-intel-alert-goal byz-threat-none))

; Capture existing weighted Promisory signals.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-intel-signal-cavalry-goal s:= cavalry)
    (up-modify-goal byz-intel-signal-ranged-goal s:= archers)
    (up-modify-goal byz-intel-signal-infantry-goal s:= infantry)
    (up-modify-goal byz-intel-signal-cavarcher-goal s:= cavarchers)
    (up-modify-goal byz-intel-signal-gunpowder-goal s:= gunpowder)
    (up-modify-goal byz-intel-signal-siege-goal s:= siege)
    (up-modify-goal byz-intel-signal-monk-goal s:= moenche)
    (up-modify-goal byz-intel-signal-mass-goal s:= target-mpop)
    (set-goal byz-intel-raw-observation-goal 1))
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-intel-signal-production-goal 0)
    (up-get-focus-fact building-type-count barracks temporary-goal)
    (up-modify-goal byz-intel-signal-production-goal g:+ temporary-goal)
    (up-get-focus-fact building-type-count stable temporary-goal)
    (up-modify-goal byz-intel-signal-production-goal g:+ temporary-goal)
    (up-get-focus-fact building-type-count archery-range temporary-goal)
    (up-modify-goal byz-intel-signal-production-goal g:+ temporary-goal)
    (up-get-focus-fact building-type-count siege-workshop temporary-goal)
    (up-modify-goal byz-intel-signal-production-goal g:+ temporary-goal))
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-intel-signal-fortification-goal 0)
    (up-get-focus-fact building-type-count castle temporary-goal)
    (up-modify-goal byz-intel-signal-fortification-goal g:+ temporary-goal)
    (up-get-focus-fact building-type-count town-center temporary-goal)
    (up-modify-goal byz-intel-signal-fortification-goal g:+ temporary-goal))

; Observation age is reset only by meaningful military evidence.
(defrule
    (timer-triggered fifteensec)
    (up-compare-goal byz-intel-signal-mass-goal > c:0)
=>
    (set-goal byz-intel-last-seen-age-goal 0)
    (set-goal byz-intel-freshness-goal 100))
(defrule
    (timer-triggered fifteensec)
    (up-compare-goal byz-intel-signal-mass-goal <= c:0)
=>
    (up-modify-goal byz-intel-last-seen-age-goal c:+ 15)
    (up-modify-goal byz-intel-freshness-goal c:- 15))

; Smoothed beliefs are bands, not brittle one-shot unit orders.
(defrule (up-compare-goal byz-intel-signal-cavalry-goal >= c:5) => (set-goal byz-intel-cavalry-belief-goal 25))
(defrule (up-compare-goal byz-intel-signal-cavalry-goal >= c:10) => (set-goal byz-intel-cavalry-belief-goal 45))
(defrule (up-compare-goal byz-intel-signal-cavalry-goal >= c:20) => (set-goal byz-intel-cavalry-belief-goal 70))
(defrule (up-compare-goal byz-intel-signal-cavalry-goal >= c:35) => (set-goal byz-intel-cavalry-belief-goal 90))
(defrule (up-compare-goal byz-intel-signal-ranged-goal >= c:5) => (set-goal byz-intel-ranged-belief-goal 25))
(defrule (up-compare-goal byz-intel-signal-ranged-goal >= c:10) => (set-goal byz-intel-ranged-belief-goal 45))
(defrule (up-compare-goal byz-intel-signal-ranged-goal >= c:20) => (set-goal byz-intel-ranged-belief-goal 70))
(defrule (up-compare-goal byz-intel-signal-ranged-goal >= c:35) => (set-goal byz-intel-ranged-belief-goal 90))
(defrule (up-compare-goal byz-intel-signal-infantry-goal >= c:5) => (set-goal byz-intel-infantry-belief-goal 25))
(defrule (up-compare-goal byz-intel-signal-infantry-goal >= c:10) => (set-goal byz-intel-infantry-belief-goal 45))
(defrule (up-compare-goal byz-intel-signal-infantry-goal >= c:20) => (set-goal byz-intel-infantry-belief-goal 70))
(defrule (up-compare-goal byz-intel-signal-infantry-goal >= c:35) => (set-goal byz-intel-infantry-belief-goal 90))
(defrule (up-compare-goal byz-intel-signal-cavarcher-goal >= c:8) => (set-goal byz-intel-mobile-belief-goal 40))
(defrule (up-compare-goal byz-intel-signal-cavarcher-goal >= c:16) => (set-goal byz-intel-mobile-belief-goal 70))
(defrule (up-compare-goal byz-intel-signal-cavarcher-goal >= c:25) => (set-goal byz-intel-mobile-belief-goal 90))
(defrule (up-compare-goal byz-intel-signal-siege-goal >= c:3) => (set-goal byz-intel-siege-belief-goal 30))
(defrule (up-compare-goal byz-intel-signal-siege-goal >= c:8) => (set-goal byz-intel-siege-belief-goal 60))
(defrule (up-compare-goal byz-intel-signal-siege-goal >= c:15) => (set-goal byz-intel-siege-belief-goal 85))
(defrule (up-compare-goal byz-intel-signal-gunpowder-goal >= c:3) => (set-goal byz-intel-gunpowder-belief-goal 30))
(defrule (up-compare-goal byz-intel-signal-gunpowder-goal >= c:8) => (set-goal byz-intel-gunpowder-belief-goal 60))
(defrule (up-compare-goal byz-intel-signal-gunpowder-goal >= c:15) => (set-goal byz-intel-gunpowder-belief-goal 85))

; Derived threat pressure truth.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-threat-score-goal 25)
    (set-goal byz-threat-confidence-goal 55)
    (up-modify-goal byz-cavalry-score-goal g:= byz-intel-cavalry-belief-goal)
    (up-modify-goal byz-ranged-score-goal g:= byz-intel-ranged-belief-goal)
    (up-modify-goal byz-infantry-score-goal g:= byz-intel-infantry-belief-goal)
    (up-modify-goal byz-siege-score-goal g:= byz-intel-siege-belief-goal)
    (up-modify-goal byz-monk-score-goal g:= byz-intel-signal-monk-goal))
(defrule
    (up-compare-goal byz-intel-cavalry-belief-goal >= c:70)
=>
    (set-goal byz-threat-score-goal 70)
    (set-goal byz-threat-class-goal byz-threat-high)
    (set-goal byz-threat-domain-goal byz-threat-ground))
(defrule
    (up-compare-goal byz-intel-ranged-belief-goal >= c:70)
=>
    (set-goal byz-threat-score-goal 70)
    (set-goal byz-threat-class-goal byz-threat-high)
    (set-goal byz-threat-domain-goal byz-threat-ground))
(defrule
    (up-compare-goal byz-intel-infantry-belief-goal >= c:70)
=>
    (set-goal byz-threat-score-goal 70)
    (set-goal byz-threat-class-goal byz-threat-high)
    (set-goal byz-threat-domain-goal byz-threat-ground))
