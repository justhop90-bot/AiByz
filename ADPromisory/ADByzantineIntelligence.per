(defrule
    (up-compare-goal byz-intel-threat-diversity-goal >= c:70)
=>
    (set-goal byz-intel-transition-confidence-goal 60)
    (set-goal byz-intel-ambiguity-goal 75))
(defrule
    (up-compare-goal byz-intel-transition-confidence-goal >= c:60)
=>
    (set-goal byz-enemy-transition-goal 70)
    (set-goal byz-transition-stage-goal byz-transition-suspected))

; Enemy strategic memory exports.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-enemy-mass-goal 25)
    (set-goal byz-enemy-quality-goal 50)
    (set-goal byz-enemy-reinforcement-speed-goal 50)
    (set-goal byz-enemy-war-sustainability-goal 60)
    (set-goal byz-enemy-map-freedom-goal 50))
(defrule (up-compare-goal byz-intel-signal-mass-goal >= c:20) => (set-goal byz-enemy-mass-goal 80))
(defrule (up-compare-goal byz-intel-signal-mass-goal >= c:35) => (set-goal byz-enemy-mass-goal 95))
(defrule (up-compare-goal byz-intel-threat-diversity-goal >= c:70) => (set-goal byz-enemy-quality-goal 75))
(defrule (up-compare-goal byz-intel-signal-production-goal >= c:6) => (set-goal byz-enemy-war-sustainability-goal 80))
(defrule (up-compare-goal byz-intel-signal-production-goal <= c:2) => (set-goal byz-enemy-war-sustainability-goal 35))
(defrule (up-compare-goal byz-intel-signal-fortification-goal >= c:3) => (set-goal byz-enemy-map-freedom-goal 40))
(defrule (up-compare-goal byz-intel-signal-fortification-goal <= c:1) => (set-goal byz-enemy-map-freedom-goal 70))
(defrule (up-compare-goal byz-intel-mobile-belief-goal >= c:70) => (set-goal byz-enemy-reinforcement-speed-goal 75))
(defrule (up-compare-goal byz-enemy-war-sustainability-goal <= c:35) => (set-goal byz-enemy-recovery-capacity-goal 30))
(defrule (up-compare-goal byz-enemy-war-sustainability-goal >= c:75) => (set-goal byz-enemy-recovery-capacity-goal 75))

; Own map / initiative are bounded interpretations of visibility and enemy freedom.
(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-map-control-goal 50)
    (set-goal byz-initiative-goal 50)
    (up-modify-goal byz-cavalry-pressure-goal g:= byz-intel-cavalry-belief-goal)
    (up-modify-goal byz-ranged-pressure-goal g:= byz-intel-ranged-belief-goal)
    (up-modify-goal byz-infantry-pressure-goal g:= byz-intel-infantry-belief-goal)
    (up-modify-goal byz-siege-pressure-goal g:= byz-intel-siege-belief-goal))
(defrule (up-compare-goal byz-enemy-map-freedom-goal <= c:40) => (set-goal byz-map-control-goal 75))
(defrule (up-compare-goal byz-enemy-map-freedom-goal >= c:70) => (set-goal byz-map-control-goal 30))
(defrule (up-compare-goal byz-intel-mobile-belief-goal >= c:60) => (set-goal byz-initiative-goal 65))
(defrule (up-compare-goal byz-intel-overextension-goal >= c:70) => (set-goal byz-initiative-goal 75))

; Information valuation. These are requests, not scout execution.
(defrule
    (up-compare-goal byz-intel-ambiguity-goal >= c:60)
=>
    (set-goal byz-intel-observe-priority-goal byz-cap-scouting)
    (set-goal byz-intel-scout-value-goal 85)
    (set-goal byz-intel-fog-risk-goal 80)
    (set-goal byz-intel-scout-request-goal 90))
(defrule
    (up-compare-goal byz-intel-last-seen-age-goal >= c:45)
=>
    (set-goal byz-intel-scout-value-goal 90)
    (set-goal byz-intel-scout-request-goal 95))

; Alert/deadline.
(defrule
    (up-compare-goal byz-intel-signal-cavalry-goal >= c:20)
    (up-compare-goal byz-intel-last-seen-age-goal <= c:30)
=>
    (set-goal byz-intel-deadline-class-goal byz-deadline-immediate)
    (set-goal byz-intel-alert-goal byz-threat-high))
(defrule
    (up-compare-goal byz-intel-signal-siege-goal >= c:8)
=>
    (set-goal byz-intel-deadline-class-goal byz-deadline-tight)
    (set-goal byz-intel-alert-goal byz-threat-high))
(defrule
    (up-compare-goal byz-threat-score-goal >= c:85)
=>
    (set-goal byz-intel-alert-goal byz-threat-critical))

; Confidence/stability output is intelligence-owned truth.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-enemy-transition-pressure-goal g:= byz-intel-transition-confidence-goal)
    (up-modify-goal byz-enemy-production-depth-goal g:= byz-intel-signal-production-goal)
    (up-modify-goal byz-rx-hypothesis-goal g:= byz-intel-hypothesis-a-goal)
    (up-modify-goal byz-intel-previous-threat-score-goal g:= byz-intel-model-snapshot-goal)
    (up-modify-goal byz-intel-model-snapshot-goal g:= byz-threat-score-goal)
    (set-goal byz-intel-decision-confidence-goal 55))
(defrule
    (up-compare-goal byz-intel-previous-threat-score-goal g:== byz-threat-score-goal)
    (up-compare-goal byz-intel-freshness-goal >= c:70)
=>
    (set-goal byz-intel-model-stability-goal 80)
    (set-goal byz-intel-decision-confidence-goal 80))
(defrule
    (up-compare-goal byz-intel-previous-threat-score-goal g:!= byz-threat-score-goal)
=>
    (set-goal byz-intel-model-stability-goal 35)
    (set-goal byz-intel-decision-confidence-goal 45))
(defrule
    (up-compare-goal byz-intel-last-seen-age-goal >= c:90)
=>
    (set-goal byz-intel-model-stability-goal 20)
    (set-goal byz-intel-decision-confidence-goal 25))

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-intel-cycle-goal byz-intel-observe)
    (set-goal byz-intel-freshness-goal 100))
