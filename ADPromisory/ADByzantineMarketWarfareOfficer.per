; ============================================================================
; AD BYZANTINE MARKET WARFARE OFFICER
; ============================================================================
; Specialist subordinate to the Economic War Director. The Market is treated
; as a strategic time/liquidity weapon and a dangerous double-edged blade.
;
; BUY  = purchase immediate resources/time at a market premium.
; SELL = monetize true surplus, but sacrifice future optionality.
; MANIPULATE = intentionally move shared price state only with a defined enemy
;              dependency, sufficient reserves, and positive strategic value.
;
; Safety: Quartermaster/economic approval, reserve floor, emergency veto,
; anti-thrashing lock, price guard, and post-action feedback.
; Uses only commands verified in trade.per.
; ============================================================================
(defconst byz-mkt-cycle-goal 1399) ; market state
(defconst byz-mkt-mode-goal 1400) ; market state
(defconst byz-mkt-commodity-goal 1401) ; market state
(defconst byz-mkt-action-goal 1402) ; market state
(defconst byz-mkt-approval-goal 1403) ; market state
(defconst byz-mkt-safety-goal 1404) ; market state
(defconst byz-mkt-confidence-goal 1405) ; market state
(defconst byz-mkt-risk-goal 1406) ; market state
(defconst byz-mkt-benefit-goal 1407) ; market state
(defconst byz-mkt-net-value-goal 1408) ; market state
(defconst byz-mkt-time-value-goal 1409) ; market state
(defconst byz-mkt-liquidity-value-goal 1410) ; market state
(defconst byz-mkt-price-value-goal 1411) ; market state
(defconst byz-mkt-denial-value-goal 1412) ; market state
(defconst byz-mkt-manipulation-value-goal 1413) ; market state
(defconst byz-mkt-opportunity-cost-goal 1414) ; market state
(defconst byz-mkt-reserve-floor-goal 1415) ; market state
(defconst byz-mkt-food-price-goal 1416) ; market state
(defconst byz-mkt-wood-price-goal 1417) ; market state
(defconst byz-mkt-stone-price-goal 1418) ; market state
(defconst byz-mkt-food-sell-price-goal 1419) ; market state
(defconst byz-mkt-wood-sell-price-goal 1420) ; market state
(defconst byz-mkt-stone-sell-price-goal 1421) ; market state
(defconst byz-mkt-food-pressure-goal 1422) ; market state
(defconst byz-mkt-wood-pressure-goal 1423) ; market state
(defconst byz-mkt-stone-pressure-goal 1424) ; market state
(defconst byz-mkt-transaction-lock-goal 1425) ; market state
(defconst byz-mkt-catastrophe-veto-goal 1426) ; market state
(defconst byz-mkt-last-action-goal 1427) ; market state
(defconst byz-mkt-last-commodity-goal 1428) ; market state
(defconst byz-mkt-last-time-goal 1429) ; market state
(defconst byz-mkt-approval-count-goal 1430) ; market state
(defconst byz-mkt-rejection-count-goal 1431) ; market state
(defconst byz-mkt-stability-goal 1432) ; market state
(defconst ad-market-idle 0)
(defconst ad-market-buy 1)
(defconst ad-market-sell 2)
(defconst ad-market-manipulate-buy 3)
(defconst ad-market-liquidity 4)
(defconst ad-market-time-purchase 5)
(defconst ad-market-emergency 6)
(defconst ad-market-none 0)
(defconst ad-market-food 1)
(defconst ad-market-wood 2)
(defconst ad-market-stone 3)


(defrule
    (true)
=>
    (set-goal byz-mkt-cycle-goal 0)
    (set-goal byz-mkt-mode-goal ad-market-idle)
    (set-goal byz-mkt-commodity-goal ad-market-none)
    (set-goal byz-mkt-action-goal ad-market-idle)
    (set-goal byz-mkt-approval-goal ad-eco-no-market)
    (set-goal byz-mkt-safety-goal 100)
    (set-goal byz-mkt-confidence-goal 0)
    (set-goal byz-mkt-risk-goal 0)
    (set-goal byz-mkt-benefit-goal 0)
    (set-goal byz-mkt-net-value-goal 0)
    (set-goal byz-mkt-time-value-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-mkt-liquidity-value-goal 0)
    (set-goal byz-mkt-price-value-goal 0)
    (set-goal byz-mkt-denial-value-goal 0)
    (set-goal byz-mkt-manipulation-value-goal 0)
    (set-goal byz-mkt-opportunity-cost-goal 0)
    (set-goal byz-mkt-reserve-floor-goal 0)
    (set-goal byz-mkt-food-price-goal 0)
    (set-goal byz-mkt-wood-price-goal 0)
    (set-goal byz-mkt-stone-price-goal 0)
    (set-goal byz-mkt-food-sell-price-goal 0)
    (set-goal byz-mkt-wood-sell-price-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-mkt-stone-sell-price-goal 0)
    (set-goal byz-mkt-food-pressure-goal 0)
    (set-goal byz-mkt-wood-pressure-goal 0)
    (set-goal byz-mkt-stone-pressure-goal 0)
    (set-goal byz-mkt-transaction-lock-goal 0)
    (set-goal byz-mkt-catastrophe-veto-goal 0)
    (set-goal byz-mkt-last-action-goal ad-market-idle)
    (set-goal byz-mkt-last-commodity-goal ad-market-none)
    (set-goal byz-mkt-last-time-goal 0)
    (set-goal byz-mkt-approval-count-goal 0)
    (set-goal byz-mkt-rejection-count-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-mkt-stability-goal 100)
    (disable-self))

; Snapshot the shared exchange state. The global price is information, not proof
; of the enemy's exact stockpile.
(defrule
    (timer-triggered fifteensec)
=>
    (up-modify-goal byz-mkt-food-price-goal s:= commodity-buying-price food)
    (up-modify-goal byz-mkt-wood-price-goal s:= commodity-buying-price wood)
    (up-modify-goal byz-mkt-stone-price-goal s:= commodity-buying-price stone)
    (up-modify-goal byz-mkt-food-sell-price-goal s:= commodity-selling-price food)
    (up-modify-goal byz-mkt-wood-sell-price-goal s:= commodity-selling-price wood)
    (up-modify-goal byz-mkt-stone-sell-price-goal s:= commodity-selling-price stone))

; A market transaction must first be a request from the Economic War Director.
(defrule
    (up-compare-goal byz-eco-market-request-goal >= c:1)
=>
    (set-goal byz-mkt-approval-goal ad-eco-market-consider)
    (set-goal byz-mkt-safety-goal 80))

; Commodity choice follows the Quartermaster deficit, but the Market Officer
; does not invent resource needs.
(defrule
    (up-compare-goal byz-eco-market-request-goal == c:1)
    (up-compare-goal byz-prod-deficit-food-goal >= c:4)
=>
    (set-goal byz-mkt-commodity-goal ad-market-food)
    (set-goal byz-mkt-action-goal ad-market-buy))
(defrule
    (up-compare-goal byz-eco-market-request-goal == c:1)
    (up-compare-goal byz-prod-deficit-wood-goal >= c:4)
=>
    (set-goal byz-mkt-commodity-goal ad-market-wood)
    (set-goal byz-mkt-action-goal ad-market-buy))
(defrule
    (up-compare-goal byz-eco-market-request-goal == c:1)
    (up-compare-goal byz-prod-deficit-siege-goal >= c:2)
=>
    (set-goal byz-mkt-commodity-goal ad-market-wood)
    (set-goal byz-mkt-action-goal ad-market-buy))

; Time purchase: buying food can be rational if it materially accelerates an
; Imperial/conversion window.
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:1)
    (up-compare-goal byz-mkt-action-goal == c:1)
    (up-compare-goal byz-eco-time-value-goal >= c:70)
=>
    (set-goal byz-mkt-mode-goal ad-market-time-purchase)
    (set-goal byz-mkt-time-value-goal 85)
    (set-goal byz-mkt-benefit-goal 80))

; Price guard: avoid buying food at an extreme price unless the time value is
; exceptional. The same pattern can be extended later to wood/stone.
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:1)
    (up-compare-goal byz-mkt-food-price-goal >= c:150)
    (up-compare-goal byz-mkt-time-value-goal < c:85)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))

; Manipulation: buy to push a shared price upward only while the Economic War
; Director identifies a credible enemy dependency and our own reserves are safe.
(defrule
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-eco-gold-denial-pressure-goal >= c:80)
    (up-compare-goal byz-eco-enemy-gold-dependence-goal >= c:70)
    (up-compare-goal byz-optionality-goal >= c:50)
    (up-compare-goal byz-eco-market-risk-goal <= c:35)
=>
    (set-goal byz-mkt-mode-goal ad-market-manipulate-buy)
    (set-goal byz-mkt-action-goal ad-market-manipulate-buy)
    (set-goal byz-mkt-manipulation-value-goal 75))

; Safety vetoes outrank economic requests.
(defrule
    (up-compare-goal byz-net-emergency-goal >= c:70)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))
(defrule
    (up-compare-goal byz-net-veto-goal >= c:70)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))
(defrule
    (up-compare-goal byz-optionality-goal <= c:25)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))

; Execute BUY only after approval and no veto.
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:1)
    (up-compare-goal byz-mkt-action-goal == c:1)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-buy-commodity food)
=>
    (buy-commodity food)
    (set-goal byz-mkt-last-action-goal ad-market-buy)
    (set-goal byz-mkt-last-commodity-goal ad-market-food)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:2)
    (up-compare-goal byz-mkt-action-goal == c:1)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-buy-commodity wood)
=>
    (buy-commodity wood)
    (set-goal byz-mkt-last-action-goal ad-market-buy)
    (set-goal byz-mkt-last-commodity-goal ad-market-wood)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:3)
    (up-compare-goal byz-mkt-action-goal == c:1)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-buy-commodity stone)
=>
    (buy-commodity stone)
    (set-goal byz-mkt-last-action-goal ad-market-buy)
    (set-goal byz-mkt-last-commodity-goal ad-market-stone)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))

; Execute SELL only with explicit economic approval.
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:1)
    (up-compare-goal byz-mkt-action-goal == c:2)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-sell-commodity food)
=>
    (sell-commodity food)
    (set-goal byz-mkt-last-action-goal ad-market-sell)
    (set-goal byz-mkt-last-commodity-goal ad-market-food)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:2)
    (up-compare-goal byz-mkt-action-goal == c:2)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-sell-commodity wood)
=>
    (sell-commodity wood)
    (set-goal byz-mkt-last-action-goal ad-market-sell)
    (set-goal byz-mkt-last-commodity-goal ad-market-wood)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))
(defrule
    (up-compare-goal byz-mkt-commodity-goal == c:3)
    (up-compare-goal byz-mkt-action-goal == c:2)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-sell-commodity stone)
=>
    (sell-commodity stone)
    (set-goal byz-mkt-last-action-goal ad-market-sell)
    (set-goal byz-mkt-last-commodity-goal ad-market-stone)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))

; Manipulation uses BUY, but only as a deliberate mode; one transaction per lock.
(defrule
    (up-compare-goal byz-mkt-mode-goal == c:3)
    (up-compare-goal byz-mkt-action-goal == c:3)
    (up-compare-goal byz-eco-market-approval-goal == c:2)
    (up-compare-goal byz-mkt-catastrophe-veto-goal == c:0)
    (up-compare-goal byz-mkt-transaction-lock-goal == c:0)
    (up-compare-goal byz-sov-economic-authority-goal != c:byz-sov-authority-quarantine)
    (up-compare-goal byz-sov-market-lock-goal == c:0)
    (can-buy-commodity food)
=>
    (buy-commodity food)
    (set-goal byz-mkt-last-action-goal ad-market-manipulate-buy)
    (set-goal byz-mkt-last-commodity-goal ad-market-food)
    (set-goal byz-mkt-transaction-lock-goal 1)
    (up-modify-goal byz-mkt-approval-count-goal c:+ 1))

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-mkt-transaction-lock-goal 0)
    (set-goal byz-mkt-catastrophe-veto-goal 0)
    (set-goal byz-mkt-action-goal ad-market-idle)
    (set-goal byz-mkt-approval-goal ad-eco-no-market)
    (set-goal byz-mkt-cycle-goal 0))


; ===========================================================================
; SOVEREIGN ECONOMIC GATE
; ===========================================================================
(defrule
    (up-compare-goal byz-sov-economic-authority-goal == c:byz-sov-authority-quarantine)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))
(defrule
    (up-compare-goal byz-sov-veto-goal >= c:85)
=>
    (set-goal byz-mkt-catastrophe-veto-goal 1)
    (set-goal byz-mkt-approval-goal ad-eco-market-veto))
