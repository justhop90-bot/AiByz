(defconst byz-micro-formation-mode-goal 1963)
(defconst byz-micro-tactical-timeout-goal 1964)
(defconst byz-micro-command-lock-goal 1965)
(defconst byz-micro-authority-goal 1966)

(defconst byz-micro-choke-posture 9)
(defconst byz-micro-defend-posture 10)
(defconst byz-micro-siege-posture 11)
(defconst byz-micro-observe 0)
(defconst byz-micro-stabilize 1)
(defconst byz-micro-engage 2)
(defconst byz-micro-screen 3)
(defconst byz-micro-pursue 4)
(defconst byz-micro-retreat 5)
(defconst byz-micro-intercept 6)
(defconst byz-micro-flank 7)
(defconst byz-micro-convert 8)

(defconst byz-micro-formation-open 0)
(defconst byz-micro-formation-tight 1)
(defconst byz-micro-formation-screen 2)
(defconst byz-micro-formation-flank 3)

; --------------------------- INITIALIZATION -------------------------------
(defrule
    (true)
=>
    (set-goal byz-micro-cycle-goal byz-micro-observe)
    (set-goal byz-micro-state-goal byz-micro-stabilize)
    (set-goal byz-micro-posture-goal byz-micro-defend-posture)
    (set-goal byz-micro-confidence-goal 50)
    (set-goal byz-micro-urgency-goal 0)
    (set-goal byz-micro-battle-value-goal 50)
    (set-goal byz-micro-exchange-goal 50)
    (set-goal byz-micro-local-advantage-goal 50)
    (set-goal byz-micro-local-risk-goal 50)
    (set-goal byz-micro-pursuit-goal 20)
    (set-goal byz-micro-overextend-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-micro-screen-goal 0)
    (set-goal byz-micro-siege-protection-goal 0)
    (set-goal byz-micro-monk-protection-goal 0)
    (set-goal byz-micro-cavalry-intercept-goal 0)
    (set-goal byz-micro-ranged-kite-goal 0)
    (set-goal byz-micro-infantry-hold-goal 0)
    (set-goal byz-micro-cataph-breakthrough-goal 0)
    (set-goal byz-micro-siege-focus-goal 0)
    (set-goal byz-micro-conversion-support-goal 0)
    (set-goal byz-micro-retreat-threshold-goal 40)
    (set-goal byz-micro-press-threshold-goal 65)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-micro-pursuit-threshold-goal 75)
    (set-goal byz-micro-reserve-goal 40)
    (set-goal byz-micro-formation-distance-goal 24)
    (set-goal byz-micro-leader-distance-goal 3)
    (set-goal byz-micro-target-eval-distance-goal 0)
    (set-goal byz-micro-target-eval-siege-goal 500)
    (set-goal byz-micro-target-eval-killratio-goal 0)
    (set-goal byz-micro-target-eval-boat-goal 0)
    (set-goal byz-micro-target-eval-roof-goal 0)
    (set-goal byz-micro-dodge-goal 0)
    (set-goal byz-micro-kite-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-micro-stability-goal 50)
    (set-goal byz-micro-lock-goal 0)
    (set-goal byz-micro-command-goal 0)
    (set-goal byz-micro-feedback-goal 0)
    (set-goal byz-micro-attrition-goal 50)
    (set-goal byz-micro-target-priority-goal 50)
    (set-goal byz-micro-preservation-goal 50)
    (set-goal byz-micro-raid-posture-goal 0)
    (set-goal byz-micro-flank-posture-goal 0)
    (set-goal byz-micro-defend-posture-goal 50)
    (set-goal byz-micro-siege-posture-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-micro-choke-posture-goal 0)
    (set-goal byz-micro-reset-goal 0)
    (set-goal byz-micro-local-mass-goal 0)
    (set-goal byz-micro-enemy-mass-goal 0)
    (set-goal byz-micro-range-risk-goal 0)
    (set-goal byz-micro-siege-risk-goal 0)
    (set-goal byz-micro-cavalry-risk-goal 0)
    (set-goal byz-micro-pursuit-risk-goal 0)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-open)
    (set-goal byz-micro-tactical-timeout-goal 0)
    (set-goal byz-micro-command-lock-goal 0)
    (disable-self))
(defrule
    (true)
=>
    (set-goal byz-micro-authority-goal 0)
    (disable-self))

; ==========================================================================
; PHASE 1 — BATTLEVALUE / LOCAL FIGHT QUALITY
; ==========================================================================
; The existing Reasoning layer supplies battle-risk and battle-exchange. We add
; local advantage, position preservation and strategic-overextension penalties.

(defrule
    (up-compare-goal byz-battle-exchange-goal >= c:70)
    (up-compare-goal byz-battle-risk-goal <= c:35)
=>
    (set-goal byz-micro-battle-value-goal 85)
    (set-goal byz-micro-local-advantage-goal 80)
    (set-goal byz-micro-press-threshold-goal 55))

(defrule
    (up-compare-goal byz-battle-exchange-goal <= c:35)
    (up-compare-goal byz-battle-risk-goal >= c:70)
=>
    (set-goal byz-micro-battle-value-goal 20)
    (set-goal byz-micro-local-risk-goal 90)
    (set-goal byz-micro-retreat-threshold-goal 55))

(defrule
    (up-compare-goal byz-rx-sustainability-goal <= c:30)
    (up-compare-goal byz-rx-recovery-gap-goal >= c:50)
=>
    (set-goal byz-micro-preservation-goal 90)
    (set-goal byz-micro-retreat-threshold-goal 65)
    (set-goal byz-micro-pursuit-threshold-goal 90))

; ==========================================================================
; PHASE 2 — UNIT-ROLE MICRO DOCTRINE
; ==========================================================================

; Anti-cavalry: position, screen, don't chase.
(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:60)
=>
    (set-goal byz-micro-cavalry-intercept-goal 85)
    (set-goal byz-micro-infantry-hold-goal 75)
    (set-goal byz-micro-overextend-goal 20)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-tight))

; Ranged: kite and focus fire, especially when local advantage is positive.
(defrule
    (up-compare-goal byz-force-anti-ranged-demand-goal >= c:55)
=>
    (set-goal byz-micro-ranged-kite-goal 90)
    (set-goal byz-micro-kite-goal 90)
    (set-goal byz-micro-dodge-goal 80)
    (set-goal byz-micro-target-priority-goal 80))

; Cataphracts: breakthrough only into favorable targets; avoid ranged mass.
(defrule
    (up-compare-goal byz-force-cataph-demand-goal >= c:60)
=>
    (set-goal byz-micro-cataph-breakthrough-goal 90)
    (set-goal byz-micro-range-risk-goal 80)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-open))

; Siege: protection becomes an explicit tactical prerequisite.
(defrule
    (up-compare-goal byz-force-siege-demand-goal >= c:50)
=>
    (set-goal byz-micro-siege-protection-goal 90)
    (set-goal byz-micro-screen-goal 90)
    (set-goal byz-micro-siege-posture-goal 80)
    (set-goal byz-micro-target-eval-siege-goal 700))

; Monks stay behind the army and become a preservation multiplier.
(defrule
    (up-compare-goal byz-force-monk-demand-goal >= c:40)
=>
    (set-goal byz-micro-monk-protection-goal 95)
    (set-goal byz-micro-preservation-goal 80))

; ==========================================================================
; PHASE 3 — STRATEGIC POSTURES
; ==========================================================================

(defrule
    (goal byz-state-goal byz-state-stabilize)
=>
    (set-goal byz-micro-state-goal byz-micro-stabilize)
    (set-goal byz-micro-posture-goal byz-micro-defend-posture)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-tight)
    (set-goal byz-micro-overextend-goal 10))

(defrule
    (goal byz-state-goal byz-state-constrain)
=>
    (set-goal byz-micro-state-goal byz-micro-engage)
    (set-goal byz-micro-posture-goal byz-micro-screen)
    (set-goal byz-micro-screen-goal 85)
    (set-goal byz-micro-overextend-goal 25))

(defrule
    (goal byz-state-goal byz-state-exploit)
=>
    (set-goal byz-micro-state-goal byz-micro-pursue)
    (set-goal byz-micro-posture-goal byz-micro-flank)
    (set-goal byz-micro-pursuit-goal 80)
    (set-goal byz-micro-flank-posture-goal 85))

(defrule
    (goal byz-state-goal byz-state-convert)
=>
    (set-goal byz-micro-state-goal byz-micro-convert)
    (set-goal byz-micro-posture-goal byz-micro-siege-posture)
    (set-goal byz-micro-siege-focus-goal 90)
    (set-goal byz-micro-conversion-support-goal 95))

(defrule
    (goal byz-state-goal byz-state-deny-recovery)
=>
    (set-goal byz-micro-state-goal byz-micro-convert)
    (set-goal byz-micro-posture-goal byz-micro-choke-posture)
    (set-goal byz-micro-target-priority-goal 90)
    (set-goal byz-micro-pursuit-threshold-goal 85))

; ==========================================================================
; PHASE 4 — NATIVE EXTREME MICRO STEERING
; ==========================================================================
; These settings are already part of the copied Extreme/Promisory AI. The
; Byzantine layer changes their intensity according to the tactical state.

(defrule
    (up-compare-goal byz-micro-ranged-kite-goal >= c:70)
=>
    (set-difficulty-parameter ability-to-maintain-distance ability-to-kite)
    (set-difficulty-parameter ability-to-dodge-missiles ability-to-dodge)
    (set-strategic-number sn-attack-intelligence 1))

(defrule
    (up-compare-goal byz-micro-ranged-kite-goal < c:40)
    (up-compare-goal byz-micro-siege-risk-goal <= c:35)
=>
    (set-difficulty-parameter ability-to-maintain-distance ability-to-kite)
    (set-strategic-number sn-attack-intelligence 1))

(defrule
    (up-compare-goal byz-micro-siege-protection-goal >= c:75)
=>
    (set-strategic-number sn-group-form-distance 24)
    (set-strategic-number sn-group-leader-defense-distance 3)
    (set-strategic-number sn-garrison-rams 1))

(defrule
    (up-compare-goal byz-micro-siege-protection-goal < c:45)
=>
    (set-strategic-number sn-group-form-distance 18)
    (set-strategic-number sn-group-leader-defense-distance 2)
    (set-strategic-number sn-garrison-rams 0))

; Native target evaluation is steered away from wasting army time on structures
; unless the strategic conversion director has requested a conversion posture.
(defrule
    (up-compare-goal byz-micro-state-goal >= c:byz-micro-convert)
=>
    (set-strategic-number sn-target-evaluation-distance byz-micro-target-eval-distance-goal)
    (set-strategic-number sn-target-evaluation-siege-weapon byz-micro-target-eval-siege-goal)
    (set-strategic-number sn-target-evaluation-time-kill-ratio byz-micro-target-eval-killratio-goal))

; When not converting, emphasize battlefield targets and reduce structure-chasing.
(defrule
    (up-compare-goal byz-micro-state-goal < c:byz-micro-convert)
=>
    (set-strategic-number sn-target-evaluation-distance 0)
    (set-strategic-number sn-target-evaluation-siege-weapon 500)
    (set-strategic-number sn-target-evaluation-time-kill-ratio 0))

; ==========================================================================
; PHASE 5 — RETREAT / PURSUIT DISCIPLINE
; ==========================================================================

(defrule
    (up-compare-goal byz-micro-battle-value-goal <= g:byz-micro-retreat-threshold-goal)
    (up-compare-goal byz-micro-preservation-goal >= c:70)
=>
    (set-goal byz-micro-state-goal byz-micro-retreat)
    (set-goal byz-micro-posture-goal byz-micro-defend-posture)
    (set-goal byz-micro-command-goal byz-micro-retreat))

(defrule
    (up-compare-goal byz-micro-battle-value-goal >= g:byz-micro-press-threshold-goal)
    (up-compare-goal byz-micro-local-risk-goal <= c:45)
=>
    (set-goal byz-micro-state-goal byz-micro-engage)
    (set-goal byz-micro-command-goal byz-micro-engage)
    (set-strategic-number sn-number-attack-groups 500))

(defrule
    (up-compare-goal byz-micro-pursuit-goal >= g:byz-micro-pursuit-threshold-goal)
    (up-compare-goal byz-micro-overextend-goal <= c:35)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:40)
=>
    (set-goal byz-micro-state-goal byz-micro-pursue)
    (set-goal byz-micro-command-goal byz-micro-pursue)
    (set-strategic-number sn-attack-group-gather-spacing 10))

; Never pursue simply because the enemy is running. Punish recovery only when
; economic/strategic conversion is strong and overextension remains low.
(defrule
    (up-compare-goal byz-micro-pursuit-goal < c:60)
=>
    (set-goal byz-micro-pursuit-goal 30))

; ==========================================================================
; PHASE 6 — SPECIALIST TACTICAL RULES
; ==========================================================================

; Halberdier doctrine: guard, don't chase.
(defrule
    (up-compare-goal byz-force-anti-cav-demand-goal >= c:70)
    (up-compare-goal byz-micro-local-risk-goal >= c:55)
=>
    (set-goal byz-micro-cavalry-intercept-goal 95)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-tight)
    (set-goal byz-micro-overextend-goal 5))

; Skirmisher doctrine: kiting + priority on ranged threats.
(defrule
    (up-compare-goal byz-ranged-pressure-goal >= c:60)
=>
    (set-goal byz-micro-ranged-kite-goal 95)
    (set-goal byz-micro-kite-goal 95)
    (set-goal byz-micro-target-priority-goal 90))

; Cataphract doctrine: breakthrough only when enemy infantry is the high-value
; target and ranged risk is tolerable.
(defrule
    (up-compare-goal byz-infantry-pressure-goal >= c:65)
    (up-compare-goal byz-ranged-pressure-goal <= c:55)
=>
    (set-goal byz-micro-cataph-breakthrough-goal 95)
    (set-goal byz-micro-range-risk-goal 45)
    (set-goal byz-micro-formation-mode-goal byz-micro-formation-open))

; Siege screen: if risk rises, preserve siege before preserving pursuit.
(defrule
    (up-compare-goal byz-siege-pressure-goal >= c:45)
    (up-compare-goal byz-micro-siege-protection-goal >= c:70)
=>
    (set-goal byz-micro-screen-goal 95)
    (set-goal byz-micro-pursuit-goal 20)
    (set-goal byz-micro-preservation-goal 90)
    (set-goal byz-micro-posture-goal byz-micro-screen))

; Monk safety is never sacrificed for a marginal pursuit.
(defrule
    (up-compare-goal byz-force-monk-demand-goal >= c:40)
    (up-compare-goal byz-micro-local-risk-goal >= c:60)
=>
    (set-goal byz-micro-monk-protection-goal 100)
    (set-goal byz-micro-pursuit-goal 10)
    (set-goal byz-micro-preservation-goal 95))

; ==========================================================================
; PHASE 7 — MICRO LOCK / ANTI-THRASHING
; ==========================================================================

(defrule
    (up-compare-goal byz-threat-confidence-goal <= c:30)
    (up-compare-goal byz-micro-battle-value-goal >= c:55)
=>
    (set-goal byz-micro-lock-goal 85)
    (set-goal byz-micro-command-lock-goal 1))

(defrule
    (up-compare-goal byz-rx-regret-goal >= c:80)
=>
    (set-goal byz-micro-lock-goal 20)
    (set-goal byz-micro-command-lock-goal 0)
    (set-goal byz-micro-urgency-goal 90))

(defrule
    (up-compare-goal byz-micro-lock-goal >= c:80)
    (up-compare-goal byz-micro-battle-value-goal >= c:55)
=>
    (set-goal byz-micro-stability-goal 90))

; ==========================================================================
; PHASE 8 — FEEDBACK / RESET
; ==========================================================================

(defrule
    (up-compare-goal byz-micro-battle-value-goal >= c:70)
    (up-compare-goal byz-micro-exchange-goal >= c:60)
=>
    (set-goal byz-micro-feedback-goal 85)
    (set-goal byz-micro-attrition-goal 80))

(defrule
    (up-compare-goal byz-micro-battle-value-goal <= c:35)
=>
    (set-goal byz-micro-feedback-goal 90)
    (set-goal byz-micro-attrition-goal 25))

(defrule
    (timer-triggered fifteensec)
=>
    (set-goal byz-micro-cycle-goal byz-micro-observe)
    (set-goal byz-micro-reset-goal 1))

; ==========================================================================
; END OF AD BYZANTINE MICRO / FORMATION / TACTICAL EXECUTION DIRECTOR
; ============================================================================
