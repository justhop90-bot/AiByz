; Strategic packages.
(defrule (up-compare-goal byz-force-anti-cav-demand-goal >= c:60) => (set-goal byz-tech-halberdier-goal 90) (set-goal byz-tech-heavy-camel-goal 60))
(defrule (up-compare-goal byz-force-anti-ranged-demand-goal >= c:55) => (set-goal byz-tech-elite-skirm-goal 90))
(defrule (up-compare-goal byz-ranged-pressure-goal >= c:60) (up-compare-goal byz-enemy-quality-goal >= c:65) => (set-goal byz-tech-arbalest-goal 70))
(defrule (up-compare-goal byz-infantry-pressure-goal >= c:60) (up-compare-goal byz-force-breakthrough-demand-goal >= c:65) => (set-goal byz-tech-cataph-upgrade-goal 90) (set-goal byz-tech-logistica-goal 90))
(defrule (up-compare-goal byz-force-siege-demand-goal >= c:60) (up-compare-goal byz-conversion-value-goal >= c:55) => (set-goal byz-tech-siege-ram-goal 80) (set-goal byz-tech-siege-engineers-goal 85))
(defrule (up-compare-goal byz-force-area-demand-goal >= c:70) (up-compare-goal byz-enemy-mass-goal >= c:25) => (set-goal byz-tech-onager-goal 70))
(defrule (up-compare-goal byz-force-healing-demand-goal >= c:60) (up-compare-goal byz-conversion-value-goal >= c:50) => (set-goal byz-tech-redemption-goal 75) (set-goal byz-tech-block-printing-goal 60) (set-goal byz-tech-sanctity-goal 65))
(defrule (up-compare-goal byz-gold-denial-cap-goal >= c:60) => (set-goal byz-tech-coinage-goal 55) (set-goal byz-tech-banking-goal 50) (set-goal byz-tech-guilds-goal 55))
(defrule (up-compare-goal byz-threat-score-goal >= c:60) (up-compare-goal byz-position-value-goal >= c:2) => (set-goal byz-tech-masonry-goal 70) (set-goal byz-tech-architecture-goal 70) (set-goal byz-tech-hoardings-goal 60))
(defrule (up-compare-goal byz-map-control-goal >= c:55) (up-compare-goal byz-eco-security-goal >= c:45) => (set-goal byz-tech-greek-fire-goal 80))
(defrule (up-compare-goal byz-ranged-pressure-goal >= c:55) => (set-goal byz-tech-bracer-goal 85))
(defrule (up-compare-goal byz-force-frontline-demand-goal >= c:60) => (set-goal byz-tech-plate-mail-goal 75))
(defrule (up-compare-goal byz-force-anti-infantry-demand-goal >= c:60) => (set-goal byz-tech-blast-furnace-goal 85))
(defrule (up-compare-goal byz-ranged-pressure-goal >= c:55) => (set-goal byz-tech-chemistry-goal 65))

; Age / Imperial timing is a request, never an unconditional execution.
(defrule
    (current-age == feudal-age)
    (up-compare-goal byz-eco-security-goal >= c:55)
    (up-compare-goal byz-threat-score-goal <= c:65)
=>
    (set-goal byz-tech-age-target-goal castle-age)
    (set-goal byz-tech-age-urgency-goal 70))
(defrule
    (current-age == castle-age)
    (up-compare-goal byz-conversion-value-goal >= c:60)
    (up-compare-goal byz-eco-security-goal >= c:55)
    (up-compare-goal byz-enemy-recovery-capacity-goal <= c:45)
=>
    (set-goal byz-tech-age-target-goal imperial-age)
    (set-goal byz-tech-age-urgency-goal 90)
    (set-goal byz-tech-imperial-window-goal 80)
    (set-goal byz-tech-imperial-conversion-goal 85)
    (set-goal byz-tech-imperial-ready-goal 80))
(defrule
    (up-compare-goal byz-eco-security-goal <= c:25)
    (up-compare-goal byz-threat-score-goal >= c:70)
=>
    (set-goal byz-tech-veto-goal 95)
    (set-goal byz-tech-age-urgency-goal 10))

; Multi-officer approval scores.
(defrule (up-compare-goal byz-prod-reserve-priority-goal >= c:30) => (set-goal byz-tech-quartermaster-check-goal 75))
(defrule (up-compare-goal byz-prod-reserve-priority-goal < c:30) => (set-goal byz-tech-quartermaster-check-goal 20))
(defrule (up-compare-goal byz-eco-opportunity-cost-goal <= c:45) => (set-goal byz-tech-economic-check-goal 75))
(defrule (up-compare-goal byz-eco-opportunity-cost-goal >= c:70) => (set-goal byz-tech-economic-check-goal 20))
(defrule (up-compare-goal byz-force-anti-cav-demand-goal >= c:55) => (set-goal byz-tech-general-check-goal 80))
(defrule (up-compare-goal byz-force-siege-demand-goal >= c:60) (up-compare-goal byz-conversion-value-goal >= c:55) => (set-goal byz-tech-general-check-goal 85))
(defrule (up-compare-goal byz-battle-risk-goal <= c:60) => (set-goal byz-tech-battle-check-goal 70))
(defrule (up-compare-goal byz-battle-risk-goal >= c:80) => (set-goal byz-tech-battle-check-goal 20))
(defrule (up-compare-goal byz-threat-confidence-goal >= c:60) => (set-goal byz-tech-intelligence-check-goal 75))
(defrule (up-compare-goal byz-threat-confidence-goal <= c:30) => (set-goal byz-tech-intelligence-check-goal 20))
(defrule (up-compare-goal byz-net-command-confidence-goal >= c:60) => (set-goal byz-tech-network-check-goal 80))
(defrule
    (up-compare-goal byz-tech-veto-goal < c:90)
    (up-compare-goal byz-tech-quartermaster-check-goal >= c:60)
    (up-compare-goal byz-tech-economic-check-goal >= c:60)
    (up-compare-goal byz-tech-general-check-goal >= c:60)
    (up-compare-goal byz-tech-battle-check-goal >= c:55)
    (up-compare-goal byz-tech-intelligence-check-goal >= c:55)
    (up-compare-goal byz-tech-network-check-goal >= c:55)
=>
    (set-goal byz-tech-approval-score-goal 80))
(defrule
    (up-compare-goal byz-tech-veto-goal >= c:90)
=>
    (set-goal byz-tech-approval-score-goal 0)
    (set-goal byz-tech-command-lock-goal 1))

; One-command request. Priority order deliberately puts military survival above
; optional economy tech. ExecutionBridge handles can-research and action.
(defrule
