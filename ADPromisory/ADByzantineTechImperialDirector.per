; Sovereign gate is advisory here; execution checks it again at the final authority.
(defrule
    (up-compare-goal byz-sov-tech-authority-goal == c:byz-sov-authority-quarantine)
=>
    (set-goal byz-tech-command-goal byz-tech-cmd-none)
    (set-goal byz-tech-veto-goal 95))
(defrule
    (up-compare-goal byz-sov-veto-goal >= c:85)
    (up-compare-goal byz-sov-emergency-override-goal < c:90)
=>
    (set-goal byz-tech-command-goal byz-tech-cmd-none)
    (set-goal byz-tech-veto-goal 90))
