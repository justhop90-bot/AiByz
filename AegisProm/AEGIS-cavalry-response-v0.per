; AEGIS CAVALRY RESPONSE V0 - bounded defensive production
; Canonical lifecycle: threat classification -> capability demand ->
; feasibility -> authorization -> physical production -> pending evidence.
; This module does not collapse threat observation into production success.
(defconst aegis-cr-generation 620)
(defconst aegis-cr-valid 621)
(defconst aegis-cr-stage 622)
(defconst aegis-cr-attempts 623)
(defconst aegis-cr-baseline 624)
(defconst aegis-cr-request-id 625)
(defconst aegis-cr-authorization-id 626)
(defconst aegis-cr-authorization-generation 627)
(defconst aegis-cr-authorization-valid 628)
(defconst aegis-cr-authorization-expiry 629)
(defconst aegis-cr-baseline-spears 638)
(defconst aegis-cr-observed-spears 639)
(defconst aegis-cr-world-evidence 640)
(defconst aegis-cr-causal-evidence 641)
(defconst aegis-cr-failure 650)
(defconst aegis-cr-reassess-generation 768)
(defconst aegis-cr-reassess-valid 769)
(defconst aegis-cr-stage-idle 0)
(defconst aegis-cr-stage-authorized 1)
(defconst aegis-cr-stage-issued 2)
(defconst aegis-cr-stage-pending 3)
(defconst aegis-cr-stage-confirmed 4)
(defconst aegis-cr-stage-failed 5)
(defconst aegis-cr-failure-none 0)
(defconst aegis-cr-failure-not-feasible 1)
(defconst aegis-cr-failure-stale-authorization 2)
(defconst aegis-cr-failure-pending-lost 3)
(defconst aegis-cr-failure-causality-unproven 4)

(defrule
    (up-compare-goal aegis-st-valid == 1)
    (up-compare-goal aegis-cr-generation != aegis-st-generation)
    (up-compare-goal aegis-cr-valid == 0)
=>
    (up-modify-goal aegis-cr-generation g:= aegis-st-generation)
    (up-modify-goal aegis-cr-request-id g:= aegis-st-generation)
    (up-modify-goal aegis-cr-authorization-id g:= aegis-st-generation)
    (up-modify-goal aegis-cr-authorization-generation g:= aegis-st-generation)
    (up-modify-goal aegis-cr-authorization-expiry g:= aegis-st-generation)
    (up-get-fact unit-type-count spearman aegis-cr-baseline-spears)
    (set-goal aegis-cr-baseline 0)
    (set-goal aegis-cr-stage aegis-cr-stage-idle)
    (set-goal aegis-cr-attempts 0)
    (set-goal aegis-cr-authorization-valid 0)
    (set-goal aegis-cr-world-evidence 0)
    (set-goal aegis-cr-causal-evidence 0)
    (set-goal aegis-cr-valid 1)
    (set-goal aegis-cr-failure aegis-cr-failure-none)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-idle)
    (up-compare-goal aegis-st-threat == aegis-st-threat-cavalry)
    (can-train spearman-line)
=>
    (set-goal aegis-cr-stage aegis-cr-stage-authorized)
    (set-goal aegis-cr-authorization-valid 1)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-authorization-valid == 1)
    (up-compare-goal aegis-cr-authorization-generation != aegis-st-generation)
=>
    (set-goal aegis-cr-authorization-valid 0)
    (set-goal aegis-cr-failure aegis-cr-failure-stale-authorization)
    (set-goal aegis-cr-stage aegis-cr-stage-failed)
    (set-goal aegis-cr-valid 0)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-authorization-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-authorized)
    (up-compare-goal aegis-cr-attempts < 1)
    (can-train spearman-line)
=>
    (up-train escrow-state c: spearman-line)
    (up-modify-goal aegis-cr-attempts g:+ 1)
    (set-goal aegis-cr-stage aegis-cr-stage-issued)
    (set-goal aegis-cr-authorization-valid 0)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-authorization-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-authorized)
    (up-compare-goal aegis-cr-attempts < 1)
    (not (can-train spearman-line))
=>
    (set-goal aegis-cr-failure aegis-cr-failure-not-feasible)
    (set-goal aegis-cr-stage aegis-cr-stage-failed)
    (set-goal aegis-cr-authorization-valid 0)
    (set-goal aegis-cr-valid 0)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-issued)
    (up-pending-objects c: spearman-line >= 1)
=>
    (set-goal aegis-cr-stage aegis-cr-stage-pending)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-pending)
=>
    (up-get-fact unit-type-count spearman aegis-cr-observed-spears)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-pending)
    (up-compare-goal aegis-cr-observed-spears > aegis-cr-baseline-spears)
=>
    (set-goal aegis-cr-world-evidence 1)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-pending)
    (up-compare-goal aegis-cr-world-evidence == 1)
    (up-compare-goal aegis-cr-causal-evidence == 1)
    (up-compare-goal aegis-cr-request-id == aegis-cr-authorization-id)
=>
    (set-goal aegis-cr-stage aegis-cr-stage-confirmed)
    (set-goal aegis-cr-valid 0)
)

(defrule
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-pending)
    (up-pending-objects c: spearman-line <= 0)
    (up-compare-goal aegis-cr-observed-spears <= aegis-cr-baseline-spears)
=>
    (set-goal aegis-cr-failure aegis-cr-failure-pending-lost)
    (set-goal aegis-cr-stage aegis-cr-stage-failed)
    (set-goal aegis-cr-valid 0)
)

; Canonical reassessment boundary. Anti-cavalry publishes the terminal request
; outcome as a token; the next capability decision remains owned upstream.
(defrule
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-confirmed)
    (up-compare-goal aegis-cr-reassess-generation != aegis-cr-generation)
=>
    (up-modify-goal aegis-cr-reassess-generation g:= aegis-cr-generation)
    (set-goal aegis-cr-reassess-valid 1)
)

(defrule
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-failed)
    (up-compare-goal aegis-cr-reassess-generation != aegis-cr-generation)
=>
    (up-modify-goal aegis-cr-reassess-generation g:= aegis-cr-generation)
    (set-goal aegis-cr-reassess-valid 1)
)
