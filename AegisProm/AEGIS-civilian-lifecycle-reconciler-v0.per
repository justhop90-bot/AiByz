; AEGIS CIVILIAN LIFECYCLE RECONCILER V0
; Final runtime module - loaded by AEGIS-BYZ.per.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: reconcile villager production command, pending admission,
; and discrete villager census into a bounded lifecycle state.
; Canonical lifecycle: pending is not completion; completion requires
; request-bound world evidence and explicit causal verification.

(defconst aegis-vr-generation 441)
(defconst aegis-vr-valid 442)
(defconst aegis-vr-stage 443)
(defconst aegis-vr-baseline-villagers 444)
(defconst aegis-vr-observed-villagers 445)
(defconst aegis-vr-pending 446)
(defconst aegis-vr-confirmed-delta 447)
(defconst aegis-vr-attempts 448)
(defconst aegis-vr-observed-at 449)
(defconst aegis-vr-request-id 457)
(defconst aegis-vr-authorization-id 458)
(defconst aegis-vr-causal-status 459)
(defconst aegis-vr-causal-evidence 460)

(defconst aegis-vr-stage-init 0)
(defconst aegis-vr-stage-issued 1)
(defconst aegis-vr-stage-pending 2)
(defconst aegis-vr-stage-confirmed 3)
(defconst aegis-vr-stage-failed 4)

(defconst aegis-vr-causal-unknown 0)
(defconst aegis-vr-causal-pending 1)
(defconst aegis-vr-causal-confirmed 2)
(defconst aegis-vr-causal-failed 3)

; Start exactly one lifecycle record for a fresh production request.
; Preserve the production request/authorization identity rather than
; manufacturing a new verification identity.
(defrule
    (up-compare-goal aegis-vp-valid == 1)
    (up-compare-goal aegis-vp-stage == aegis-vp-stage-issued)
    (up-compare-goal aegis-vr-generation != aegis-vp-generation)
=>
    (set-goal aegis-vr-valid 0)
    (set-goal aegis-vr-stage aegis-vr-stage-issued)
    (set-goal aegis-vr-baseline-villagers aegis-vp-baseline-villagers)
    (set-goal aegis-vr-observed-villagers aegis-vp-baseline-villagers)
    (set-goal aegis-vr-pending 0)
    (set-goal aegis-vr-confirmed-delta 0)
    (set-goal aegis-vr-attempts aegis-vp-attempts)
    (set-goal aegis-vr-observed-at aegis-census-observed-at)
    (up-modify-goal aegis-vr-generation g:= aegis-vp-generation)
    (up-modify-goal aegis-vr-request-id g:= aegis-vp-request-id)
    (up-modify-goal aegis-vr-authorization-id g:= aegis-vp-authorization-id)
    (set-goal aegis-vr-causal-status aegis-vr-causal-unknown)
    (set-goal aegis-vr-causal-evidence 0)
    (set-goal aegis-vr-valid 1)
)

; Queue admission remains an intermediate state. It proves only that an
; engine-visible pending object exists, not that a villager was created.
(defrule
    (up-compare-goal aegis-vr-valid == 1)
    (up-compare-goal aegis-vr-stage == aegis-vr-stage-issued)
    (up-compare-goal aegis-census-pending-villagers == 1)
=>
    (set-goal aegis-vr-pending 1)
    (set-goal aegis-vr-stage aegis-vr-stage-pending)
    (set-goal aegis-vr-causal-status aegis-vr-causal-pending)
)

; Request-bound causal verification. A census increase is necessary world
; evidence, but this module does not infer causality from the increase alone.
; It only records the evidence and requires a distinct causal-evidence flag
; before the lifecycle can become confirmed. A separate proven attribution
; mechanism may set that flag when engine evidence rules out concurrent causes.
(defrule
    (up-compare-goal aegis-vr-valid == 1)
    (up-compare-goal aegis-vr-stage == aegis-vr-stage-pending)
    (up-compare-goal aegis-census-villagers > aegis-vr-baseline-villagers)
=>
    (set-goal aegis-vr-observed-villagers aegis-census-villagers)
    (up-modify-goal aegis-vr-confirmed-delta g:= aegis-census-villagers)
    (up-modify-goal aegis-vr-confirmed-delta g:- aegis-vr-baseline-villagers)
)

; Causal verification is explicit and request-bound. World-state evidence
; without attribution cannot receive completion credit.
(defrule
    (up-compare-goal aegis-vr-valid == 1)
    (up-compare-goal aegis-vr-stage == aegis-vr-stage-pending)
    (up-compare-goal aegis-vr-confirmed-delta > 0)
    (up-compare-goal aegis-vr-causal-evidence == 1)
    (up-compare-goal aegis-vr-request-id == aegis-vp-request-id)
    (up-compare-goal aegis-vr-authorization-id == aegis-vp-authorization-id)
=>
    (set-goal aegis-vr-causal-status aegis-vr-causal-confirmed)
    (set-goal aegis-vr-stage aegis-vr-stage-confirmed)
)

; Pending disappearance without world-state increase is a bounded failure.
; It does not become a successful completion by queue closure.
(defrule
    (up-compare-goal aegis-vr-valid == 1)
    (up-compare-goal aegis-vr-stage == aegis-vr-stage-pending)
    (up-compare-goal aegis-census-pending-villagers == 0)
    (up-compare-goal aegis-vr-causal-status != aegis-vr-causal-confirmed)
    (up-compare-goal aegis-census-villagers <= aegis-vr-baseline-villagers)
=>
    (set-goal aegis-vr-causal-status aegis-vr-causal-failed)
    (set-goal aegis-vr-stage aegis-vr-stage-failed)
    (set-goal aegis-vr-valid 0)
)

; Confirmed is terminal lifecycle evidence, but it is not strategic success.
; A higher-level reassessment owner must consume this result.
(defrule
    (up-compare-goal aegis-vr-valid == 1)
    (up-compare-goal aegis-vr-stage == aegis-vr-stage-confirmed)
=>
    (set-goal aegis-vr-valid 0)
)
