; AEGIS DYNAMIC WORKER LOOP PROBE V0
; Qualification candidate - NOT LOADED by production root.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: measure pass-to-pass visibility of goal mutations.
; This probe deliberately avoids production economy commands.

(defconst aegis-dp-timer 60)
(defconst aegis-dp-trigger 560)
(defconst aegis-dp-observed 561)
(defconst aegis-dp-stage 562)
(defconst aegis-dp-cycle 563)
(defconst aegis-dp-stage-init 0)
(defconst aegis-dp-stage-written 1)
(defconst aegis-dp-stage-seen 2)

(defrule
    (game-time < 2)
=>
    (enable-timer aegis-dp-timer 1)
)

(defrule
    (timer-triggered aegis-dp-timer)
    (up-compare-goal aegis-dp-stage == aegis-dp-stage-init)
=>
    (enable-timer aegis-dp-timer 5)
    (set-goal aegis-dp-trigger 1)
    (set-goal aegis-dp-cycle 1)
    (set-goal aegis-dp-stage aegis-dp-stage-written)
)

(defrule
    (timer-triggered aegis-dp-timer)
    (up-compare-goal aegis-dp-trigger == 1)
    (up-compare-goal aegis-dp-stage == aegis-dp-stage-written)
=>
    (set-goal aegis-dp-observed 1)
    (set-goal aegis-dp-stage aegis-dp-stage-seen)
)