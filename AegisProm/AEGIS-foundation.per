; AEGIS FOUNDATION - runtime world observation and shared state
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652

(defconst aegis-wm-timer 300)
(defconst aegis-wm-valid 301)
(defconst aegis-wm-generation 302)
(defconst aegis-wm-stage 303)
(defconst aegis-wm-observed-at 304)
(defconst aegis-wm-cycle 305)
(defconst aegis-wm-time 306)
(defconst aegis-wm-population 307)
(defconst aegis-wm-population-cap 308)
(defconst aegis-wm-age 309)
(defconst aegis-wm-food 310)
(defconst aegis-wm-wood 311)
(defconst aegis-wm-gold 312)
(defconst aegis-wm-spear 313)
(defconst aegis-wm-camel 314)
(defconst aegis-wm-skirm 315)
(defconst aegis-wm-cavalry 316)
(defconst aegis-wm-archers 317)
(defconst aegis-wm-focus-player 318)
(defconst aegis-wm-evidence 319)
(defconst aegis-wm-stage-init 0)
(defconst aegis-wm-stage-observe 1)
(defconst aegis-wm-stage-qualified 2)
(defconst aegis-evidence-unknown 0)
(defconst aegis-evidence-observed 1)

(defrule
    (game-time < 2)
=>
    (enable-timer aegis-wm-timer 1)
)

(defrule
    (timer-triggered aegis-wm-timer)
=>
    (enable-timer aegis-wm-timer 5)
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-stage aegis-wm-stage-observe)
    (up-get-fact game-time 0 aegis-wm-time)
    (up-get-fact population 0 aegis-wm-population)
    (up-get-fact population-cap 0 aegis-wm-population-cap)
    (set-goal aegis-wm-age 0)
    (up-get-fact resource-amount amount-food aegis-wm-food)
    (up-get-fact resource-amount amount-wood aegis-wm-wood)
    (up-get-fact resource-amount amount-gold aegis-wm-gold)
    (up-get-fact unit-type-count spearman-line aegis-wm-spear)
    (up-get-fact unit-type-count camel-line aegis-wm-camel)
    (up-get-fact unit-type-count skirmisher-line aegis-wm-skirm)
    (up-get-fact unit-type-count knight-line aegis-wm-cavalry)
    (up-get-fact unit-type-count archer-line aegis-wm-archers)
    (up-modify-goal aegis-wm-cycle g:+ 1)
    (up-modify-goal aegis-wm-generation g:+ 1)
    (up-modify-goal aegis-wm-observed-at g:= aegis-wm-time)
    (set-goal aegis-wm-focus-player 1)
    (set-goal aegis-wm-evidence aegis-evidence-observed)
    (set-goal aegis-wm-stage aegis-wm-stage-qualified)
    (set-goal aegis-wm-valid 1)
)