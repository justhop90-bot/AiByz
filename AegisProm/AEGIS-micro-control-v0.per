; AEGIS MICRO CONTROL V0 - intent, lifecycle, and recovery state
; Owns the stable tactical request identity. It does not own physical dispatch.
(defconst aegis-mc-generation 670)
(defconst aegis-mc-valid 671)
(defconst aegis-mc-stage 672)
(defconst aegis-mc-intent 673)
(defconst aegis-mc-target-ready 674)
(defconst aegis-mc-observed 675)
(defconst aegis-mc-failure 676)
(defconst aegis-mc-attempts 677)
(defconst aegis-mc-request-id 734)
(defconst aegis-mc-request-generation 735)
(defconst aegis-mc-reassess-generation 784)
(defconst aegis-mc-reassess-valid 785)
(defconst aegis-mc-stage-idle 0)
(defconst aegis-mc-stage-search 1)
(defconst aegis-mc-stage-authorized 2)
(defconst aegis-mc-stage-issued 3)
(defconst aegis-mc-stage-reassess 4)
(defconst aegis-mc-intent-none 0)
(defconst aegis-mc-intent-engage 1)
(defconst aegis-mc-intent-retreat 2)
(defconst aegis-mc-intent-regroup 3)
(defconst aegis-mc-failure-none 0)
(defconst aegis-mc-failure-no-target 1)
(defconst aegis-mc-failure-dispatch 2)

; A new World Model frame may create a new request only when the previous
; tactical lifecycle has closed. This prevents an active request from being
; silently replaced by a newer observation frame.
(defrule
    (up-compare-goal aegis-wm-valid == 1)
    (up-compare-goal aegis-mc-generation != aegis-wm-generation)
    (up-compare-goal aegis-mc-valid == 0)
=>
    (up-modify-goal aegis-mc-generation g:= aegis-wm-generation)
    (up-modify-goal aegis-mc-request-id g:= aegis-wm-generation)
    (up-modify-goal aegis-mc-request-generation g:= aegis-wm-generation)
    (set-goal aegis-mc-valid 1)
    (set-goal aegis-mc-stage aegis-mc-stage-idle)
    (set-goal aegis-mc-intent aegis-mc-intent-none)
    (set-goal aegis-mc-target-ready 0)
    (set-goal aegis-mc-observed 0)
    (set-goal aegis-mc-failure aegis-mc-failure-none)
    (set-goal aegis-mc-attempts 0)
    (set-goal aegis-mc-reassess-valid 0)
)

; Tactical Micro REASSESS is an acknowledgement boundary only. The exact
; Micro Verification lifecycle generation is recorded once and its publisher
; token is consumed. REASSESS never creates the next Micro Control generation.
; Micro Control owns closure of its own lifecycle, so verification must not
; write aegis-mc-valid across the semantic ownership boundary.
(defrule
    (up-compare-goal aegis-mv-reassess-valid == 1)
    (up-compare-goal aegis-mv-reassess-generation == aegis-mv-generation)
    (up-compare-goal aegis-mc-reassess-generation != aegis-mv-reassess-generation)
=>
    (up-modify-goal aegis-mc-reassess-generation g:= aegis-mv-reassess-generation)
    (set-goal aegis-mc-reassess-valid 1)
    (set-goal aegis-mc-valid 0)
    (set-goal aegis-mv-reassess-valid 0)
)

; Threat recovery has priority over engagement and is represented as intent.
(defrule
    (up-compare-goal aegis-mc-valid == 1)
    (up-compare-goal aegis-tr-retreat == 1)
    (up-compare-goal aegis-mc-stage == aegis-mc-stage-idle)
=>
    (set-goal aegis-mc-intent aegis-mc-intent-retreat)
    (set-goal aegis-mc-stage aegis-mc-stage-authorized)
)

; Engage only when threat exists and retreat is not authorized.
(defrule
    (up-compare-goal aegis-mc-valid == 1)
    (up-compare-goal aegis-mc-intent == aegis-mc-intent-none)
    (up-compare-goal aegis-st-threat == aegis-st-threat-cavalry)
    (up-compare-goal aegis-tr-retreat == 0)
    (up-compare-goal aegis-mc-stage == aegis-mc-stage-idle)
=>
    (set-goal aegis-mc-intent aegis-mc-intent-engage)
    (set-goal aegis-mc-stage aegis-mc-stage-search)
)

; A clean frame with no active threat becomes a regroup intent.
(defrule
    (up-compare-goal aegis-mc-valid == 1)
    (up-compare-goal aegis-mc-intent == aegis-mc-intent-none)
    (up-compare-goal aegis-st-threat == aegis-st-threat-none)
    (up-compare-goal aegis-mc-stage == aegis-mc-stage-idle)
=>
    (set-goal aegis-mc-intent aegis-mc-intent-regroup)
    (set-goal aegis-mc-stage aegis-mc-stage-authorized)
)
