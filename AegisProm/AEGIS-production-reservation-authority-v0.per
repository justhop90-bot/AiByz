; AEGIS PRODUCTION RESERVATION AUTHORITY V0.1
; Exclusive conflict authority for AEGIS production opportunities.
; Certified global block: 806-817.
;
; Boundary:
;   - owns exclusive reservation of a conflicting production resource
;   - does not own strategy, producer lifecycle, physical production, world verification,
;     causal confirmation, or strategic success
;
; Normative separation:
;   AUTHORIZATION != RESERVATION
;   RESERVATION != SUCCESS
;   WORLD TRANSITION != CAUSAL ATTRIBUTION
;
; v0.1 resource domain:
;   AEGIS + spearman-line
;
; Producer identities:
;   1 = MILITARY_PRODUCTION
;   2 = CAVALRY_RESPONSE
;
(defconst aegis-pr-generation 806)
(defconst aegis-pr-state 807)
(defconst aegis-pr-reservation-id 808)
(defconst aegis-pr-owner 809)
(defconst aegis-pr-request-id 810)
(defconst aegis-pr-authorization-id 811)
(defconst aegis-pr-authorization-generation 812)
(defconst aegis-pr-valid 813)
(defconst aegis-pr-expiry 814)
(defconst aegis-pr-resource-key 815)
(defconst aegis-pr-unit-line 816)
(defconst aegis-pr-release-reason 817)

(defconst aegis-pr-state-free 0)
(defconst aegis-pr-state-reserved 1)
(defconst aegis-pr-state-in-flight 2)
(defconst aegis-pr-state-release-pending 3)
(defconst aegis-pr-state-released 4)

(defconst aegis-pr-release-none 0)
(defconst aegis-pr-release-completed 1)
(defconst aegis-pr-release-failed 2)
(defconst aegis-pr-release-expired 3)
(defconst aegis-pr-release-stale-generation 4)
(defconst aegis-pr-release-superseded 5)

(defconst aegis-pr-owner-military-production 1)
(defconst aegis-pr-owner-cavalry-response 2)
(defconst aegis-pr-resource-spearman-line 1)
(defconst aegis-pr-unit-spearman-line 1)

; ---------------------------------------------------------------------------
; INITIALIZATION
; ---------------------------------------------------------------------------
; A new authority generation may initialize only when no live reservation
; remains. Active reservations are first fenced by the stale-generation rule.
(defrule
    (up-compare-goal aegis-st-valid == 1)
    (up-compare-goal aegis-pr-generation != aegis-st-generation)
    (up-compare-goal aegis-pr-state == aegis-pr-state-free)
=>
    (up-modify-goal aegis-pr-generation g:= aegis-st-generation)
    (set-goal aegis-pr-reservation-id 0)
    (set-goal aegis-pr-owner 0)
    (set-goal aegis-pr-request-id 0)
    (set-goal aegis-pr-authorization-id 0)
    (set-goal aegis-pr-authorization-generation 0)
    (set-goal aegis-pr-valid 0)
    (set-goal aegis-pr-expiry 0)
    (set-goal aegis-pr-resource-key 0)
    (set-goal aegis-pr-unit-line 0)
    (set-goal aegis-pr-release-reason aegis-pr-release-none)
)

(defrule
    (up-compare-goal aegis-st-valid == 1)
    (up-compare-goal aegis-pr-generation != aegis-st-generation)
    (up-compare-goal aegis-pr-state == aegis-pr-state-released)
=>
    (up-modify-goal aegis-pr-generation g:= aegis-st-generation)
    (set-goal aegis-pr-state aegis-pr-state-free)
    (set-goal aegis-pr-reservation-id 0)
    (set-goal aegis-pr-owner 0)
    (set-goal aegis-pr-request-id 0)
    (set-goal aegis-pr-authorization-id 0)
    (set-goal aegis-pr-authorization-generation 0)
    (set-goal aegis-pr-valid 0)
    (set-goal aegis-pr-expiry 0)
    (set-goal aegis-pr-resource-key 0)
    (set-goal aegis-pr-unit-line 0)
    (set-goal aegis-pr-release-reason aegis-pr-release-none)
)

; ---------------------------------------------------------------------------
; GRANT: MILITARY PRODUCTION
; ---------------------------------------------------------------------------
; Authorization is a prerequisite; it is not granted by this module.
; The reservation ID is request-bound in v0.1. No implicit ownership transfer.
(defrule
    (up-compare-goal aegis-st-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-free)
    (up-compare-goal aegis-pr-valid == 0)
    (up-compare-goal aegis-mp-valid == 1)
    (up-compare-goal aegis-mp-stage == aegis-mp-stage-authorized)
    (up-compare-goal aegis-mp-authorization-valid == 1)
    (up-compare-goal aegis-mp-authorization-generation == aegis-st-generation)
    (up-compare-goal aegis-mp-authorization-id == aegis-mp-request-id)
    (up-compare-goal aegis-mp-unit == aegis-mp-unit-spearman)
=>
    (up-modify-goal aegis-pr-generation g:= aegis-st-generation)
    (up-modify-goal aegis-pr-reservation-id g:= aegis-mp-request-id)
    (up-modify-goal aegis-pr-owner g:= aegis-pr-owner-military-production)
    (up-modify-goal aegis-pr-request-id g:= aegis-mp-request-id)
    (up-modify-goal aegis-pr-authorization-id g:= aegis-mp-authorization-id)
    (up-modify-goal aegis-pr-authorization-generation g:= aegis-mp-authorization-generation)
    (set-goal aegis-pr-valid 1)
    (up-modify-goal aegis-pr-expiry g:= aegis-mp-authorization-expiry)
    (set-goal aegis-pr-resource-key aegis-pr-resource-spearman-line)
    (set-goal aegis-pr-unit-line aegis-pr-unit-spearman-line)
    (set-goal aegis-pr-release-reason aegis-pr-release-none)
    (set-goal aegis-pr-state aegis-pr-state-reserved)
)

; ---------------------------------------------------------------------------
; GRANT: CAVALRY RESPONSE
; ---------------------------------------------------------------------------
; Same exclusive resource. If MP already owns it, this rule cannot match.
(defrule
    (up-compare-goal aegis-st-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-free)
    (up-compare-goal aegis-pr-valid == 0)
    (up-compare-goal aegis-cr-valid == 1)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-authorized)
    (up-compare-goal aegis-cr-authorization-valid == 1)
    (up-compare-goal aegis-cr-authorization-generation == aegis-st-generation)
    (up-compare-goal aegis-cr-authorization-id == aegis-cr-request-id)
=>
    (up-modify-goal aegis-pr-generation g:= aegis-st-generation)
    (up-modify-goal aegis-pr-reservation-id g:= aegis-cr-request-id)
    (up-modify-goal aegis-pr-owner g:= aegis-pr-owner-cavalry-response)
    (up-modify-goal aegis-pr-request-id g:= aegis-cr-request-id)
    (up-modify-goal aegis-pr-authorization-id g:= aegis-cr-authorization-id)
    (up-modify-goal aegis-pr-authorization-generation g:= aegis-cr-authorization-generation)
    (set-goal aegis-pr-valid 1)
    (up-modify-goal aegis-pr-expiry g:= aegis-cr-authorization-expiry)
    (set-goal aegis-pr-resource-key aegis-pr-resource-spearman-line)
    (set-goal aegis-pr-unit-line aegis-pr-unit-spearman-line)
    (set-goal aegis-pr-release-reason aegis-pr-release-none)
    (set-goal aegis-pr-state aegis-pr-state-reserved)
)

; ---------------------------------------------------------------------------
; DENIAL / DEFERRED OWNERSHIP
; ---------------------------------------------------------------------------
; A conflict produces no mutation and therefore cannot revoke or transfer
; the current reservation. The requesting producer remains responsible for
; deciding whether to defer, abandon, or reassess.
; There is intentionally no persistent DENIED state in v0.1.

; ---------------------------------------------------------------------------
; STALE AUTHORIZATION / GENERATION FENCE
; ---------------------------------------------------------------------------
; A reservation can never authorize physical dispatch across generations.
; Keep identity intact until the explicit release rule settles it.
(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-reserved)
    (up-compare-goal aegis-pr-authorization-generation != aegis-st-generation)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-stale-generation)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-authorization-generation != aegis-st-generation)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-stale-generation)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

; Expiry is checked independently of the generation fence. v0.1 uses the
; producer's authorization-expiry token; a zero token is fail-closed.
(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-reserved)
    (up-compare-goal aegis-pr-expiry == 0)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-expired)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-expiry == 0)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-expired)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

; ---------------------------------------------------------------------------
; RESERVED -> IN_FLIGHT
; ---------------------------------------------------------------------------
; Dispatch itself remains owned by the producer. This module observes only
; the producer lifecycle transition after dispatch has been authorized.
(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-reserved)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-military-production)
    (up-compare-goal aegis-mp-stage == aegis-mp-stage-issued)
    (up-compare-goal aegis-mp-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-mp-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-state aegis-pr-state-in-flight)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-reserved)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-cavalry-response)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-issued)
    (up-compare-goal aegis-cr-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-cr-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-state aegis-pr-state-in-flight)
)

; ---------------------------------------------------------------------------
; TERMINAL RELEASE REQUEST
; ---------------------------------------------------------------------------
; Terminal lifecycle outcome is owned by the producer. Reservation authority
; records only the release request and reason; it does not infer success.
(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-military-production)
    (up-compare-goal aegis-mp-stage == aegis-mp-stage-causally-confirmed)
    (up-compare-goal aegis-mp-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-mp-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-completed)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-military-production)
    (up-compare-goal aegis-mp-stage == aegis-mp-stage-failed)
    (up-compare-goal aegis-mp-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-mp-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-failed)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-cavalry-response)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-confirmed)
    (up-compare-goal aegis-cr-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-cr-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-completed)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-in-flight)
    (up-compare-goal aegis-pr-owner == aegis-pr-owner-cavalry-response)
    (up-compare-goal aegis-cr-stage == aegis-cr-stage-failed)
    (up-compare-goal aegis-cr-request-id == aegis-pr-request-id)
    (up-compare-goal aegis-cr-authorization-id == aegis-pr-authorization-id)
=>
    (set-goal aegis-pr-release-reason aegis-pr-release-failed)
    (set-goal aegis-pr-state aegis-pr-state-release-pending)
)

; ---------------------------------------------------------------------------
; RELEASE
; ---------------------------------------------------------------------------
; Identity must match before ownership can be cleared. Release is idempotent.
(defrule
    (up-compare-goal aegis-pr-valid == 1)
    (up-compare-goal aegis-pr-state == aegis-pr-state-release-pending)
    (up-compare-goal aegis-pr-reservation-id == aegis-pr-request-id)
    (up-compare-goal aegis-pr-request-id == aegis-pr-authorization-id)
    (up-compare-goal aegis-pr-authorization-generation == aegis-pr-generation)
=>
    (set-goal aegis-pr-valid 0)
    (set-goal aegis-pr-state aegis-pr-state-released)
)

(defrule
    (up-compare-goal aegis-pr-state == aegis-pr-state-released)
    (up-compare-goal aegis-pr-valid != 0)
=>
    (set-goal aegis-pr-valid 0)
)

; ---------------------------------------------------------------------------
; DISPATCH GATE CONTRACT
; ---------------------------------------------------------------------------
; The producers must include the reservation predicates below in their own
; physical dispatch rules. This authority never executes up-train itself.
;
; MP required reservation gate:
;   aegis-pr-state == RESERVED
;   aegis-pr-valid == 1
;   aegis-pr-owner == MILITARY_PRODUCTION
;   aegis-pr-request-id == aegis-mp-request-id
;   aegis-pr-authorization-id == aegis-mp-authorization-id
;   aegis-pr-authorization-generation == aegis-mp-generation
;   aegis-pr-resource-key == AEGIS:spearman-line
;
; CR uses the identical gate with CAVALRY_RESPONSE producer identity.
;
; No rule in this module sets causal evidence or strategic success.
