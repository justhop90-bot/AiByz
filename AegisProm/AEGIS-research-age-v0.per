; AEGIS RESEARCH/AGE V0 - bounded age transition lifecycle
; Canonical request identity and authorization boundary.
; Native research semantics are preserved: current-age + can-research +
; resource feasibility authorize the research request; completion is verified
; from the engine-facing current-age fact, never from command issuance.
(defconst aegis-ra-generation 600)
(defconst aegis-ra-valid 601)
(defconst aegis-ra-stage 602)
(defconst aegis-ra-attempts 603)
(defconst aegis-ra-baseline-age 604)
(defconst aegis-ra-observed-age 605)
(defconst aegis-ra-request-id 606)
(defconst aegis-ra-authorization-id 607)
(defconst aegis-ra-authorization-generation 608)
(defconst aegis-ra-authorization-valid 609)
(defconst aegis-ra-authorization-expiry 610)
(defconst aegis-ra-world-evidence 611)
(defconst aegis-ra-causal-evidence 612)
(defconst aegis-ra-reassess-generation 766)
(defconst aegis-ra-reassess-valid 767)
(defconst aegis-ra-stage-idle 0)
(defconst aegis-ra-stage-authorized 1)
(defconst aegis-ra-stage-issued 2)
(defconst aegis-ra-stage-confirmed 3)
(defconst aegis-ra-stage-failed 4)
(defconst aegis-ra-failure-none 0)
(defconst aegis-ra-failure-not-feasible 1)
(defconst aegis-ra-failure-stale-authorization 2)
(defconst aegis-ra-failure-transition-unobserved 3)

(defrule
    (up-compare-goal aegis-wm-valid == 1)
    (up-compare-goal aegis-ra-valid == 0)
    (up-compare-goal aegis-ra-generation != aegis-wm-generation)
=>
    (up-modify-goal aegis-ra-generation g:= aegis-wm-generation)
    (up-modify-goal aegis-ra-request-id g:= aegis-wm-generation)
    (up-modify-goal aegis-ra-authorization-id g:= aegis-wm-generation)
    (up-modify-goal aegis-ra-authorization-generation g:= aegis-wm-generation)
    (up-modify-goal aegis-ra-authorization-expiry g:= aegis-wm-generation)
    (set-goal aegis-ra-authorization-valid 0)
    (set-goal aegis-ra-stage aegis-ra-stage-idle)
    (set-goal aegis-ra-attempts 0)
    (set-goal aegis-ra-baseline-age 0)
    (set-goal aegis-ra-observed-age 0)
    (set-goal aegis-ra-world-evidence 0)
    (set-goal aegis-ra-causal-evidence 0)
    (set-goal aegis-ra-failure aegis-ra-failure-none)
    (set-goal aegis-ra-valid 1)
)

(defrule
    (up-compare-goal aegis-ra-valid == 1)
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-idle)
    (up-compare-goal aegis-ra-authorization-valid == 0)
    (current-age == feudal-age)
    (can-research castle-age)
    (up-compare-goal aegis-wm-food >= 800)
    (up-compare-goal aegis-wm-gold >= 200)
=>
    (set-goal aegis-ra-baseline-age 2)
    (set-goal aegis-ra-authorization-valid 1)
    (set-goal aegis-ra-stage aegis-ra-stage-authorized)
)

(defrule
    (up-compare-goal aegis-ra-valid == 1)
    (up-compare-goal aegis-ra-authorization-valid == 1)
    (up-compare-goal aegis-ra-authorization-generation != aegis-wm-generation)
=>
    (set-goal aegis-ra-authorization-valid 0)
    (set-goal aegis-ra-failure aegis-ra-failure-stale-authorization)
    (set-goal aegis-ra-stage aegis-ra-stage-failed)
    (set-goal aegis-ra-valid 0)
)

(defrule
    (up-compare-goal aegis-ra-valid == 1)
    (up-compare-goal aegis-ra-authorization-valid == 1)
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-authorized)
    (up-compare-goal aegis-ra-attempts < 1)
    (can-research castle-age)
=>
    (research castle-age)
    (up-modify-goal aegis-ra-attempts g:+ 1)
    (set-goal aegis-ra-stage aegis-ra-stage-issued)
    (set-goal aegis-ra-authorization-valid 0)
)

(defrule
    (up-compare-goal aegis-ra-valid == 1)
    (up-compare-goal aegis-ra-authorization-valid == 1)
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-authorized)
    (up-compare-goal aegis-ra-attempts < 1)
    (not (can-research castle-age))
=>
    (set-goal aegis-ra-failure aegis-ra-failure-not-feasible)
    (set-goal aegis-ra-stage aegis-ra-stage-failed)
    (set-goal aegis-ra-authorization-valid 0)
    (set-goal aegis-ra-valid 0)
)

(defrule
    (up-compare-goal aegis-ra-valid == 1)
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-issued)
    (current-age >= castle-age)
=>
    (up-modify-goal aegis-ra-observed-age g:= castle-age)
    (set-goal aegis-ra-world-evidence 1)
    (set-goal aegis-ra-stage aegis-ra-stage-confirmed)
    (set-goal aegis-ra-valid 0)
)

; Canonical reassessment boundary. The age-transition owner emits only the
; terminal lifecycle generation; it does not decide the next strategic action.
(defrule
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-confirmed)
    (up-compare-goal aegis-ra-reassess-generation != aegis-ra-generation)
=>
    (up-modify-goal aegis-ra-reassess-generation g:= aegis-ra-generation)
    (set-goal aegis-ra-reassess-valid 1)
)

(defrule
    (up-compare-goal aegis-ra-stage == aegis-ra-stage-failed)
    (up-compare-goal aegis-ra-reassess-generation != aegis-ra-generation)
=>
    (up-modify-goal aegis-ra-reassess-generation g:= aegis-ra-generation)
    (set-goal aegis-ra-reassess-valid 1)
)
