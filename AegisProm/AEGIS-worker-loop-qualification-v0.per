; AEGIS WORKER LOOP QUALIFICATION V0
; Candidate - NOT LOADED by production root.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: expose a minimal cross-module generation heartbeat for dynamic qualification.
; This is a qualification instrument, not production economy logic.

(defconst aegis-wlq-generation 555)
(defconst aegis-wlq-valid 556)
(defconst aegis-wlq-stage 557)
(defconst aegis-wlq-progress 558)
(defconst aegis-wlq-cycle 559)

(defconst aegis-wlq-stage-init 0)
(defconst aegis-wlq-stage-observed 1)
(defconst aegis-wlq-stage-qualified 2)

; Consume the upstream recovery generation only when it is validly closed.
; This instrument records progress without issuing a task command.
(defrule
    (up-compare-goal aegis-wr-valid == 0)
    (up-compare-goal aegis-wr-stage == aegis-wr-stage-closed)
    (up-compare-goal aegis-wlq-generation != aegis-wr-generation)
=>
    (set-goal aegis-wlq-valid 0)
    (set-goal aegis-wlq-stage aegis-wlq-stage-observed)
    (up-modify-goal aegis-wlq-generation g:= aegis-wr-generation)
    (up-modify-goal aegis-wlq-progress g:+ 1)
    (up-modify-goal aegis-wlq-cycle g:+ 1)
    (set-goal aegis-wlq-stage aegis-wlq-stage-qualified)
    (set-goal aegis-wlq-valid 1)
)