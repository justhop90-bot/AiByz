; AEGIS WORKER RECOVERY V0
; Final runtime module - loaded by AEGIS-BYZ.per.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: convert verified worker-task failures into bounded re-arbitration requests.
; Recovery never directly issues a replacement gathering command.
; Archaeologist: failure disposition is based on observed verification state.
; Byzantine Architect: preserve economic continuity without uncontrolled worker churn.
; AI(HD)+Promisory: distinguish retryable interruption from upstream/source failure.

(defconst aegis-wr-generation 546)
(defconst aegis-wr-valid 547)
(defconst aegis-wr-stage 548)
(defconst aegis-wr-resource 549)
(defconst aegis-wr-failure 555)
(defconst aegis-wr-attempts 556)
(defconst aegis-wr-disposition 552)
(defconst aegis-wr-observed-at 553)
(defconst aegis-wr-cycle 554)
(defconst aegis-wr-stage-init 0)
(defconst aegis-wr-stage-review 1)
(defconst aegis-wr-stage-retry 2)
(defconst aegis-wr-stage-upstream 3)
(defconst aegis-wr-stage-closed 4)
(defconst aegis-wr-disposition-none 0)
(defconst aegis-wr-disposition-retry 1)
(defconst aegis-wr-disposition-upstream 2)
(defconst aegis-wr-max-attempts 2)

; Capture a new verification failure without directly reissuing a command.
(defrule
    (up-compare-goal aegis-wtv-valid == 0)
    (up-compare-goal aegis-wtv-stage == aegis-wtv-stage-failed)
    (up-compare-goal aegis-wr-generation != aegis-wtc-generation)
=>
    (set-goal aegis-wr-valid 1)
    (set-goal aegis-wr-stage aegis-wr-stage-review)
    (up-modify-goal aegis-wr-generation g:= aegis-wtc-generation)
    (up-modify-goal aegis-wr-resource g:= aegis-wtc-resource)
    (up-modify-goal aegis-wr-failure g:= aegis-wtv-failure)
    (up-modify-goal aegis-wr-attempts g:= aegis-wtc-attempts)
    (up-modify-goal aegis-wr-observed-at g:= aegis-wtv-observed-at)
    (up-modify-goal aegis-wr-cycle g:+ 1)
    (set-goal aegis-wr-disposition aegis-wr-disposition-none)
)

; Interrupted workers are retryable only while the bounded attempt budget remains.
(defrule
    (up-compare-goal aegis-wr-valid == 1)
    (up-compare-goal aegis-wr-stage == aegis-wr-stage-review)
    (up-compare-goal aegis-wr-failure == aegis-wtv-failure-target-not-observed)
    (up-compare-goal aegis-wr-attempts < aegis-wr-max-attempts)
=>
    (set-goal aegis-wr-disposition aegis-wr-disposition-retry)
    (set-goal aegis-wr-stage aegis-wr-stage-retry)
)

; Worker loss or exhausted retry budget returns control upstream to arbitration.
(defrule
    (up-compare-goal aegis-wr-valid == 1)
    (up-compare-goal aegis-wr-stage == aegis-wr-stage-review)
    (or
        (up-compare-goal aegis-wr-failure == aegis-wtv-failure-worker-missing)
        (up-compare-goal aegis-wr-attempts >= aegis-wr-max-attempts))
=>
    (set-goal aegis-wr-disposition aegis-wr-disposition-upstream)
    (set-goal aegis-wr-stage aegis-wr-stage-upstream)
)

; Recovery closes without issuing an uncontrolled replacement command.
(defrule
    (up-compare-goal aegis-wr-valid == 1)
    (up-compare-goal aegis-wr-stage == aegis-wr-stage-retry)
=>
    (set-goal aegis-wr-stage aegis-wr-stage-closed)
    (set-goal aegis-wr-valid 0)
)

(defrule
    (up-compare-goal aegis-wr-valid == 1)
    (up-compare-goal aegis-wr-stage == aegis-wr-stage-upstream)
=>
    (set-goal aegis-wr-stage aegis-wr-stage-closed)
    (set-goal aegis-wr-valid 0)
)
