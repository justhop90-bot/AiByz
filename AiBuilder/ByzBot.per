            (or
                (players-unit-type-count any-enemy cavalry-archer-line >= byz-ranged-threat)
                (players-unit-type-count any-enemy hand-cannoneer >= byz-ranged-threat))))
    (nor
        (or
            (players-unit-type-count any-enemy knight-line >= byz-cavalry-threat)
            (or
                (players-unit-type-count any-enemy scout-cavalry-line >= byz-cavalry-threat)
                (or
                    (players-unit-type-count any-enemy camel-line >= byz-cavalry-threat)
                    (players-unit-type-count any-enemy battle-elephant-line >= byz-cavalry-threat))))
        (or
            (players-unit-type-count any-enemy militia-line >= byz-infantry-threat)
            (or
                (players-unit-type-count any-enemy spearman-line >= byz-infantry-threat)
                (or
                    (players-unit-type-count any-enemy pikeman-line >= byz-infantry-threat)
                    (or
                        (players-unit-type-count any-enemy two-handed-swordsman-line >= byz-infantry-threat)
                        (players-unit-type-count any-enemy halberdier-line >= byz-infantry-threat)))))
=>
    (set-goal desired-number-skirmishers 12)
    (set-goal desired-number-camelriders 4)
    (set-goal desired-number-barracks 1)
    (set-goal desired-number-ranges 2)
    (set-goal desired-number-stables 1)
    (set-goal desired-number-workshops 1))

