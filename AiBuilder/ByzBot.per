;*********************************************************************************************
; ByzBot v1.3 - Byzantine composition + production-capacity + military-tech policy
;*********************************************************************************************
;
; PURPOSE
;   Convert observed enemy military composition into simultaneous
;   desired-number-* Goals, scale the production-building Goals required
;   to sustain that composition, and synchronize the existing AIBuilder
;   military-technology policy Goals with the active composition.
;   AiBuilder remains responsible for feasibility, construction, training,
;   and research execution.
;
; ARCHITECTURE
;   Observation -> Byzantine composition policy -> desired unit Goals
;   -> production-capacity Goals + military-policy Goals
;   -> existing AiBuilder executors.
;
; v1.3 SCOPE
;   - Detect cavalry, ranged, and infantry from sighted enemy unit lines.
;   - Detect mixed threats when at least two threat classes are present.
;   - Project simultaneous Byzantine composition requirements into the
;     existing spearman, skirmisher, archer, camel, and mangonel Goals.
;   - Scale existing barracks, range, stable, and workshop Goals from the
;     active composition branch.
;   - Synchronize existing upgrade-military-lines, upgrade-military-smith,
;     upgrade-military-generic, and upgrade-military-villager-requirement
;     Goals with an active military composition.
;   - No direct train/build/research commands.
;   - No new Goals.
;   - No scratch goals / temporary registers.
;   - No attack commands.
;   - No economic overrides.
;
; EVIDENCE / VISIBILITY
;   players-unit-type-count is sighted-unit evidence, not omniscient state.
;   The thresholds below are policy constants, not engine-defined threat
;   classifications. They deliberately use unit lines so upgraded units
;   remain part of the observed composition class.
;
; MILITARY TECHNOLOGY POLICY
;   Active military-composition branches enable the existing AIBuilder
;   military technology channels:
;     upgrade-military-lines  -> unit-line upgrades
;     upgrade-military-smith  -> blacksmith military upgrades
;     upgrade-military-generic -> generic military/siege/other military tech
;   The existing villager requirement remains 10, matching the AIBuilder
;   phase policy. technologies.per remains the sole research executor.
;
; COMPOSITION + CAPACITY POLICY
;   Cavalry-only  -> 12 spears + 6 camels; 2 barracks + 2 stables.
;   Ranged-only   -> 12 skirms + 4 camels; 1 barracks + 2 ranges + 1 stable.
;   Infantry-only -> 12 archers + 2 mangonels; 2 barracks + 2 ranges + 1 workshop.
;   Mixed         -> 12 spears + 12 skirms + 8 archers + 6 camels + 2 mangonels;
;                    2 barracks + 2 ranges + 2 stables + 1 workshop.
;
;   Capacity values are deliberate v1 policy constants, not claims about
;   optimal economy or engine throughput. The purpose is to connect the
;   composition decision to enough production infrastructure to execute it.
;
; IMPORTANT
;   These rules only write existing AIBuilder Goal channels. They do not
;   alter militaryUnits.per, construction.per, or technology executors.
;   Goal persistence/precedence remains a known engine-semantic boundary;
;   this implementation intentionally does not add arbitration machinery.
;   Rules are deliberately split so the DE 32-element rule limit is not
;   exceeded by the nested threat classification plus action list.
;*********************************************************************************************

; Policy thresholds: sighted enemy units required to classify a threat.
(defconst byz-cavalry-threat 4)
(defconst byz-ranged-threat 4)
(defconst byz-infantry-threat 6)

;---------------------------------------------------------------------------------------------
; CAVALRY-ONLY COMPOSITION + CAPACITY
;---------------------------------------------------------------------------------------------
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= byz-cavalry-threat)
        (or
            (players-unit-type-count any-enemy scout-cavalry-line >= byz-cavalry-threat)
            (or
                (players-unit-type-count any-enemy camel-line >= byz-cavalry-threat)
                (players-unit-type-count any-enemy battle-elephant-line >= byz-cavalry-threat))))
    (nor
        (or
            (players-unit-type-count any-enemy archer-line >= byz-ranged-threat)
            (or
                (players-unit-type-count any-enemy skirmisher-line >= byz-ranged-threat)
                (or
                    (players-unit-type-count any-enemy cavalry-archer-line >= byz-ranged-threat)
                    (players-unit-type-count any-enemy hand-cannoneer >= byz-ranged-threat))))
        (or
            (players-unit-type-count any-enemy militia-line >= byz-infantry-threat)
            (or
                (players-unit-type-count any-enemy spearman-line >= byz-infantry-threat)
                (or
                    (players-unit-type-count any-enemy pikeman-line >= byz-infantry-threat)
                    (or
                        (players-unit-type-count any-enemy two-handed-swordsman-line >= byz-infantry-threat)
                        (players-unit-type-count any-enemy halberdier-line >= byz-infantry-threat)))))
=>
    (set-goal desired-number-spearmen 12)
    (set-goal desired-number-camelriders 6)
    (set-goal desired-number-barracks 2)
    (set-goal desired-number-ranges 1)
    (set-goal desired-number-stables 2)
    (set-goal desired-number-workshops 1))

; CAVALRY MILITARY TECHNOLOGY SYNCHRONIZATION
(defrule
    (or
        (players-unit-type-count any-enemy knight-line >= byz-cavalry-threat)
        (or
            (players-unit-type-count any-enemy scout-cavalry-line >= byz-cavalry-threat)
            (or
                (players-unit-type-count any-enemy camel-line >= byz-cavalry-threat)
                (players-unit-type-count any-enemy battle-elephant-line >= byz-cavalry-threat))))
    (nor
        (or
            (players-unit-type-count any-enemy archer-line >= byz-ranged-threat)
            (or
                (players-unit-type-count any-enemy skirmisher-line >= byz-ranged-threat)
                (or
                    (players-unit-type-count any-enemy cavalry-archer-line >= byz-ranged-threat)
                    (players-unit-type-count any-enemy hand-cannoneer >= byz-ranged-threat))))
        (or
            (players-unit-type-count any-enemy militia-line >= byz-infantry-threat)
            (or
                (players-unit-type-count any-enemy spearman-line >= byz-infantry-threat)
                (or
                    (players-unit-type-count any-enemy pikeman-line >= byz-infantry-threat)
                    (or
                        (players-unit-type-count any-enemy two-handed-swordsman-line >= byz-infantry-threat)
                        (players-unit-type-count any-enemy halberdier-line >= byz-infantry-threat)))))
=>
    (set-goal upgrade-military-lines 1)
    (set-goal upgrade-military-smith 1)
    (set-goal upgrade-military-generic 1)
    (set-goal upgrade-military-villager-requirement 10))

;---------------------------------------------------------------------------------------------
; RANGED-ONLY COMPOSITION + CAPACITY
