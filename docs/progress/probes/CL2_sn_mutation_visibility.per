; AEGIS PROBE CL-2 — Strategic-number mutation visibility
; SKELETON ONLY — NOT PRODUCTION
; Target: AoE2DE 101.103.48987.0
; Purpose: measure when an SN write becomes visible to later rules.

(defconst probe-cl2-generation 19011)
(defconst probe-cl2-value 19012)
(defconst probe-cl2-observed 19013)
(defconst probe-cl2-stage 19014)

; NOTE: Use a deliberately high experimental SN index when filling this skeleton.
; Do not reuse stock SNs. Replace the placeholder below after choosing a safe probe SN.

(defrule
    (true)
=>
    (set-goal probe-cl2-generation 1)
    (set-goal probe-cl2-value 0)
    (set-goal probe-cl2-observed 0)
    (set-goal probe-cl2-stage 0)
    (disable-self)
)

; Writer — replace with real set-strategic-number once a probe SN is chosen
(defrule
    (up-compare-goal probe-cl2-stage == 0)
=>
    ; (set-strategic-number <probe-sn> 77)
    (set-goal probe-cl2-value 77)
    (set-goal probe-cl2-stage 1)
)

; Observer
(defrule
    (up-compare-goal probe-cl2-stage == 1)
    (up-compare-goal probe-cl2-value == 77)
=>
    (set-goal probe-cl2-observed 1)
    (set-goal probe-cl2-stage 2)
)
