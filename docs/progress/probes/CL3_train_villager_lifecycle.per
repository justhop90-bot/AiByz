; ============================================================
; AEGIS PROBE CL-3 — Train Villager Lifecycle
; FIXED RUNNABLE VERSION — 2026-09-09
; NOT PRODUCTION CODE
; Target: AoE2DE 101.103.48987.0
;
; Fix: replaced invalid (train villager) with the up-train form
; already used by the project's own candidate code.
; ============================================================

(defconst probe-cl3-generation 19101)
(defconst probe-cl3-valid 19102)
(defconst probe-cl3-stage 19103)
(defconst probe-cl3-baseline 19104)
(defconst probe-cl3-current 19105)
(defconst probe-cl3-pending 19106)
(defconst probe-cl3-attempts 19107)

; Stage meanings:
; 0 = starting / capture baseline
; 1 = ready to train
; 2 = train command issued
; 3 = pending villager seen
; 4 = SUCCESS - new villager appeared
; 5 = FAILED

; Startup
(defrule
    (true)
=>
    (set-goal probe-cl3-generation 1)
    (set-goal probe-cl3-valid 1)
    (set-goal probe-cl3-stage 0)
    (set-goal probe-cl3-baseline 0)
    (set-goal probe-cl3-current 0)
    (set-goal probe-cl3-pending 0)
    (set-goal probe-cl3-attempts 0)
    (chat-to-all "CL3: Probe starting - Villager train test")
    (disable-self)
)

; Capture baseline villager count
(defrule
    (up-compare-goal probe-cl3-stage == 0)
=>
    (up-get-fact unit-type-count villager probe-cl3-baseline)
    (set-goal probe-cl3-stage 1)
    (chat-to-all "CL3: Baseline villager count captured")
)

; Try to train (using the same form as the project's own v0 code)
(defrule
    (up-compare-goal probe-cl3-stage == 1)
    (up-compare-goal probe-cl3-attempts < 1)
    (can-train villager)
    (building-type-count town-center >= 1)
=>
    (up-train escrow-state c: villager)
    (up-modify-goal probe-cl3-attempts g:+ 1)
    (set-goal probe-cl3-stage 2)
    (chat-to-all "CL3: Train command ISSUED")
)

; Cannot train right now
(defrule
    (up-compare-goal probe-cl3-stage == 1)
    (up-compare-goal probe-cl3-attempts < 1)
    (not (can-train villager))
=>
    (chat-to-all "CL3: Cannot train yet - need food, TC, or pop space")
    (up-modify-goal probe-cl3-attempts g:+ 1)
    (set-goal probe-cl3-stage 5)
)

; Detect pending production
(defrule
    (up-compare-goal probe-cl3-stage == 2)
    (up-pending-objects c: villager >= 1)
=>
    (set-goal probe-cl3-pending 1)
    (set-goal probe-cl3-stage 3)
    (chat-to-all "CL3: PENDING villager detected")
)

; Check for success after pending
(defrule
    (up-compare-goal probe-cl3-stage == 3)
=>
    (up-get-fact unit-type-count villager probe-cl3-current)
)

(defrule
    (up-compare-goal probe-cl3-stage == 3)
    (up-compare-goal probe-cl3-current > probe-cl3-baseline)
=>
    (set-goal probe-cl3-stage 4)
    (chat-to-all "CL3: SUCCESS - New villager appeared")
    (chat-to-all "CL3: Train lifecycle works")
)

; Also check for success directly (in case pending was very fast)
(defrule
    (up-compare-goal probe-cl3-stage == 2)
=>
    (up-get-fact unit-type-count villager probe-cl3-current)
)

(defrule
    (up-compare-goal probe-cl3-stage == 2)
    (up-compare-goal probe-cl3-current > probe-cl3-baseline)
=>
    (set-goal probe-cl3-stage 4)
    (chat-to-all "CL3: SUCCESS - New villager appeared")
    (chat-to-all "CL3: Train lifecycle works")
)

; Failure if we issued but nothing happened
(defrule
    (up-compare-goal probe-cl3-stage == 2)
    (up-compare-goal probe-cl3-attempts >= 1)
    (up-pending-objects c: villager <= 0)
    (up-compare-goal probe-cl3-current <= probe-cl3-baseline)
=>
    (set-goal probe-cl3-stage 5)
    (chat-to-all "CL3: FAILED - No villager appeared")
)
