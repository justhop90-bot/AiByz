    (up-compare-goal aegis-eda-selected-resource == aegis-eda-resource-gold)
    (up-compare-goal aegis-eda-urgency == aegis-eda-urgency-normal)
=>
    (set-goal desired-food-gatherers 45)
    (set-goal desired-wood-gatherers 25)
    (set-goal desired-gold-gatherers 30)
    (set-goal desired-stone-gatherers 0))

