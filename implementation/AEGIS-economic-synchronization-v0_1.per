; AEGIS ECONOMIC SYNCHRONIZATION V0.1
; Competency 5.3 candidate bridge - NOT LOADED by production root.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
;
; Contract:
;   worker/resource demand -> deterministic arbitration -> existing
;   AIBuilder desired gatherer Goals -> economy.per executor.
;
; Ownership:
;   AEGIS economic-demand owns demand.
;   AEGIS economic-demand-arbitration owns selection.
;   This module owns only projection into existing AIBuilder gatherer Goals.
;   economy.per remains the physical gatherer-policy executor.
;
; Evidence:
;   DIRECT: AIBuilder economy.per consumes desired gatherer Goals.
;   DIRECT: AIRef defines set-goal and up-compare-goal; up-resource-amount
;           is available upstream but is intentionally not duplicated here.
;   COMPOSED: HD uses explicit staged gatherer percentages and demand gates.
;   CANDIDATE: percentage profiles below are AEGIS policy, not engine constants.
;
; No new Goals, SNs, timers, commands, worker retasking, or direct economy
; execution are introduced. Production root must not load this candidate until
; ABI/ownership/lifecycle gates permit promotion.
; ------------------------------------------------------------

; Normal-priority food demand.
(defrule
    (up-compare-goal aegis-eda-valid == 1)
    (up-compare-goal aegis-eda-selected-resource == aegis-eda-resource-food)
    (up-compare-goal aegis-eda-urgency == aegis-eda-urgency-normal)
=>
    (set-goal desired-food-gatherers 50)
    (set-goal desired-wood-gatherers 30)
    (set-goal desired-gold-gatherers 20)
    (set-goal desired-stone-gatherers 0))

; Normal-priority wood demand.
(defrule
    (up-compare-goal aegis-eda-valid == 1)
    (up-compare-goal aegis-eda-selected-resource == aegis-eda-resource-wood)
    (up-compare-goal aegis-eda-urgency == aegis-eda-urgency-normal)
=>
    (set-goal desired-food-gatherers 40)
    (set-goal desired-wood-gatherers 40)
    (set-goal desired-gold-gatherers 20)
    (set-goal desired-stone-gatherers 0))

; Normal-priority gold demand.
(defrule
