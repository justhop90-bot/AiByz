    (up-compare-goal aegis-eda-selected-resource == aegis-eda-resource-food)
    (up-compare-goal aegis-eda-urgency == aegis-eda-urgency-high)
=>
    (set-goal desired-food-gatherers 55)
    (set-goal desired-wood-gatherers 25)
    (set-goal desired-gold-gatherers 20)
    (set-goal desired-stone-gatherers 0))

