; AEGIS SOURCE/DROPSITE SERVICEABILITY V0
; Candidate - NOT LOADED by production root.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: qualify whether a resource demand has a usable source/service relation.
; This module does not issue gathering commands.
; Archaeologist: preserves stock source search, task-load, and dropsite-distance boundaries.
; Byzantine Architect: resource access is strategic infrastructure, not merely a count.
; AI(HD)+Promisory: source failure must remain distinguishable from worker failure.

(defconst aegis-sds-generation 499)
(defconst aegis-sds-valid 500)
(defconst aegis-sds-stage 501)
(defconst aegis-sds-resource 502)
(defconst aegis-sds-source-count 503)
(defconst aegis-sds-source-load 504)
(defconst aegis-sds-dropsite-distance 505)
(defconst aegis-sds-serviceable 506)
(defconst aegis-sds-failure 507)
(defconst aegis-sds-observed-at 508)
(defconst aegis-sds-cycle 509)

(defconst aegis-sds-stage-init 0)
(defconst aegis-sds-stage-searching 1)
(defconst aegis-sds-stage-qualified 2)
(defconst aegis-sds-stage-failed 3)
(defconst aegis-sds-resource-none 0)
(defconst aegis-sds-resource-food 1)
(defconst aegis-sds-resource-wood 2)
(defconst aegis-sds-resource-gold 3)
(defconst aegis-sds-resource-stone 4)
(defconst aegis-sds-failure-none 0)
(defconst aegis-sds-failure-no-source 1)
(defconst aegis-sds-failure-overloaded 2)
(defconst aegis-sds-failure-dropsite 3)

; Start one serviceability frame from the arbitrated demand.
(defrule
    (up-compare-goal aegis-eda-valid == 1)
    (up-compare-goal aegis-sds-generation != aegis-eda-generation)
=>
    (set-goal aegis-sds-valid 0)
    (set-goal aegis-sds-stage aegis-sds-stage-searching)
    (set-goal aegis-sds-resource aegis-eda-resource)
    (up-modify-goal aegis-sds-generation g:= aegis-eda-generation)
    (up-modify-goal aegis-sds-observed-at g:= aegis-eda-observed-at)
    (up-modify-goal aegis-sds-cycle g:+ 1)
    (set-goal aegis-sds-source-count 0)
    (set-goal aegis-sds-source-load 0)
    (set-goal aegis-sds-dropsite-distance 0)
    (set-goal aegis-sds-serviceable 0)
    (set-goal aegis-sds-failure aegis-sds-failure-none)
    (set-goal aegis-sds-valid 1)
)

; Wood: stock explicitly finds wood resources and rejects remote objects
; carrying two or more tasks. V0 records source existence/load only.
(defrule
    (up-compare-goal aegis-sds-valid == 1)
    (up-compare-goal aegis-sds-stage == aegis-sds-stage-searching)
    (up-compare-goal aegis-sds-resource == aegis-sds-resource-wood)
=>
    (up-full-reset-search)
    (up-find-resource c: wood c: 8)
    (up-remove-objects search-remote object-data-tasks-count >= 2)
    (up-get-search-state remote-total aegis-sds-source-count)
    (set-goal aegis-sds-serviceable 0)
    (set-goal aegis-sds-failure aegis-sds-failure-no-source)
    (set-goal aegis-sds-stage aegis-sds-stage-qualified)
)

; Gold/stone: use the engine's resource search and expose a bounded source count.
; Exact resource-load thresholds remain resource/controller-specific.
(defrule
    (up-compare-goal aegis-sds-valid == 1)
    (up-compare-goal aegis-sds-stage == aegis-sds-stage-searching)
    (or
        (up-compare-goal aegis-sds-resource == aegis-sds-resource-gold)
        (up-compare-goal aegis-sds-resource == aegis-sds-resource-stone))
=>
    (up-full-reset-search)
    (up-find-resource c: gold c: 8)
    (up-get-search-state remote-total aegis-sds-source-count)
    (set-goal aegis-sds-serviceable 0)
    (set-goal aegis-sds-failure aegis-sds-failure-no-source)
    (set-goal aegis-sds-stage aegis-sds-stage-qualified)
)

; V0 does not invent a universal food resource class or dropsite distance.
; Food portfolio serviceability is deferred to the food-source adapter.
(defrule
    (up-compare-goal aegis-sds-valid == 1)
    (up-compare-goal aegis-sds-stage == aegis-sds-stage-searching)
    (up-compare-goal aegis-sds-resource == aegis-sds-resource-food)
=>
    (set-goal aegis-sds-failure aegis-sds-failure-no-source)
    (set-goal aegis-sds-stage aegis-sds-stage-qualified)
)