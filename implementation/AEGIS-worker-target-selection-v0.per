; AEGIS WORKER TARGET SELECTION V0
; Candidate - NOT LOADED by production root.
; Target: AoE2DE 101.103.48987.0 / BuildID 24094652
; Purpose: select eligible civilian candidates for one economic role.
; This module selects; it does not choose a resource source and does not issue a task command.
; Archaeologist: candidate selection follows observed stock search/filter contracts.
; Byzantine Architect: strategic demand remains upstream; selection cannot override demand.
; AI(HD)+Promisory: preserve worker protection and interruption-aware filtering.

(defconst aegis-wts-generation 490)
(defconst aegis-wts-valid 491)
(defconst aegis-wts-stage 492)
(defconst aegis-wts-resource 493)
(defconst aegis-wts-needed 494)
(defconst aegis-wts-selected 495)
(defconst aegis-wts-observed-at 496)
(defconst aegis-wts-cycle 497)
(defconst aegis-wts-candidates 498)
(defconst aegis-wts-stage-init 0)
(defconst aegis-wts-stage-searching 1)
(defconst aegis-wts-stage-qualified 2)
(defconst aegis-wts-resource-none 0)
(defconst aegis-wts-resource-food 1)
(defconst aegis-wts-resource-wood 2)
(defconst aegis-wts-resource-gold 3)
(defconst aegis-wts-resource-stone 4)

; Start one selection frame from the arbitrated demand generation.
(defrule
    (up-compare-goal aegis-eda-valid == 1)
    (up-compare-goal aegis-wts-generation != aegis-eda-generation)
=>
    (set-goal aegis-wts-valid 0)
    (set-goal aegis-wts-stage aegis-wts-stage-searching)
    (set-goal aegis-wts-resource aegis-eda-resource)
    (up-modify-goal aegis-wts-needed g:= aegis-eda-demand)
    (set-goal aegis-wts-selected 0)
    (set-goal aegis-wts-candidates 0)
    (up-modify-goal aegis-wts-generation g:= aegis-eda-generation)
    (up-modify-goal aegis-wts-observed-at g:= aegis-eda-observed-at)
    (up-modify-goal aegis-wts-cycle g:+ 1)
    (set-goal aegis-wts-valid 1)
)

; Food candidates use the engine's food-role classification. The search is
; deliberately bounded and excludes workers already carrying resources.
(defrule
    (up-compare-goal aegis-wts-valid == 1)
    (up-compare-goal aegis-wts-stage == aegis-wts-stage-searching)
    (up-compare-goal aegis-wts-resource == aegis-wts-resource-food)
    (unit-type-count villager-food >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: villager-food g: aegis-wts-needed)
    (up-remove-objects search-local object-data-carry >= 1)
    (up-remove-objects search-local object-data-order == orderid-build)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-get-search-state local-total aegis-wts-candidates)
    (set-goal aegis-wts-stage aegis-wts-stage-qualified)
)

; Wood candidates preserve the stock distinction between role classification
; and target/source selection. No tree target is selected here.
(defrule
    (up-compare-goal aegis-wts-valid == 1)
    (up-compare-goal aegis-wts-stage == aegis-wts-stage-searching)
    (up-compare-goal aegis-wts-resource == aegis-wts-resource-wood)
    (unit-type-count villager-wood >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: villager-wood g: aegis-wts-needed)
    (up-remove-objects search-local object-data-carry >= 1)
    (up-remove-objects search-local object-data-order == orderid-build)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-get-search-state local-total aegis-wts-candidates)
    (set-goal aegis-wts-stage aegis-wts-stage-qualified)
)

; Gold and stone use the same candidate boundary. Resource-source selection
; and dropsite qualification remain downstream services.
(defrule
    (up-compare-goal aegis-wts-valid == 1)
    (up-compare-goal aegis-wts-stage == aegis-wts-stage-searching)
    (up-compare-goal aegis-wts-resource == aegis-wts-resource-gold)
    (unit-type-count villager-gold >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: villager-gold g: aegis-wts-needed)
    (up-remove-objects search-local object-data-carry >= 1)
    (up-remove-objects search-local object-data-order == orderid-build)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-get-search-state local-total aegis-wts-candidates)
    (set-goal aegis-wts-stage aegis-wts-stage-qualified)
)

(defrule
    (up-compare-goal aegis-wts-valid == 1)
    (up-compare-goal aegis-wts-stage == aegis-wts-stage-searching)
    (up-compare-goal aegis-wts-resource == aegis-wts-resource-stone)
    (unit-type-count villager-stone >= 1)
=>
    (up-full-reset-search)
    (up-find-local c: villager-stone g: aegis-wts-needed)
    (up-remove-objects search-local object-data-carry >= 1)
    (up-remove-objects search-local object-data-order == orderid-build)
    (up-clean-search search-local object-data-distance search-order-asc)
    (up-get-search-state local-total aegis-wts-candidates)
    (set-goal aegis-wts-stage aegis-wts-stage-qualified)
)