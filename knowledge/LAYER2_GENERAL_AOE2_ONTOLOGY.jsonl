{"id":"ONT-001","entity":"ACTOR","class":"STATE_ENTITY","definition":"A player-controlled strategic system: self, opponent, or ally.","relations":["owns_capability","pursues_objective","makes_commitment","occupies_position","generates_observation","responds_to_threat"]}
{"id":"ONT-002","entity":"RESOURCE","class":"STATE_ENTITY","definition":"A stock or flow whose strategic value depends on current and future conversion opportunities.","state_fields":["stock","income_rate","expenditure_rate","committed","reserved","available","projected","acquisition_difficulty","opportunity_cost"]}
{"id":"ONT-003","entity":"CAPABILITY","class":"STRATEGIC_ENTITY","definition":"What an actor can reliably accomplish in the current or projected state.","depends_on":["composition","technology","production_capacity","resources","position","readiness","reinforcement","timing"]}
{"id":"ONT-004","entity":"PRODUCTION_CAPACITY","class":"CAPABILITY_ENTITY","definition":"Ability to convert infrastructure and resources into future capability.","fields":["buildings","queues","queue_slots","production_rate","prerequisites","throughput","reinforcement_rate","replacement_rate","bottlenecks"]}
{"id":"ONT-005","entity":"TECHNOLOGY","class":"CAPABILITY_INVESTMENT","definition":"An investment that modifies future capability and may create a timing window.","fields":["cost","research_time","immediate_benefit","scaling_benefit","dependencies","composition_dependency","counter_effect","transition_effect","opportunity_cost"]}
{"id":"ONT-006","entity":"POSITION","class":"STRATEGIC_STATE","definition":"Strategic geometry affecting capability value, access, exposure, reinforcement, defense, and attack.","fields":["location","access","exposure","defensive_value","retreat_routes","reinforcement_distance","resource_access","attack_routes","choke_value","vision_value"]}
{"id":"ONT-007","entity":"INFORMATION","class":"EPISTEMIC_ENTITY","definition":"Observed or acquired knowledge about the world and opponent.","fields":["observation","age","visibility","confidence","source_quality","contradiction","expected_information_value"]}
{"id":"ONT-008","entity":"BELIEF","class":"EPISTEMIC_STATE","definition":"An uncertain model of hidden or future state.","fields":["hypothesis","confidence","supporting_observations","contradicting_observations","expected_transition","required_resources","prerequisites","timing_window","vulnerability","alternatives"]}
{"id":"ONT-009","entity":"OBJECTIVE","class":"CONTROL_ENTITY","definition":"A desired change in world state.","relations":["requires_capability","creates_demand","prioritized_by_actor","constrained_by_threat"]}
{"id":"ONT-010","entity":"COMMITMENT","class":"CONTROL_ENTITY","definition":"A strategic decision that consumes resources, time, production, position, information, or optionality.","fields":["cost","expected_payoff","duration","prerequisites","opportunity_cost","exit_condition","failure_signature"]}
{"id":"ONT-011","entity":"THREAT","class":"CONTROL_STATE","definition":"A typed mechanism by which an opponent can damage an objective, capability, economy, position, or timing window.","types":["military","economic","technology","position","production","timing","information","objective"]}
{"id":"ONT-012","entity":"INITIATIVE","class":"CONTROL_RESOURCE","definition":"Control over the sequence of strategic decisions and ability to force a response.","fields":["forcing_actor","expected_next_commitment","response_time","tempo_advantage","surrender_cost"]}
{"id":"ONT-013","entity":"TIMING_WINDOW","class":"TEMPORAL_ENTITY","definition":"An interval during which a capability or action has unusually favorable strategic value.","fields":["opening","closing_condition","preparation_time","reaction_time","capability_delta","commitment_required","miss_cost"]}
{"id":"ONT-014","entity":"OPTIONALITY","class":"RESERVE_ENTITY","definition":"Value of future choices that remain available because resources, capability, position, or commitments have not been irreversibly consumed.","sources":["resource_reserve","production_reserve","military_reserve","information_reserve","map_routes","technology_options","strategic_direction"]}
{"id":"ONT-015","entity":"TRANSITION","class":"CAUSAL_ENTITY","definition":"A change from one strategic state to another with prerequisites, costs, capability effects, and expected consequences.","fields":["source_state","trigger","prerequisites","commitment","preparation_time","capability_delta","resource_delta","position_delta","information_delta","opponent_response","expected_result","failure_signature","recovery","destination_state"]}
{"id":"ONT-016","entity":"RESERVATION","class":"ECONOMIC_CONTROL","definition":"A protected resource allocation held for a specific future objective or conversion.","relations":["protects_resource","funds_commitment","has_priority","has_release_condition"]}
{"id":"ONT-017","entity":"FAILURE_SIGNATURE","class":"EPISTEMIC_CONTROL","definition":"Observable evidence that an expected strategic result did not occur or that a commitment has become invalid.","relations":["updates_belief","triggers_abort","triggers_recovery","may_change_objective_priority"]}
{"id":"ONT-018","entity":"CONVERSION_TAX","class":"STRATEGIC_RELATION","definition":"Resource, production, timing, positional, information, attention, replacement, or transition cost imposed on an opponent by an action or commitment.","types":["resource","production","timing","position","information","attention","replacement","transition"]}
{"id":"ONT-019","entity":"STRATEGIC_STATE","class":"COMPOSITE_STATE","definition":"Current modeled condition relevant to strategic decisions.","layers":["world_state","observations","derived_facts","beliefs","objectives","commitments","authorized_actions","execution","verification"]}
{"id":"ONT-020","entity":"CAPABILITY_VALUE","class":"DERIVED_STATE","definition":"Context-dependent strategic value of a capability after accounting for composition, technology, production, resources, position, timing, readiness, and counters."}
{"id":"REL-001","from":"RESOURCE","to":"CAPABILITY","relation":"enables"}
{"id":"REL-002","from":"CAPABILITY","to":"OBJECTIVE","relation":"enables"}
