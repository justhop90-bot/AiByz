; Final integrated Byzantine AI runtime.
; This is the bot to load in Age of Empires II: Definitive Edition.
; Stock Promisory is reference material only and is not loaded.

(load "AegisProm\AEGIS-foundation")
(load "AegisProm\AEGIS-Carpenter-final")
(load "AegisProm\Aegis-belief-final")
(load "AegisProm\Aegis-situation-final")
