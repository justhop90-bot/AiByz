(load "AegisProm\AEGIS-civilian-census-v0")
(load "AegisProm\AEGIS-civilization-state-v0")
(load "AegisProm\AEGIS-worker-role-census-v0")
(load "AegisProm\AEGIS-worker-role-vector-v0")
(load "AegisProm\AEGIS-civilian-demand-v0")
(load "AegisProm\AEGIS-economic-demand-v0")
(load "AegisProm\AEGIS-economic-demand-arbitration-v0")
