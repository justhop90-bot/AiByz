(load "AegisProm\AEGIS-villager-production-v0")
(load "AegisProm\AEGIS-civilian-lifecycle-reconciler-v0")

(defrule
    (game-time < 10)
    (up-compare-goal aegis-wm-cycle == 0)
=>
    (set-goal aegis-wm-valid 0)
    (set-goal aegis-wm-generation 0)
    (set-goal aegis-wm-stage aegis-wm-stage-init)
    (set-goal aegis-wm-evidence aegis-evidence-unknown)
    (set-goal aegis-wm-observed-at 0)
    (set-goal aegis-wm-cycle 1)
    (set-goal aegis-carpenter-sensor-pass 0)
    (set-goal aegis-carpenter-runtime-ok 0)
    (enable-timer aegis-wm-timer 15)
)