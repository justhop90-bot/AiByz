    "STATIC_SOURCE",
    "COMPOSED",
    "INFERRED",
    "TARGET_BUILD_RUNTIME",
    "ENGINE_SPECIFIC",
    "REPLAY_DERIVED",
    "SYNTHETIC_TEST"
  ],
  "common": {
    "required_terminal_stage": "REASSESS",
    "forbidden_shortcuts": [
      "PHYSICAL_REQUEST without AUTHORIZATION",
      "ENGINE_ACCEPTED_PENDING without request identity",
      "WORLD_STATE_VERIFIED without required evidence",
      "strategic success before WORLD_STATE_VERIFIED",
      "credit for UNKNOWN outcome",
      "credit for FAILED outcome",
      "stale generation authorization",
      "duplicate physical request identity"
    ]
  },
